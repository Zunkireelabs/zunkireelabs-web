---
layout: base.njk
---

{# Get current comparison data #}
{% set comp = null %}
{% for c in comparisons %}
  {% if c.id == comparisonId %}
    {% set comp = c %}
  {% endif %}
{% endfor %}

{# =====================================================
   PRODUCT COMPARISON SCHEMA
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ comp.title }}",
  "description": "{{ comp.description }}",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "SoftwareApplication",
          "name": "Zunkiree Search",
          "applicationCategory": "AI Search Platform",
          "offers": {
            "@type": "Offer",
            "availability": "https://schema.org/InStock"
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "SoftwareApplication",
          "name": "{{ comp.competitor.name }}",
          "applicationCategory": "Search Platform"
        }
      }
    ]
  }
}
</script>

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   HERO — matches the /compare/ index hero (breadcrumb + mono
   eyebrow + H1 + subhead), extended with the competitor name
   as the final breadcrumb crumb.
   ===================================================== #}
<section class="relative flex flex-col items-center justify-center px-4 pb-8 pt-28 sm:px-6 sm:pt-36 lg:px-8 lg:pt-40" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    <nav class="mb-6 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-[#76B900]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/compare/" class="transition-colors hover:text-[#76B900]">Compare</a>
      <span aria-hidden="true">/</span>
      <span class="text-navy-600">{{ comp.competitor.name }}</span>
    </nav>

    <span class="mb-4 inline-flex items-center rounded-full border border-sky-100/60 bg-sky-50/60 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-sky-600 shadow-subtle">
      Comparison
    </span>

    <h1 id="hero-heading" class="text-center text-[30px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[38px] sm:leading-[1.1] lg:text-[44px]">
      {{ comp.title }}
    </h1>

    <p class="mt-4 max-w-[680px] text-center text-[17px] font-medium leading-relaxed text-[#6B7280] sm:text-[19px]">
      {{ comp.description }}
    </p>
  </div>
</section>

{# =====================================================
   FEATURE COMPARISON TABLE — one rounded-2xl glass card,
   Zunkiree's column tinted with the single #76B900 accent so
   it reads as the recommended column without a competing hue.
   ===================================================== #}
<section class="px-4 pb-12 pt-4 sm:px-6 sm:pb-16 lg:px-8" aria-labelledby="feature-comparison-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="feature-comparison-heading" class="mb-8 text-[24px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[28px]">
      Feature comparison
    </h2>

    <div class="overflow-hidden rounded-2xl border border-white/60 bg-white shadow-subtle">
      <div class="overflow-x-auto">
        <div class="grid min-w-[560px] grid-cols-3 bg-navy-950">
          <div class="p-4 font-mono text-[11px] uppercase tracking-wider text-white/50">Feature</div>
          <div class="border-l border-white/10 p-4 text-center font-mono text-[11px] uppercase tracking-wider text-[#76B900]">Zunkiree Search</div>
          <div class="border-l border-white/10 p-4 text-center font-mono text-[11px] uppercase tracking-wider text-white/70">{{ comp.competitor.name }}</div>
        </div>

        {% for row in comp.comparison %}
        <div class="grid min-w-[560px] grid-cols-3 border-b border-navy-100/60 last:border-b-0">
          <div class="p-4 text-[14px] text-navy-600">{{ row.feature }}</div>
          <div class="border-l border-navy-100/60 bg-[#76B900]/[0.06] p-4 text-center">
            <span class="text-[14px] font-medium text-[#111827]">{{ row.zunkiree }}</span>
          </div>
          <div class="border-l border-navy-100/60 p-4 text-center">
            <span class="text-[14px] text-navy-500">{{ row.competitor }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# =====================================================
   STRENGTHS & WEAKNESSES — Zunkiree card gets the highlighted
   glass treatment (border-[#76B900]/30, sky/green wash); the
   competitor card stays a plain white card, same visual grammar
   as the "recommended vs. alternative" pattern elsewhere in v2.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="strengths-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="strengths-heading" class="sr-only">Strengths and weaknesses</h2>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2" data-reveal-stagger>

      {# Zunkiree Strengths #}
      <div class="rounded-2xl border border-[#76B900]/25 bg-gradient-to-br from-[#76B900]/[0.06] via-sky-50/20 to-white p-8 shadow-subtle">
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-navy-950 p-2">
            <img src="/assets/images/zunkireelabs-logo-round.svg" alt="Zunkiree" class="h-full w-full" />
          </span>
          <h3 class="text-[18px] font-medium text-[#111827]">Zunkiree Search</h3>
        </div>
        <p class="mb-6 text-[13px] text-[#6B7280]">AI-native search that provides answers</p>
        <ul class="space-y-3">
          {% for strength in comp.zunkiree.strengths %}
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="text-[14px] text-navy-700">{{ strength }}</span>
          </li>
          {% endfor %}
        </ul>
      </div>

      {# Competitor #}
      <div class="rounded-2xl border border-navy-100/70 bg-white p-8 shadow-subtle">
        <div class="mb-6 flex items-center gap-3">
          <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full border border-navy-100 bg-navy-50 font-mono text-[13px] font-semibold text-navy-500">
            {{ comp.competitor.name | first }}
          </span>
          <h3 class="text-[18px] font-medium text-[#111827]">{{ comp.competitor.name }}</h3>
        </div>
        <p class="mb-6 text-[13px] text-[#6B7280]">{{ comp.competitor.description }}</p>

        <div class="space-y-6">
          <div>
            <p class="mb-3 font-mono text-[11px] uppercase tracking-wider text-navy-400">Strengths</p>
            <ul class="space-y-2">
              {% for strength in comp.competitor.strengths %}
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span class="text-[13.5px] text-navy-600">{{ strength }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>

          <div>
            <p class="mb-3 font-mono text-[11px] uppercase tracking-wider text-navy-400">Limitations</p>
            <ul class="space-y-2">
              {% for weakness in comp.competitor.weaknesses %}
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-error-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                <span class="text-[13.5px] text-navy-600">{{ weakness }}</span>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{# =====================================================
   BEST FOR / VERDICT
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="verdict-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="verdict-heading" class="mb-8 text-[24px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[28px]">
      When to choose each
    </h2>

    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2" data-reveal-stagger>
      <div class="rounded-xl border border-navy-100/70 bg-white p-6 shadow-subtle">
        <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-[#76B900]">Choose Zunkiree Search when:</p>
        <p class="text-[14px] leading-relaxed text-navy-600">{{ comp.bestFor.zunkiree }}</p>
      </div>
      <div class="rounded-xl border border-navy-100/70 bg-white p-6 shadow-subtle">
        <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-navy-400">Choose {{ comp.competitor.name }} when:</p>
        <p class="text-[14px] leading-relaxed text-navy-600">{{ comp.bestFor.competitor }}</p>
      </div>
    </div>

    <div class="relative overflow-hidden rounded-2xl bg-navy-950 p-8" style="box-shadow: 0 30px 50px -20px rgba(15, 23, 42, 0.4);" data-reveal>
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.18) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.22) 0%, transparent 60%);"
      ></div>
      <div class="relative z-10">
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">Our Verdict</span>
        <p class="text-[16px] leading-relaxed text-white/85 sm:text-[17px]">{{ comp.verdict }}</p>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   CTA SECTION — same navy-950 rounded-[28px] dual-CTA banner
   used across every v2 page.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="comparison-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <span class="relative z-10 mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">
        Get Started
      </span>
      <h2 id="comparison-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        Ready to try Zunkiree Search?
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        See how AI-native search can transform your customer experience.
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/products/search/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          data-track="cta"
          data-cta-id="compare-product"
        >
          Explore Zunkiree Search
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          data-track="cta"
          data-cta-id="compare-contact"
        >
          Talk to Sales
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   OTHER COMPARISONS — pill list, navy-50 resting state,
   #76B900 accent on hover (same interaction language as the
   nav's mega-menu links and resource filter chips).
   ===================================================== #}
<section class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8" aria-labelledby="other-comparisons-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="other-comparisons-heading" class="mb-6 text-[18px] font-medium text-[#111827]">Other comparisons</h2>
    <div class="flex flex-wrap gap-3" data-reveal>
      {% for c in comparisons %}
      {% if c.id != comp.id %}
      <a href="/compare/{{ c.id }}/" class="inline-flex items-center rounded-full bg-navy-50 px-4 py-2 text-[14px] text-navy-600 transition-colors hover:bg-[#76B900]/10 hover:text-[#5a9100]">
        {{ c.title }}
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
