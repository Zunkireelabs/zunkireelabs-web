---
layout: base.njk
---

{# Company / service comparison page (/compare/<id>/). Same V2 grammar as layouts/comparison.njk
   (breadcrumb hero, one rounded table card with the Zunkiree column tinted #76B900, pill list of
   other comparisons) but generic: column labels come from the data, not "Zunkiree Search". #}
{% set cc = null %}
{% for c in companyComparisons %}{% if c.id == comparisonId %}{% set cc = c %}{% endif %}{% endfor %}

{% include "partials/navbar-v2.njk" %}

<section class="relative flex flex-col items-center justify-center px-4 pb-8 pt-28 sm:px-6 sm:pt-36 lg:px-8 lg:pt-40" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center">
    <nav class="mb-6 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-[#76B900]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/compare/" class="transition-colors hover:text-[#76B900]">Compare</a>
      <span aria-hidden="true">/</span>
      <span class="text-navy-600">{{ cc.leftLabel }}</span>
    </nav>
    <span class="mb-4 inline-flex items-center rounded-full border border-sky-100/60 bg-sky-50/60 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-sky-600 shadow-subtle">Comparison</span>
    <h1 id="hero-heading" class="text-center text-[30px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[38px] sm:leading-[1.1] lg:text-[44px]">{{ cc.title }}</h1>
    <p class="mt-4 max-w-[680px] text-center text-[17px] font-medium leading-relaxed text-[#6B7280] sm:text-[19px]">{{ cc.description }}</p>
  </div>
</section>

<section class="px-4 pb-12 pt-4 sm:px-6 sm:pb-16 lg:px-8" aria-labelledby="feature-comparison-heading">
  <div class="mx-auto max-w-5xl">
    <p class="mb-8 max-w-3xl text-[16px] leading-relaxed text-[#6B7280]">{{ cc.intro }}</p>
    <h2 id="feature-comparison-heading" class="mb-6 text-[24px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[28px]">Side by side</h2>
    <div class="overflow-hidden rounded-2xl border border-white/60 bg-white shadow-subtle">
      <div class="overflow-x-auto">
        <div class="grid min-w-[560px] grid-cols-3 bg-navy-950">
          <div class="p-4 font-mono text-[11px] uppercase tracking-wider text-white/50">{{ cc.featureLabel }}</div>
          <div class="border-l border-white/10 p-4 text-center font-mono text-[11px] uppercase tracking-wider text-[#76B900]">{{ cc.leftLabel }}</div>
          <div class="border-l border-white/10 p-4 text-center font-mono text-[11px] uppercase tracking-wider text-white/70">{{ cc.rightLabel }}</div>
        </div>
        {% for row in cc.rows %}
        <div class="grid min-w-[560px] grid-cols-3 border-b border-navy-100/60 last:border-b-0">
          <div class="p-4 text-[14px] text-navy-600">{{ row.feature }}</div>
          <div class="border-l border-navy-100/60 bg-[#76B900]/[0.06] p-4 text-center"><span class="text-[14px] font-medium text-[#111827]">{{ row.left }}</span></div>
          <div class="border-l border-navy-100/60 p-4 text-center"><span class="text-[14px] text-navy-500">{{ row.right }}</span></div>
        </div>
        {% endfor %}
      </div>
    </div>
    <p class="mt-4 max-w-3xl text-[13px] leading-relaxed text-[#9CA3AF]">This comparison is Zunkiree Labs' own description of its services against typical alternatives. Individual providers differ, so check any provider against your requirements.</p>
    {% if cc.back %}
    <a href="{{ cc.back.href }}" class="mt-6 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-600 transition-all hover:gap-2.5 hover:text-navy-900">
      <svg class="h-3 w-3 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/></svg>
      Back to {{ cc.back.label }}
    </a>
    {% endif %}
  </div>
</section>

<section class="px-4 pb-12 sm:px-6 sm:pb-16 lg:px-8" aria-labelledby="comparison-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div class="hp-shadow-lift relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-12 text-center sm:px-12 sm:py-14">
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">{{ cc.cta.eyebrow }}</span>
      <h2 id="comparison-cta-heading" class="mx-auto max-w-2xl text-[26px] font-medium leading-[1.2] tracking-tight text-white sm:text-[32px]">{{ cc.cta.headline }}</h2>
      <p class="mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-white/60">{{ cc.cta.body }}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-3 font-mono text-[12px] uppercase tracking-wider text-white transition-colors hover:bg-[#5a9100]">Talk to us <span class="h-1 w-1 rounded-full bg-white/70" aria-hidden="true"></span></a>
        <a href="/solutions/" class="inline-flex items-center justify-center gap-2 rounded-md border border-white/25 px-5 py-3 font-mono text-[12px] uppercase tracking-wider text-white transition-colors hover:border-white/40 hover:bg-white/10">See our solutions <span class="h-1 w-1 rounded-full bg-white/50" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>
</section>

{% set ocItems = [] %}
{% for c in companyComparisons %}{% if c.id != cc.id %}{% set ocItems = (ocItems.push({ href: "/compare/" + c.id + "/", title: c.title, blurb: c.description }), ocItems) %}{% endif %}{% endfor %}
{% set ocItems = (ocItems.push({ href: "/compare/", title: "Zunkiree Search comparisons", blurb: "Zunkiree Search compared with Algolia, Elasticsearch and Typesense." }), ocItems) %}
{% include "partials/other-comparisons.njk" %}

{% include "partials/footer-v2.njk" %}
