{# =====================================================
   NARRATIVE BLOCK — single dark statement panel, same navy-950 +
   brand-green/slate treatment as the dark hero. Renders only when
   a product supplies `narrative` (Orca only).
   ===================================================== #}
{% if product.narrative %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="narrative-heading">
  <div class="mx-auto max-w-5xl">
    <div class="relative overflow-hidden rounded-2xl border {{ 'border-white/10 bg-navy-900/60 backdrop-blur-md' if heroDark else 'border-transparent bg-navy-950' }} p-8 text-center sm:p-14" style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);" data-reveal>
      <span class="relative z-10 mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">{{ product.narrative.eyebrow }}</span>
      <h2 id="narrative-heading" class="relative z-10 mx-auto max-w-2xl text-[26px] font-medium leading-[1.25] text-white sm:text-[32px]">{{ product.narrative.heading }}</h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-[15px] leading-relaxed text-white/60">{{ product.narrative.body }}</p>
    </div>
  </div>
</section>
