{# =====================================================
   VALUE BULLETS — corner-bracket "viewfinder" cards with mono
   index numerals and bold display type, plus a scoped blur-to-
   focus scroll reveal. Visual language borrowed from the
   Glyph Portal 21st.dev component (bold ink type, thin corner
   annotation marks, a camera-focus feel) — NOT its scroll-jack
   mechanism, which doesn't fit a 3-item value-prop grid and has
   no React runtime to run in here. Reveal reuses the site's
   existing gsap/ScrollTrigger (window.gsap, main.js) but is
   scoped to [data-vb-card] only, so it never touches the shared
   data-reveal-stagger-x behavior used elsewhere on the site.
   ===================================================== #}
{% if product.valueBullets %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" aria-labelledby="value-bullets-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="value-bullets-heading" class="mb-8 text-center text-[24px] font-medium leading-[1.2] sm:text-[28px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ product.valueBullets.heading }}</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3" data-vb-group>
      {% for item in product.valueBullets.items %}
        <div class="vb-card {{ 'vb-card--dark' if heroDark else 'vb-card--light' }} relative rounded-lg p-6" data-vb-card>
          <span class="vb-tick vb-tick--tl" aria-hidden="true"></span>
          <span class="vb-tick vb-tick--br" aria-hidden="true"></span>
          <span class="mb-4 block font-mono text-[11px] uppercase tracking-[0.08em] {{ 'text-[#9ee62f]' if heroDark else 'text-[#5a9100]' }}">{{ '0' + (loop.index) | string }}</span>
          <p class="text-[19px] font-bold leading-[1.25] tracking-tight sm:text-[21px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ item.title }}</p>
          <p class="mt-2.5 text-[14px] leading-relaxed {{ 'text-white/60' if heroDark else 'text-[#6B7280]' }}">{{ item.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<style>
  .vb-tick {
    position: absolute;
    width: 22px;
    height: 22px;
    pointer-events: none;
  }
  .vb-tick--tl { top: 0; left: 0; border-top: 2.5px solid; border-left: 2.5px solid; }
  .vb-tick--br { bottom: 0; right: 0; border-bottom: 2.5px solid; border-right: 2.5px solid; }
  .vb-card--dark .vb-tick { border-color: #9ee62f; opacity: 1; }
  .vb-card--light .vb-tick { border-color: #76B900; opacity: 1; }
</style>
<script>
  (function () {
    function run() {
      var cards = document.querySelectorAll('[data-vb-card]');
      var group = document.querySelector('[data-vb-group]');
      if (!cards.length || !group) return;

      if (!window.gsap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        cards.forEach(function (el) {
          el.style.opacity = '1';
          el.style.filter = 'none';
          el.style.transform = 'none';
        });
        return;
      }

      gsap.fromTo(cards,
        { opacity: 0, x: 60, filter: 'blur(6px)' },
        {
          opacity: 1,
          x: 0,
          filter: 'blur(0px)',
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.25,
          scrollTrigger: {
            trigger: group,
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
        }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
  })();
</script>
{% endif %}

{# =====================================================
   CHALLENGE STRIP — short framing strip, 3 compact blocks.
   Reuses industry.njk's Pain Point section pattern verbatim
   (asymmetric lead + 2 secondary blocks, animated visuals)
   instead of the flat 3-up icon grid.
   ===================================================== #}
{% if product.challenges %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="challenges-heading">
  <div class="mx-auto max-w-5xl">
    {% if heroDark %}
      {# =====================================================
         Kore.ai "Business Challenge" pattern, borderless editorial
         version (2026-09-27): small mono eyebrow + big left-aligned
         bold headline, then the asymmetric split as plain type on
         the dark ground — no bordered/filled card (that would echo
         the value-bullets grid directly above). The split is also a
         pinned, scroll-scrubbed sequence: block 1 opens centered and
         oversized, shrinks into its final left-column slot as the
         user scrolls, then block 2 appears centered/oversized and
         shrinks into its slot, then block 3 does the same — ending
         in the exact asymmetric layout, reversible on scroll-up.
         Desktop/tablet only (data-challenge-stage script below bails
         out under 640px, reduced-motion, or no gsap — those render
         the plain static asymmetric grid with no JS involved). #}
      <div class="relative" data-challenge-stage>
        {# Eyebrow + heading live inside the pinned stage (not above it) so they
           stay fixed on screen for the whole sequence instead of scrolling away
           once the section pins. #}
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">What's not working</span>
        <h2 id="challenges-heading" class="mb-8 max-w-2xl text-left text-[30px] font-medium leading-[1.1] text-white sm:text-[38px]">
          {{ product.challenges.heading }}
        </h2>
        {# Even 2x2 grid (2026-09-27): all four items get equal weight, in
           place of the old big-left/two-stacked-right split. Per-cell
           borders (not Tailwind's divide-x/y, which only look at DOM
           order and can't produce a real 2-column crosshair) draw the
           vertical line between columns and horizontal line between
           rows; on mobile everything collapses to one stacked column
           with a simple top border between each. #}
        <div class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2" data-challenge-grid>
          {% for block in product.challenges.blocks %}
            {% set idx = loop.index0 %}
            {% if idx == 0 %}
              {% set cellClass = "" %}
            {% elif idx == 1 %}
              {% set cellClass = "border-t border-white/10 pt-6 sm:border-t-0 sm:border-l sm:pl-8 sm:pt-0" %}
            {% elif idx == 2 %}
              {% set cellClass = "border-t border-white/10 pt-6 sm:pt-8" %}
            {% else %}
              {# Top and left borders meet at this cell's corner (row2/col2)
                 — a solid joined corner reads as "connected," which fights
                 the section's theme, so this cell draws its own top/left
                 lines with a gap at the corner instead of Tailwind's
                 border-t/border-l (see .challenge-corner-gap below). #}
              {% set cellClass = "border-t border-white/10 pt-6 sm:border-t-0 sm:pl-8 sm:pt-8 challenge-corner-gap" %}
            {% endif %}
            <div class="flex flex-col justify-center {{ cellClass }}" data-challenge-item="{{ idx }}">
              <p class="text-[19px] font-semibold leading-snug text-white sm:text-[20px]">{{ block.title }}</p>
              <p class="mt-2 max-w-[36ch] text-[14px] leading-relaxed text-white/60">{{ block.description }}</p>
              {{ painPointVisual(loop.index) }}
            </div>
          {% endfor %}
        </div>
      </div>
      <script>
        (function () {
          function run() {
            var stage = document.querySelector('[data-challenge-stage]');
            var grid = document.querySelector('[data-challenge-grid]');
            var items = Array.prototype.slice.call(document.querySelectorAll('[data-challenge-item]'));
            if (!stage || !grid || items.length < 2) return;

            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var narrow = window.matchMedia('(max-width: 639px)').matches;
            if (!window.gsap || reduced || narrow) return;

            var tl;

            function teardown() {
              if (tl) { if (tl.scrollTrigger) tl.scrollTrigger.kill(); tl.kill(); tl = null; }
              gsap.set(items, { clearProps: 'all' });
              items.forEach(function (el) {
                el.style.position = '';
                el.style.left = '';
                el.style.top = '';
                el.style.width = '';
              });
              stage.style.minHeight = '';
            }

            function build() {
              teardown();

              var stageRect = stage.getBoundingClientRect();
              var rects = items.map(function (el) { return el.getBoundingClientRect(); });
              stage.style.minHeight = stageRect.height + 'px';
              // `grid` itself stays position:static (in-flow) — only its item
              // children go absolute. That keeps `stage` (position:relative) as
              // the sole positioned ancestor items resolve left/top against;
              // making `grid` position:absolute too previously made IT the
              // positioning context instead, which silently offset every
              // stage-relative coordinate below and was the real cause of the
              // off-center drift.

              // Anchor each item's FINAL resting spot with plain left/top (px) +
              // xPercent/yPercent:0. The CENTERED stage state re-anchors left/top
              // to the stage's exact midpoint with xPercent/yPercent:-50, which
              // centers the item on itself regardless of its own width/height —
              // no manual "target center minus item center" delta math (which
              // drifted off-true whenever scale/measurement order shifted it).
              var stageMidX = stageRect.width / 2;
              var stageMidY = stageRect.height / 2;
              // Each item after the first reveals progressively lower than
              // dead-center: by the time item i appears, items 0..i-1 have
              // already settled into the upper portion of the stage, so
              // centering every item at the same stageMidY would overlap
              // whatever already settled there. A flat offset was enough for
              // 3 items but undershoots once there are 4 (items 2 & 3 still
              // landed on top of 0 & 1) — so the push grows with index instead.
              var REVEAL_OFFSETS = [0, 0.22, 0.34, 0.46];
              var SCALE = 1.28;

              items.forEach(function (el, i) {
                var r = rects[i];
                var finalLeft = r.left - stageRect.left;
                var finalTop = r.top - stageRect.top;
                el.style.position = 'absolute';
                el.style.width = r.width + 'px';
                el._finalLeft = finalLeft;
                el._finalTop = finalTop;

                var offsetFrac = REVEAL_OFFSETS[i] !== undefined ? REVEAL_OFFSETS[i] : 0.46;
                gsap.set(el, {
                  left: stageMidX,
                  top: stageMidY + stageRect.height * offsetFrac,
                  xPercent: -50,
                  yPercent: -50,
                  scale: SCALE,
                  opacity: 0,
                  transformOrigin: 'center center',
                });
              });

              tl = gsap.timeline({
                scrollTrigger: {
                  trigger: stage,
                  start: 'top top+=80',
                  end: '+=' + Math.round(window.innerHeight * items.length * 0.8),
                  scrub: 0.6,
                  pin: true,
                  anticipatePin: 1,
                },
              });

              items.forEach(function (el, i) {
                // Every item, including the first, fades in from its centered/
                // oversized state only as the user scrolls — none of them are
                // just instantly visible the moment the section pins.
                tl.to(el, { opacity: 1, duration: 0.6 }, i === 0 ? 0 : '-=0.2');
                tl.to(el, {
                  left: el._finalLeft,
                  top: el._finalTop,
                  xPercent: 0,
                  yPercent: 0,
                  scale: 1,
                  duration: 2.8,
                  ease: 'power2.inOut',
                });
              });
              tl.to({}, { duration: 0.6 });
            }

            build();

            var resizeTimer;
            window.addEventListener('resize', function () {
              clearTimeout(resizeTimer);
              resizeTimer = setTimeout(function () {
                if (window.matchMedia('(max-width: 639px)').matches) { teardown(); return; }
                build();
              }, 200);
            });
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', run);
          } else {
            run();
          }
        })();
      </script>
    {% else %}
      <h2 id="challenges-heading" class="mb-8 text-center text-[26px] font-medium leading-[1.2] sm:text-[28px] text-[#111827]">
        {{ product.challenges.heading }}
      </h2>
      <div class="overflow-hidden rounded-xl border shadow-card transition-shadow duration-300 hover:shadow-card-hover border-navy-100/60 bg-gradient-to-br from-sky-50/60 via-white to-white" data-reveal-stagger>
        <div class="flex flex-col sm:flex-row divide-y divide-navy-200 sm:divide-y-0">
          {% for block in product.challenges.blocks %}
            {% if loop.index == 1 %}
              <div class="flex min-h-[360px] flex-col justify-center p-8 sm:w-3/5 lg:p-12 sm:border-r sm:border-navy-200">
                <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-sky-600">Primary</p>
                <p class="text-[26px] font-semibold leading-snug sm:text-[28px] text-[#111827]">{{ block.title }}</p>
                <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
                {{ painPointVisual(1) }}
              </div>
            {% endif %}
          {% endfor %}
          <div class="flex flex-col sm:w-2/5">
            {% for block in product.challenges.blocks %}
              {% if loop.index != 1 %}
                <div class="flex min-h-[180px] flex-1 flex-col justify-center p-7 lg:p-9{% if loop.index == 2 %} border-b border-navy-200{% endif %}">
                  <p class="text-[19px] font-semibold leading-snug text-[#111827]">{{ block.title }}</p>
                  <p class="mt-1.5 text-[13px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
                  {{ painPointVisual(loop.index) }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>
<style>
  .pp-visual {
    margin-top: 20px;
    width: fit-content;
    align-self: flex-start;
  }

  /* Lead visual: a stalled chat bubble — typing dots that never
     resolve into a reply, plus a slow "waiting" ring around it. */
  .pp-visual--lead {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .pp-chat-bubble {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 999px 999px 999px 4px;
    background: #eff7ff;
    border: 1px solid #bfe1fc;
  }
  .pp-chat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2673b8;
    animation: pp-chat-dot-bounce 1.2s ease-in-out infinite;
  }
  .pp-chat-dot:nth-child(2) { animation-delay: 0.15s; }
  .pp-chat-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pp-chat-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
  .pp-chat-ring {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 999px;
    border: 1px solid #93ccfa;
    opacity: 0;
    animation: pp-chat-ring-pulse 2.4s ease-out infinite;
  }
  @keyframes pp-chat-ring-pulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.25); opacity: 0; }
  }

  /* Secondary visual 1: two nodes with a dashed line whose gap
     pulses — reads as "connected but not really talking." */
  .pp-visual--sm {
    display: flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }
  .pp-node {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #dbeffe;
    border: 1.5px solid #2673b8;
  }
  .pp-node-line {
    width: 44px;
    height: 8px;
    overflow: visible;
  }
  .pp-node-line line {
    stroke: #93ccfa;
    animation: pp-node-line-pulse 2s ease-in-out infinite;
  }
  @keyframes pp-node-line-pulse {
    0%, 100% { stroke-dashoffset: 0; opacity: 0.5; }
    50% { stroke-dashoffset: 8; opacity: 1; }
  }

  /* Secondary visual 2: stacked rows cycling in place — reads as
     repetitive manual sorting/triage. */
  .pp-visual--rows {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
  .pp-row {
    display: block;
    height: 5px;
    width: 46px;
    border-radius: 2px;
    background: #bfe1fc;
    animation: pp-row-cycle 1.8s ease-in-out infinite;
  }
  @keyframes pp-row-cycle {
    0%, 100% { transform: translateX(0); opacity: 0.6; }
    50% { transform: translateX(5px); opacity: 1; background: #60aef5; }
  }

  /* 4th visual: two stacked cards that drift apart and back — reads
     as "the same thing, logged twice." */
  .pp-visual--dupe {
    position: relative;
    width: 60px;
    height: 44px;
  }
  .pp-dupe-card {
    position: absolute;
    width: 40px;
    height: 30px;
    border-radius: 6px;
    background: #dbeffe;
    border: 1.5px solid #2673b8;
  }
  .pp-dupe-card--back {
    top: 10px;
    left: 14px;
    opacity: 0.6;
    animation: pp-dupe-back 2.2s ease-in-out infinite;
  }
  .pp-dupe-card--front {
    top: 4px;
    left: 6px;
    background: #eff7ff;
    animation: pp-dupe-front 2.2s ease-in-out infinite;
  }
  @keyframes pp-dupe-back {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(4px, 3px); }
  }
  @keyframes pp-dupe-front {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-4px, -3px); }
  }

  /* 2x2 challenge grid, last cell (2026-09-27): draw its own top/left
     divider lines with a gap at the corner, instead of Tailwind's
     border-t + border-l meeting in a solid joined corner. */
  .challenge-corner-gap {
    position: relative;
  }
  @media (min-width: 640px) {
    .challenge-corner-gap::before,
    .challenge-corner-gap::after {
      content: '';
      position: absolute;
      background: rgba(255, 255, 255, 0.1);
    }
    .challenge-corner-gap::before {
      top: 0;
      left: 24px;
      right: 0;
      height: 1px;
    }
    .challenge-corner-gap::after {
      left: 0;
      top: 24px;
      bottom: 0;
      width: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-chat-dot,
    .pp-chat-ring,
    .pp-node-line line,
    .pp-row,
    .pp-dupe-card--back,
    .pp-dupe-card--front {
      animation: none;
    }
  }
</style>
{% endif %}

{# =====================================================
   FEATURE BLOCKS — stacked bordered panels, each holding a
   visual mock (left) and heading/description (right) inside
   one shared card, fed by the product's benefits array.
   Layout reference: Kore.ai's ai-agent-platform "pillars"
   panel (bordered card, soft color-wash behind the screenshot,
   corner "Expand" affordance) — restyled with our own tile
   visuals/colors, not their screenshots or copy.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="benefits-heading">
  <div class="mx-auto max-w-5xl">
    <div class="relative mb-10 sm:mb-14">
      <span class="mb-4 inline-block rounded-full border px-3 py-1.5 font-mono text-[10px] uppercase tracking-wider {{ 'border-white/15 bg-white/5 text-white/50' if heroDark else 'border-navy-100/70 bg-white text-navy-500' }}">{ Benefits }</span>
      <h2 id="benefits-heading" class="max-w-2xl text-[28px] font-semibold leading-[1.2] sm:text-[36px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">
        What Orca delivers across every connected system
      </h2>
      <div class="mt-8 h-px w-full {{ 'bg-white/10' if heroDark else 'bg-navy-100/70' }}"></div>
    </div>
    <div class="flex flex-col gap-8 sm:gap-10">
      {% for benefit in product.benefits %}
        <div class="relative" data-reveal-stagger>
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <div class="relative flex min-h-[420px] items-center justify-center overflow-hidden rounded-3xl p-6 sm:min-h-[480px] sm:p-10" style="background-image: url('/assets/images/products/orca-benefit-glow.jpg'); background-size: cover; background-position: center;">
              <div class="tile-float relative z-10 flex w-full max-w-[340px] flex-col overflow-hidden rounded-xl border border-navy-100/60 bg-white shadow-md">
                <div class="flex items-center gap-1.5 border-b border-navy-100/70 bg-[#F5F6F7] px-3 py-2.5">
                  <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
                  <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
                  <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
                  <span class="ml-2 truncate font-mono text-[10px] text-navy-400">{{ product.eyebrow | lower }}.zunkireelabs.com</span>
                </div>
                <div class="flex flex-1 items-center justify-center p-5">
                  {% if product.id == "orca" %}
                    {{ orcaBenefitMockup(loop.index0) }}
                  {% else %}
                    {{ benefitVisual(benefit.visual) }}
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="relative flex flex-col justify-end p-8 sm:p-12">
              <h3 class="text-[24px] font-medium leading-[1.2] sm:text-[28px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">
                {{ benefit.title }}
              </h3>
              <p class="mt-4 max-w-lg text-[15px] leading-relaxed {{ 'text-white/60' if heroDark else 'text-[#6B7280]' }}">
                {{ benefit.description }}
              </p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  @keyframes tile-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .tile-float {
    animation: tile-float 4s ease-in-out infinite;
  }

  /* Benefit visuals — content-specific looping animations, see benefitVisual() macro. */
  @keyframes benefit-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
  @keyframes benefit-swap-dots {
    0%, 35% { opacity: 1; }
    40%, 100% { opacity: 0; }
  }
  @keyframes benefit-swap-text {
    0%, 35% { opacity: 0; }
    45%, 100% { opacity: 1; }
  }
  .benefit-answer-dots {
    animation: benefit-swap-dots 4s ease-in-out infinite;
  }
  .benefit-answer-dots span {
    animation: benefit-dot-bounce 1s ease-in-out infinite;
  }
  .benefit-answer-dots span:nth-child(2) { animation-delay: 0.15s; }
  .benefit-answer-dots span:nth-child(3) { animation-delay: 0.3s; }
  .benefit-answer-text {
    opacity: 0;
    animation: benefit-swap-text 4s ease-in-out infinite;
  }

  @keyframes benefit-pulse-ring {
    0% { transform: scale(0.6); opacity: 0.7; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .benefit-pulse-ring {
    animation: benefit-pulse-ring 1.8s ease-out infinite;
  }

  @keyframes benefit-line-draw {
    0% { stroke-dashoffset: 60; opacity: 0.3; }
    35% { stroke-dashoffset: 0; opacity: 1; }
    80% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 60; opacity: 0.3; }
  }
  .benefit-connect-line {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: benefit-line-draw 2.4s ease-in-out infinite;
  }
  @keyframes benefit-node-in {
    0% { opacity: 0; transform: scale(0.5); }
    20% { opacity: 1; transform: scale(1); }
    80% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.5); }
  }
  .benefit-node {
    opacity: 0;
    transform: scale(0.5);
    animation: benefit-node-in 2.4s ease-in-out infinite;
  }

  @keyframes benefit-gauge-fill {
    0% { stroke-dashoffset: 213.6; }
    60% { stroke-dashoffset: 17.1; }
    100% { stroke-dashoffset: 17.1; }
  }
  .benefit-gauge-ring {
    stroke-dasharray: 213.6;
    stroke-dashoffset: 213.6;
    animation: benefit-gauge-fill 2.6s ease-out infinite;
  }

  @keyframes benefit-list-in {
    0% { opacity: 0; transform: translateX(-10px); }
    15% { opacity: 1; transform: translateX(0); }
    85% { opacity: 1; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(-10px); }
  }
  .benefit-list-row {
    opacity: 0;
    transform: translateX(-10px);
    animation: benefit-list-in 3s ease-in-out infinite;
  }

  @keyframes benefit-path-fill {
    0% { width: 0%; }
    100% { width: 100%; }
  }
  .benefit-path-progress {
    width: 0%;
    animation: benefit-path-fill 3s ease-in-out infinite;
  }
  @keyframes benefit-path-light {
    0%, 32% { background-color: #D9DEE2; }
    40%, 100% { background-color: #76B900; }
  }
  .benefit-path-dot {
    background-color: #D9DEE2;
    animation: benefit-path-light 3s ease-in-out infinite;
  }

  .benefit-stack-layer {
    animation: tile-float 4s ease-in-out infinite;
  }

  @keyframes benefit-node-ping {
    0%, 100% { box-shadow: 0 0 0 0 rgba(118, 185, 0, 0); }
    50% { box-shadow: 0 0 0 6px rgba(118, 185, 0, 0.15); }
  }
  .benefit-sync-node {
    animation: benefit-node-ping 2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-answer-dots,
    .benefit-answer-dots span,
    .benefit-answer-text,
    .benefit-pulse-ring,
    .benefit-connect-line,
    .benefit-node,
    .benefit-gauge-ring,
    .benefit-list-row,
    .benefit-path-progress,
    .benefit-path-dot,
    .benefit-stack-layer,
    .benefit-sync-node,
    .tile-float {
      animation: none !important;
    }
  }
</style>

{# =====================================================
   USE CASE FLOW-DIAGRAM MACROS (orca only) — when a useCases
   item defines `systems` (and optionally `trigger`), the panel
   renders a per-tab coordination-flow diagram instead of the
   generic split layout: trigger → hub → systems → outcomes.
   search/ai-crm items have no `systems` field, so they fall
   through to the original split layout untouched.
   ===================================================== #}
{% macro flowBlock(nodes, heroDark) %}
  <div class="flex flex-col justify-center gap-2 rounded-xl border p-2.5 {{ 'border-white/10 bg-white/5' if heroDark else 'border-navy-100/70 bg-navy-50/50' }}">
    {% for node in nodes %}
      <div class="flex h-11 items-center gap-2 rounded-lg px-3 py-2 {{ 'bg-white/10' if heroDark else 'bg-white' }}">
        <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-md {{ 'bg-white/10 text-[#9ee62f]' if heroDark else 'bg-[#F0F5E8] text-[#5a9100]' }}" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">{{ heroBadgeIcon(node.icon) }}</svg>
        </span>
        <span class="text-[13px] font-medium leading-snug {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ node.label }}</span>
      </div>
    {% endfor %}
  </div>
{% endmacro %}

{% macro flowCenter(heroDark) %}
  <div class="relative flex flex-col items-center gap-3">
    <span class="flex items-center gap-2 rounded-full px-3 py-1.5 {{ 'bg-white/10' if heroDark else 'bg-navy-50' }}">
      <span class="usecase-engine-ping h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]"></span>
      <span class="font-mono text-[10px] uppercase tracking-wider {{ 'text-white/60' if heroDark else 'text-navy-500' }}">Orca</span>
    </span>
    <div class="relative flex h-[90px] w-[90px] items-center justify-center">
      <span class="orca-hub-glow absolute -inset-5 rounded-full" aria-hidden="true"></span>
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border-2 border-[#76B900]/50"></span>
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border-2 border-[#76B900]/50" style="animation-delay: 0.6s"></span>
      <span class="benefit-pulse-ring absolute inset-0 rounded-full border-2 border-[#76B900]/50" style="animation-delay: 1.2s"></span>
      <span class="orca-hub-pulse relative z-10 flex h-14 w-14 items-center justify-center rounded-2xl bg-navy-950 text-white">
        <svg class="h-6 w-6 text-[#9ee62f]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          {{ heroBadgeIcon("workflow") }}
        </svg>
      </span>
    </div>
  </div>
{% endmacro %}

{% macro flowLineSvg(heroDark, uid, delay, vertical) %}
  {% if vertical %}
    <svg class="h-full w-full" viewBox="0 0 6 100" preserveAspectRatio="none">
      <defs>
        <linearGradient id="{{ uid }}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100">
          <stop offset="0%" stop-color="#76B900" stop-opacity="0"></stop>
          <stop offset="50%" stop-color="#76B900" stop-opacity="1"></stop>
          <stop offset="100%" stop-color="#76B900" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <line x1="3" y1="2" x2="3" y2="98" stroke-width="1.5" class="{{ 'stroke-white/10' if heroDark else 'stroke-navy-200' }}"></line>
      <line x1="3" y1="2" x2="3" y2="98" stroke="url(#{{ uid }})" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="30 80" class="flow-line-dash" style="animation-delay: {{ delay }}s"></line>
    </svg>
  {% else %}
    <svg class="h-full w-full" viewBox="0 0 100 6" preserveAspectRatio="none">
      <defs>
        <linearGradient id="{{ uid }}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="0">
          <stop offset="0%" stop-color="#76B900" stop-opacity="0"></stop>
          <stop offset="50%" stop-color="#76B900" stop-opacity="1"></stop>
          <stop offset="100%" stop-color="#76B900" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <line x1="2" y1="3" x2="98" y2="3" stroke-width="1.5" class="{{ 'stroke-white/10' if heroDark else 'stroke-navy-200' }}"></line>
      <line x1="2" y1="3" x2="98" y2="3" stroke="url(#{{ uid }})" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="30 80" class="flow-line-dash" style="animation-delay: {{ delay }}s"></line>
    </svg>
  {% endif %}
{% endmacro %}

{# Elbow-routed fan lines: one path PER node, bending from a shared trunk
   stub at the hub side out to each node's own row on the block side — so
   a 3-node group reads as 3 individual right-angle connections converging
   on the hub, not parallel lines or one shared line into a box.
   flip=false: single/trunk side is LEFT (hub), fan side is RIGHT (block) — used for systems/outcomes.
   flip=true:  single/trunk side is LEFT (block), fan side is RIGHT... inverted below for trigger, where
               the block sits left of the connector and the hub sits right of it.
   Desktop only — mobile stacks blocks vertically via a single connector instead. #}
{% macro flowFanLines(nodes, heroDark, uidPrefix, flip) %}
  {# Mobile: blocks stack vertically, so a vertical connector between them reads correctly. #}
  <div class="flex h-8 w-full items-center justify-center py-1 sm:hidden" aria-hidden="true">
    <div class="h-full w-1.5">{{ flowLineSvg(heroDark, uidPrefix + "-m", 0, true) }}</div>
  </div>
  {# Desktop: elbow paths, one per node, sized to match the block's row layout (h-11 rows + gap-2 + p-2.5). #}
  {% set rowH = 44 %}
  {% set gap = 8 %}
  {% set n = nodes.length %}
  {% set rowsH = n * rowH + (n - 1) * gap %}
  {% set totalH = rowsH + 20 %}
  {% set centerY = 10 + (rowsH / 2) %}
  {% set trunkX = 20 %}
  <div class="hidden flex-shrink-0 sm:block sm:w-10" style="height: {{ totalH }}px;" aria-hidden="true">
    <svg viewBox="0 0 40 {{ totalH }}" preserveAspectRatio="none" class="h-full w-full">
      <defs>
        <linearGradient id="{{ uidPrefix }}-grad" gradientUnits="userSpaceOnUse" x1="{{ '40' if flip else '0' }}" y1="0" x2="{{ '0' if flip else '40' }}" y2="0">
          <stop offset="0%" stop-color="#76B900" stop-opacity="0"></stop>
          <stop offset="55%" stop-color="#76B900" stop-opacity="1"></stop>
          <stop offset="100%" stop-color="#76B900" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      {% for node in nodes %}
        {% set yi = 10 + (loop.index0 * (rowH + gap)) + (rowH / 2) %}
        {% if flip %}
          {% set d = "M0 " ~ yi ~ " H " ~ trunkX ~ " V " ~ centerY ~ " H 40" %}
        {% else %}
          {% set d = "M0 " ~ centerY ~ " H " ~ trunkX ~ " V " ~ yi ~ " H 40" %}
        {% endif %}
        <path d="{{ d }}" fill="none" stroke-width="1.5" class="{{ 'stroke-white/10' if heroDark else 'stroke-navy-200' }}"></path>
        <path d="{{ d }}" fill="none" stroke="url(#{{ uidPrefix }}-grad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="30 80" class="flow-line-dash" style="animation-delay: {{ loop.index0 * 0.3 }}s"></path>
      {% endfor %}
    </svg>
  </div>
{% endmacro %}

{% macro flowOutcomes(features, heroDark) %}
  <div class="flex flex-col justify-center gap-2 rounded-xl border p-2.5 {{ 'border-white/10 bg-white/5' if heroDark else 'border-navy-100/70 bg-navy-50/50' }}">
    <span class="px-1 font-mono text-[10px] uppercase tracking-wider {{ 'text-white/40' if heroDark else 'text-navy-400' }}">Outcomes</span>
    {% for feature in features %}
      <div class="flex h-11 items-center gap-2 rounded-lg px-3 py-2 {{ 'bg-white/10' if heroDark else 'bg-white' }}">
        <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
        <span class="text-[13px] font-medium leading-snug {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ feature }}</span>
      </div>
    {% endfor %}
  </div>
{% endmacro %}

{# =====================================================
   USE CASES — segmented tab bar over a split content/visual
   card (Kore.ai's "Built for how your users actually search"
   tabbed pattern), restyled with our navy/mono/#76B900 accent
   system. Panel content is generic off product.useCases.items
   (title/description/features) so it works unmodified for
   search and ai-crm — those keep the tab bar + one-panel-at-a-time
   split layout. Orca items additionally define `systems` (and
   optionally `trigger`); when present (isFlowLayout), the tab bar
   is skipped entirely and all flow diagrams render stacked in one
   view (2026-09-27, per request — no tab switching for Orca).
   ===================================================== #}
{% set isFlowLayout = product.useCases.items[0].systems is defined %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="usecases-heading" x-data="{ active: 0 }">
  <div class="mx-auto max-w-5xl">
    <h2 id="usecases-heading" class="mb-8 text-center text-[26px] font-medium leading-[1.2] sm:text-[30px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">
      {{ product.useCases.heading }}
    </h2>

    {% if not isFlowLayout and product.useCases.items and product.useCases.items.length > 1 %}
      <div role="tablist" aria-label="{{ product.useCases.heading }}" class="mb-6 flex flex-wrap items-center justify-center gap-2" data-reveal>
        {% for item in product.useCases.items %}
          <button
            type="button"
            role="tab"
            id="usecase-tab-{{ loop.index0 }}"
            aria-controls="usecase-panel-{{ loop.index0 }}"
            :aria-selected="active === {{ loop.index0 }} ? 'true' : 'false'"
            :tabindex="active === {{ loop.index0 }} ? 0 : -1"
            @click="active = {{ loop.index0 }}"
            @keydown.right.prevent="active = (active + 1) % {{ product.useCases.items.length }}; $nextTick(() => $refs['usecaseTab' + active].focus())"
            @keydown.left.prevent="active = (active - 1 + {{ product.useCases.items.length }}) % {{ product.useCases.items.length }}; $nextTick(() => $refs['usecaseTab' + active].focus())"
            x-ref="usecaseTab{{ loop.index0 }}"
            class="rounded-full px-4 py-2 font-mono text-[12px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            :class="active === {{ loop.index0 }} ? '{{ 'bg-white text-navy-950' if heroDark else 'bg-navy-900 text-white' }}' : '{{ 'bg-white/5 text-white/60 hover:bg-white/10' if heroDark else 'bg-navy-50/70 text-navy-500 hover:bg-navy-100' }}'"
          >
            {{ item.title }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="{{ 'overflow-hidden rounded-2xl border shadow-subtle divide-y ' + ('border-white/10 bg-white/5 divide-white/10' if heroDark else 'border-navy-100/60 bg-white divide-navy-100/70') if isFlowLayout }}">
    {% for item in product.useCases.items %}
      <div
        id="usecase-panel-{{ loop.index0 }}"
        {% if not isFlowLayout %}
        role="tabpanel"
        aria-labelledby="usecase-tab-{{ loop.index0 }}"
        x-show="active === {{ loop.index0 }}"
        {% if not loop.first %}x-cloak{% endif %}
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        {% endif %}
        class="{{ '' if isFlowLayout else 'overflow-hidden rounded-2xl border shadow-subtle ' + ('border-white/10 bg-white/5' if heroDark else 'border-navy-100/60 bg-white') + ' ' + ('' if item.systems and item.systems.length else 'grid grid-cols-1 lg:grid-cols-2') }}"
        data-reveal
      >
        {% if item.systems and item.systems.length %}
          {# ---- Coordination flow diagram (orca): trigger → hub → systems → outcomes.
               No per-item heading/description/CTA here (2026-09-27) — the section's
               single h2 + one shared CTA (rendered once, after the loop) cover the
               whole merged card; each row keeps only a small label for context. #}
          <div class="p-6 sm:p-8">
            <div class="mb-5 flex justify-center">
              <span class="rounded-full px-3 py-1 font-mono text-[11px] uppercase tracking-wide {{ 'bg-white/10 text-white/70' if heroDark else 'bg-navy-50 text-navy-500' }}">{{ item.title }}</span>
            </div>

            <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-center sm:gap-2">
              {% if item.trigger and item.trigger.length %}
                <div class="sm:min-w-[140px]">{{ flowBlock(item.trigger, heroDark) }}</div>
                {{ flowFanLines(item.trigger, heroDark, "uc-flow-" + loop.index0 + "-a", true) }}
              {% endif %}

              {{ flowCenter(heroDark) }}

              {{ flowFanLines(item.systems, heroDark, "uc-flow-" + loop.index0 + "-b", false) }}
              <div class="sm:min-w-[160px]">{{ flowBlock(item.systems, heroDark) }}</div>

              {% if item.features and item.features.length %}
                {{ flowFanLines(item.features, heroDark, "uc-flow-" + loop.index0 + "-c", false) }}
                <div class="sm:min-w-[170px]">{{ flowOutcomes(item.features, heroDark) }}</div>
              {% endif %}
            </div>
          </div>
        {% else %}
          {# ---- Legacy split layout (search, ai-crm) — unchanged ---- #}
          <div class="flex flex-col justify-center p-8 sm:p-10">
            <p class="text-[20px] font-semibold leading-snug sm:text-[22px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ item.title }}</p>
            <p class="mt-2 text-[14px] leading-relaxed sm:text-[15px] {{ 'text-white/60' if heroDark else 'text-[#6B7280]' }}">{{ item.description }}</p>

            {% if item.features and item.features.length %}
              <ul class="mt-6 border-t {{ 'border-white/10' if heroDark else 'border-navy-100/70' }}">
                {% for feature in item.features %}
                  <li class="flex items-center gap-3 border-b py-3.5 {{ 'border-white/10' if heroDark else 'border-navy-100/70' }}">
                    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg {{ 'bg-white/10 text-[#9ee62f]' if heroDark else 'bg-[#F0F5E8] text-[#5a9100]' }}" aria-hidden="true">
                      {{ useCaseIcon(loop.index0) }}
                    </span>
                    <span class="text-[14px] font-medium {{ 'text-white' if heroDark else 'text-[#111827]' }}">{{ feature }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}

            <a
              href="{{ product.hero.ctaPrimary.href }}"
              class="mt-7 inline-flex w-fit items-center gap-2 rounded-md border px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 {{ 'border-white/20 text-white hover:border-white/40 hover:bg-white/10' if heroDark else 'border-navy-200 text-navy-700 hover:border-navy-400 hover:bg-navy-50' }}"
            >
              {{ product.hero.ctaPrimary.label }}
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
            </a>
          </div>

          <div class="relative flex items-center justify-center p-8 sm:p-10 {{ 'bg-white/5' if heroDark else 'bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40' }}" aria-hidden="true">
            <div class="flex w-full max-w-[260px] flex-col items-center gap-5 rounded-xl border p-6 shadow-md {{ 'border-white/10 bg-navy-900/70' if heroDark else 'border-white/70 bg-white' }}">
              <span class="flex items-center gap-2 self-start rounded-full px-3 py-1.5 {{ 'bg-white/10' if heroDark else 'bg-navy-50' }}">
                <span class="usecase-engine-ping h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]"></span>
                <span class="font-mono text-[10px] uppercase tracking-wider {{ 'text-white/60' if heroDark else 'text-navy-500' }}">{{ item.title }}</span>
              </span>

              <div class="relative flex h-[68px] w-full items-center justify-center">
                <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40"></span>
                <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40" style="animation-delay: 0.6s"></span>
                <span class="benefit-pulse-ring absolute h-12 w-12 rounded-full border border-[#76B900]/40" style="animation-delay: 1.2s"></span>
                <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-navy-950 text-white shadow-md">
                  {{ useCaseIcon(loop.index0, "h-5 w-5") }}
                </span>
              </div>

              {% if item.features and item.features.length %}
                <div class="w-full space-y-2">
                  {% for feature in item.features %}
                    <div class="benefit-list-row flex items-center gap-2 rounded-md px-3 py-2 {{ 'bg-white/10' if heroDark else 'bg-navy-50/70' }}" style="animation-delay: {{ loop.index0 * 0.5 }}s">
                      <svg class="h-3.5 w-3.5 flex-shrink-0 text-[#76B900]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                      <span class="truncate text-[11px] {{ 'text-white/70' if heroDark else 'text-navy-600' }}">{{ feature }}</span>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
    {% if isFlowLayout %}
      <div class="flex justify-center border-t p-6 sm:p-8 {{ 'border-white/10' if heroDark else 'border-navy-100/70' }}">
        <a
          href="{{ product.hero.ctaPrimary.href }}"
          class="inline-flex w-fit items-center gap-2 rounded-md border px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 {{ 'border-white/20 text-white hover:border-white/40 hover:bg-white/10' if heroDark else 'border-navy-200 text-navy-700 hover:border-navy-400 hover:bg-navy-50' }}"
        >
          {{ product.hero.ctaPrimary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
        </a>
      </div>
    {% endif %}
    </div>
  </div>
</section>

<style>
  @keyframes usecase-engine-ping {
    0%, 100% { box-shadow: 0 0 0 0 rgba(118, 185, 0, 0.4); }
    50% { box-shadow: 0 0 0 4px rgba(118, 185, 0, 0); }
  }
  .usecase-engine-ping {
    animation: usecase-engine-ping 1.6s ease-in-out infinite;
  }

  @keyframes orca-hub-glow {
    0%, 100% { opacity: 0.55; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.08); }
  }
  .orca-hub-glow {
    background: radial-gradient(circle, rgba(118, 185, 0, 0.55) 0%, rgba(118, 185, 0, 0.15) 45%, transparent 72%);
    filter: blur(6px);
    animation: orca-hub-glow 2.4s ease-in-out infinite;
  }

  @keyframes orca-hub-pulse {
    0%, 100% { box-shadow: 0 0 16px 2px rgba(118, 185, 0, 0.35), inset 0 0 0 1px rgba(118, 185, 0, 0.3); }
    50% { box-shadow: 0 0 32px 8px rgba(118, 185, 0, 0.6), inset 0 0 0 1px rgba(118, 185, 0, 0.5); }
  }
  .orca-hub-pulse {
    animation: orca-hub-pulse 2.4s ease-in-out infinite;
  }

  @keyframes flow-line-dash {
    0% { stroke-dashoffset: 220; }
    100% { stroke-dashoffset: -220; }
  }
  .flow-line-dash {
    animation: flow-line-dash 2.6s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .usecase-engine-ping,
    .orca-hub-glow,
    .orca-hub-pulse,
    .flow-line-dash {
      animation: none !important;
    }
  }
</style>

{# =====================================================
   PLATFORM TIE-IN — dark navy card, cross-linking the other
   two platform pillars by name. Reuses industry.njk's Platform
   Tie-In card pattern. Removed for Orca only (2026-09-27) — the
   Benefits section above already carries this same "shared
   platform" message (see orcaBenefitMockup index 1), so this
   card was redundant on Orca's page specifically. Search and
   AI CRM keep it.
   ===================================================== #}
{% if product.id != "orca" %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="platform-tie-in-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-2xl border p-8 sm:p-10 lg:p-12 {{ 'border-white/10 bg-navy-900/60 backdrop-blur-md' if heroDark else 'border-transparent bg-navy-950' }}"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.25) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.3) 0%, transparent 60%);"
      ></div>
      {# Same background-pattern treatment as the "AI & Machine Learning" capability card on
         about.njk — a different asset (card-info-01, not card-info-02) so this card doesn't
         repeat that card's exact texture. Applied to the whole card, not just the pillars. #}
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-cover bg-center opacity-[0.1]"
        style="background-image: url('/assets/images/card-info-01.avif');"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">Platform</span>
        <h2 id="platform-tie-in-heading" class="max-w-xl text-[24px] font-medium leading-[1.2] text-white sm:text-[28px]">
          {{ product.platformTieIn.heading }}
        </h2>
        <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-white/60">
          {{ product.platformTieIn.body }}
        </p>

        {% if product.platformTieIn.pillars and product.platformTieIn.pillars.length %}
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {% for pillar in product.platformTieIn.pillars %}
              <a href="{{ pillar.href }}" class="group rounded-xl border border-white/15 bg-white/5 p-4 transition-colors duration-200 hover:border-white/30 hover:bg-white/10">
                <span class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-wide text-white">
                  {{ pillar.name }}
                  <span class="h-1 w-1 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
                </span>
                <span class="mt-1.5 block text-[13px] leading-relaxed text-white/60">{{ pillar.description }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        <a
          href="{{ product.platformTieIn.cta.href }}"
          class="mt-7 inline-flex items-center gap-2 rounded-md border border-white/20 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.platformTieIn.cta.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   PROOF / TESTIMONIAL — single quote card, reused from
   homepage-v2's Proof/Testimonials pattern. Renders only when
   a real client quote exists for this product.
   ===================================================== #}
{% if product.testimonial %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="testimonial-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="testimonial-heading" class="sr-only">What our clients say</h2>
    <div class="relative flex min-h-[220px] flex-col justify-between overflow-hidden rounded-2xl border border-navy-100/50 bg-white p-8 shadow-md sm:p-10" data-reveal>
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 80% 20%, rgba(118, 185, 0, 0.05) 0%, transparent 60%);"></div>
      <blockquote class="relative z-10 max-w-lg text-[22px] font-medium leading-snug text-[#111827] sm:text-[26px]">
        "{{ product.testimonial.quote }}"
      </blockquote>
      <footer class="relative z-10 mt-8 flex items-center gap-3">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 font-mono text-[12px] font-semibold uppercase text-[#6B7280]">
          {{ product.testimonial.company[0] }}
        </span>
        <cite class="text-[13px] font-normal not-italic leading-tight text-[#6B7280]">{{ product.testimonial.role }}</cite>
      </footer>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   FAQ — accordion, reused from homepage-v2's FAQ pattern.
   Renders only when the product has real FAQ content.
   ===================================================== #}
{% if product.faq and product.faq.length %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider {{ 'text-white/50' if heroDark else 'text-[#9CA3AF]' }}">
        Support
      </span>
      <h2 id="faq-heading" class="text-[28px] font-medium leading-[1.2] tracking-tight sm:text-[32px] lg:text-[36px] {{ 'text-white' if heroDark else 'text-[#111827]' }}">
        Frequently asked questions
      </h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="{{ 'divide-y divide-white/10' if heroDark else 'divide-y divide-navy-100' }}" data-reveal-stagger>
        {% for item in product.faq %}
          <div class="py-5">
            <button
              @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
              class="flex w-full items-center justify-between gap-4 text-left group"
              :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
              aria-controls="faq-answer-{{ loop.index }}"
            >
              <span class="text-[16px] font-medium leading-snug transition-colors sm:text-[17px] {{ 'text-white group-hover:text-white/80' if heroDark else 'text-[#111827] group-hover:text-navy-600' }}">
                {{ item.question }}
              </span>
              <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border transition-transform duration-200 {{ 'border-white/20 text-white/70' if heroDark else 'border-navy-200 text-navy-500' }}" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </button>
            <div
              id="faq-answer-{{ loop.index }}"
              x-show="activeIndex === {{ loop.index }}"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-2"
              class="overflow-hidden"
            >
              <p class="pt-3 pr-10 text-[14px] leading-relaxed sm:text-[15px] {{ 'text-white/60' if heroDark else 'text-[#6B7280]' }}">{{ item.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   CLOSING DUAL CTA — same shell/copy pattern as homepage-v2's
   and industry.njk's closing CTA banner.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="closing-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] border px-6 py-14 text-center sm:px-12 sm:py-16 {{ 'border-white/10 bg-navy-900/60 backdrop-blur-md' if heroDark else 'border-transparent bg-navy-950' }}"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <span class="relative z-10 mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">
        {{ product.closingCta.eyebrow }}
      </span>
      <h2 id="closing-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-medium leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        {{ product.closingCta.headline }}
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        {{ product.closingCta.body }}
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="{{ product.closingCta.ctaPrimary.href }}"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.closingCta.ctaPrimary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
        <a
          href="{{ product.closingCta.ctaSecondary.href }}"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.closingCta.ctaSecondary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{% if heroDark %}
  </div>
</div>
{% endif %}

{% include "partials/footer-v2.njk" %}
