        <span class="h-3 w-px bg-[#76B900]/50"></span>
        <span class="h-3 w-px bg-navy-200"></span>
      </div>
      <div class="rounded-lg border border-navy-100/70 bg-gradient-to-r from-[#F0F5E8] via-white to-[#F0F5E8] px-3 py-2.5 text-center">
        <span class="font-mono text-[10px] uppercase tracking-wider text-[#5a9100]">Multi-tenant runtime</span>
        <p class="mt-1 font-mono text-[9px] text-navy-400">platform.tenant · shared across every deployment</p>
      </div>
    </div>
  {% else %}
    <div class="w-full space-y-2">
      <div class="mb-1 flex items-center justify-between">
        <span class="font-mono text-[9.5px] uppercase tracking-wider text-navy-400">
          {% if index == 0 %}Connected Tools{% else %}Cross-System Sync{% endif %}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-navy-100/70 bg-white px-1.5 py-0.5 font-mono text-[9px] text-navy-500 shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-[#76B900] animate-pulse"></span>
          Live
        </span>
      </div>
      {% if index == 0 %}
        {{ orcaBenefitRow("CRM — Connected", "Reads and writes without migration.", "orca.link/crm · v2", "ok") }}
        {{ orcaBenefitRow("Email — Connected", "Native connector, agent-addressable.", "orca.link/email · v2", "ok") }}
        {{ orcaBenefitRow("Marketing — Connected", "Extends without rebuilding logic.", "orca.link/marketing · v2", "ok") }}
      {% else %}
        {{ orcaBenefitRow("Lead moved to Opportunity", "CRM → Email sequence triggered.", "handoff.trace/lead_4821", "ok") }}
        {{ orcaBenefitRow("Campaign engagement logged", "Marketing → CRM record enriched.", "handoff.trace/camp_1187", "ok") }}
        {{ orcaBenefitRow("Follow-up reminder queued", "Email → CRM update in progress.", "handoff.trace/fw_0093", "pending") }}
