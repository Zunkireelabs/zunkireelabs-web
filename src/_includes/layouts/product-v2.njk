       (2026-09-27) — this benefit is about shared infrastructure, not
       live cross-system events, so it reads as a small tenancy diagram:
       three product chips sitting on one common runtime base. #}
    <div class="w-full">
      <div class="mb-4 flex items-center justify-between">
        <span class="font-mono text-[9.5px] uppercase tracking-wider text-navy-400">Shared Platform</span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-navy-100/70 bg-white px-1.5 py-0.5 font-mono text-[9px] text-navy-500 shadow-sm">1 runtime</span>
      </div>
      <div class="flex items-end justify-center gap-3">
        <div class="flex flex-col items-center gap-1.5 rounded-lg border border-navy-100/70 bg-white px-3 py-2.5 shadow-sm">
          <svg class="h-3.5 w-3.5 text-[#5a9100]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
          <span class="font-mono text-[9px] leading-none text-navy-600">Search</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 rounded-lg border border-[#76B900]/40 bg-[#F0F5E8] px-3 py-2.5 shadow-sm">
          <svg class="h-3.5 w-3.5 text-[#5a9100]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path></svg>
          <span class="font-mono text-[9px] leading-none text-[#5a9100]">Orca</span>
        </div>
        <div class="flex flex-col items-center gap-1.5 rounded-lg border border-navy-100/70 bg-white px-3 py-2.5 shadow-sm">
          <svg class="h-3.5 w-3.5 text-[#5a9100]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span class="font-mono text-[9px] leading-none text-navy-600">AI CRM</span>
        </div>
      </div>
      <div class="mx-auto flex w-full max-w-[220px] justify-between px-4">
