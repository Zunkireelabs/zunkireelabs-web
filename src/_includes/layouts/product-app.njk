<style>
  /* Sticky-stack scroll effect (desktop only): each card pins at an
     incrementally lower top offset than the one before it, so the next
     card slides up and covers the previous one, leaving its top edge
     peeking out above — the layered stack read from the Kore.ai reference. */
  @media (min-width: 1024px) {
    .benefit-stack-item {
      position: sticky;
      top: var(--stack-top);
      z-index: var(--stack-z);
      padding-bottom: 1.75rem;
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .benefit-stack-item {
      position: static;
    }
  }
</style>

{# =====================================================
   USE CASES — a floating sliding-pill tab bar (adapted from the
   user-supplied SlideTabs reference: a rounded-full track, an
   animated pill that slides beneath the active label, measured
   via each tab's own bounding box) over a separately-framed
   readout card below. Reimplemented in this project's own
   grammar — Alpine.js instead of React/framer-motion state,
   navy-950/#76B900 instead of black/mix-blend-difference — not
   a copy of the reference's literal colors or stack.
   ===================================================== #}
<section
  class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8"
  aria-labelledby="usecases-heading"
  x-data="{
    active: 0,
    pillLeft: 0,
    pillWidth: 0,
    updatePill() {
      const el = this.$refs['usecaseTab' + this.active];
      if (el) { this.pillLeft = el.offsetLeft; this.pillWidth = el.offsetWidth; }
    }
  }"
  x-init="$nextTick(() => updatePill())"
  @resize.window="updatePill()"
>
  <div class="mx-auto max-w-4xl">
    <h2 id="usecases-heading" class="mb-8 text-center text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[30px]">
      {{ product.useCases.heading }}
    </h2>

    {% if product.useCases.items and product.useCases.items.length > 1 %}
      <div class="mb-6 flex justify-center overflow-x-auto" data-reveal>
        <div role="tablist" aria-label="{{ product.useCases.heading }}" class="relative inline-flex flex-shrink-0 items-center gap-1 rounded-full border border-sky-200/70 bg-sky-50 p-1 shadow-subtle">
          <span
            class="absolute inset-y-1 rounded-full bg-white shadow-md transition-all duration-300 ease-out"
            :style="`left: ${pillLeft}px; width: ${pillWidth}px;`"
            aria-hidden="true"
          ></span>
          {% for item in product.useCases.items %}
            <button
              type="button"
              role="tab"
              id="usecase-tab-{{ loop.index0 }}"
              aria-controls="usecase-panel-{{ loop.index0 }}"
              :aria-selected="active === {{ loop.index0 }} ? 'true' : 'false'"
              :tabindex="active === {{ loop.index0 }} ? 0 : -1"
              @click="active = {{ loop.index0 }}; updatePill()"
              @keydown.right.prevent="active = (active + 1) % {{ product.useCases.items.length }}; updatePill(); $nextTick(() => $refs['usecaseTab' + active].focus())"
              @keydown.left.prevent="active = (active - 1 + {{ product.useCases.items.length }}) % {{ product.useCases.items.length }}; updatePill(); $nextTick(() => $refs['usecaseTab' + active].focus())"
              x-ref="usecaseTab{{ loop.index0 }}"
              class="relative z-10 flex flex-shrink-0 items-center gap-2 whitespace-nowrap rounded-full px-4 py-2.5 font-mono text-[11px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
              :class="active === {{ loop.index0 }} ? 'text-navy-900' : 'text-sky-700 hover:text-navy-800'"
            >
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full transition-colors duration-200" :class="active === {{ loop.index0 }} ? 'bg-[#76B900]' : 'bg-sky-300'" aria-hidden="true"></span>
              {{ item.title }}
            </button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {% for item in product.useCases.items %}
      <div
        id="usecase-panel-{{ loop.index0 }}"
        role="tabpanel"
        aria-labelledby="usecase-tab-{{ loop.index0 }}"
        x-show="active === {{ loop.index0 }}"
        {% if not loop.first %}x-cloak{% endif %}
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 translate-y-1"
        x-transition:enter-end="opacity-100 translate-y-0"
        class="rounded-xl border border-navy-200/70 bg-white p-6 shadow-card sm:p-8"
      >
        <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-10">
          <div>
            <p class="text-[15px] leading-relaxed text-[#6B7280] sm:text-[16px]">{{ item.description }}</p>

            {% if item.features and item.features.length %}
              <div class="mt-5 flex flex-wrap gap-2">
                {% for feature in item.features %}
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-[#DCE9C8] bg-[#F0F5E8] px-3 py-1.5 font-mono text-[11px] text-[#3f6b1a]">
                    <svg class="h-3 w-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                    {{ feature }}
                  </span>
                {% endfor %}
              </div>
            {% endif %}

            <a
              href="{{ product.hero.ctaPrimary.href }}"
              class="mt-6 inline-flex w-fit items-center gap-2 rounded-md border border-navy-200 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-navy-700 transition-all duration-200 hover:border-navy-400 hover:bg-navy-50 hover:shadow-subtle focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            >
              {{ product.hero.ctaPrimary.label }}
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
            </a>
          </div>

          {% if item.features and item.features.length %}
            <div class="overflow-hidden rounded-xl border border-navy-200/70 bg-white shadow-card" aria-hidden="true" data-reveal-stagger>
              <div class="flex items-center gap-2 bg-navy-950 px-4 py-2.5">
                <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-md bg-white/10 text-[#76B900]">
                  {% set iconName = product.icon %}
                  {% include "components/nav-icon.njk" %}
                </span>
                <span class="truncate font-mono text-[11px] uppercase tracking-wide text-white/70">{{ item.title }}</span>
              </div>
              <div class="space-y-2.5 p-5">
                {% for feature in item.features %}
                  <div class="flex items-center gap-2.5 rounded-lg border border-[#DCE9C8] bg-[#F0F5E8] px-3.5 py-2.5">
                    <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-[#76B900] text-white">
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg>
                    </span>
                    <span class="text-[13px] font-medium leading-snug text-navy-800">{{ feature }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{# =====================================================
   PLATFORM TIE-IN — identical dark navy card to product-v2.njk
   (this is a site-wide closing device, not part of what
   differentiates this tier).
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="platform-tie-in-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-2xl bg-navy-950 p-8 sm:p-10 lg:p-12"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.25) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.3) 0%, transparent 60%);"
      ></div>
      {# Same background-pattern treatment as product-v2.njk's Platform Tie-In card. #}
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-cover bg-center opacity-[0.1]"
        style="background-image: url('/assets/images/card-info-01.avif');"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-white/50">Platform</span>
        <h2 id="platform-tie-in-heading" class="max-w-xl text-[24px] font-medium leading-[1.2] text-white sm:text-[28px]">
          {{ product.platformTieIn.heading }}
        </h2>
        <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-white/60">
          {{ product.platformTieIn.body }}
        </p>

        {% if product.platformTieIn.pillars and product.platformTieIn.pillars.length %}
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {% for pillar in product.platformTieIn.pillars %}
              <a href="{{ pillar.href }}" class="group rounded-xl border border-white/15 bg-white/5 p-4 transition-colors duration-200 hover:border-white/30 hover:bg-white/10">
                <span class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-wide text-white">
                  {{ pillar.name }}
                  <span class="h-1 w-1 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
                </span>
                <span class="mt-1.5 block text-[13px] leading-relaxed text-white/60">{{ pillar.description }}</span>
              </a>
            {% endfor %}
          </div>
        {% endif %}

        <a
          href="{{ product.platformTieIn.cta.href }}"
          class="mt-7 inline-flex items-center gap-2 rounded-md border border-white/20 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ product.platformTieIn.cta.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   PROOF / TESTIMONIAL — identical to product-v2.njk. Renders
   only when a real client quote exists for this product.
   ===================================================== #}
{% if product.testimonial %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="testimonial-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="testimonial-heading" class="sr-only">What our clients say</h2>
    <div class="relative flex min-h-[220px] flex-col justify-between overflow-hidden rounded-2xl border border-navy-100/50 bg-white p-8 shadow-md sm:p-10" data-reveal>
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 80% 20%, rgba(118, 185, 0, 0.05) 0%, transparent 60%);"></div>
      <blockquote class="relative z-10 max-w-lg text-[22px] font-medium leading-snug text-[#111827] sm:text-[26px]">
        "{{ product.testimonial.quote }}"
      </blockquote>
      <footer class="relative z-10 mt-8 flex items-center gap-3">
        <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 font-mono text-[12px] font-semibold uppercase text-[#6B7280]">
          {{ product.testimonial.company[0] }}
        </span>
        <cite class="text-[13px] font-normal not-italic leading-tight text-[#6B7280]">{{ product.testimonial.role }}</cite>
      </footer>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   FAQ — identical accordion to product-v2.njk. Renders only
   when the product has real FAQ content.
   ===================================================== #}
{% if product.faq and product.faq.length %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Support
      </span>
      <h2 id="faq-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Frequently asked questions
      </h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for item in product.faq %}
          <div class="py-5">
            <button
              @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
              class="flex w-full items-center justify-between gap-4 text-left group"
              :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
              aria-controls="faq-answer-{{ loop.index }}"
            >
              <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
                {{ item.question }}
              </span>
              <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </button>
            <div
              id="faq-answer-{{ loop.index }}"
              x-show="activeIndex === {{ loop.index }}"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-2"
              class="overflow-hidden"
            >
              <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">{{ item.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   CLOSING DUAL CTA — identical shell/copy pattern to
   product-v2.njk / industry.njk.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="closing-cta-heading">
  <div class="mx-auto max-w-5xl">
