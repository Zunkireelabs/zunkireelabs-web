---
layout: base.njk
---

{# =====================================================
   INDUSTRY VERTICAL PAGE LAYOUT — shared by all four
   /industries/{id}/ pages. One file, data-driven via
   src/_data/industries.js. Do not fork per-industry —
   differences are data (docs/INDUSTRY_PAGES_CONTENT_PLAN.md),
   not markup. Visual language matches homepage-v2.njk
   (same tokens, same component recipes) but is implemented
   fresh here per project decision — homepage-v2.njk is not
   touched or imported from.
   Section order: docs/PAGE_BLUEPRINTS.md §2.
   ===================================================== #}

{% set industry = null %}
{% for ind in industries %}
  {% if ind.id == industryId %}
    {% set industry = ind %}
  {% endif %}
{% endfor %}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   PAIN POINT VISUAL MACRO — tiny animated sky-blue mockups, one
   per pain-point block (by position: 1 = lead, 2/3 = secondary).
   Pure CSS/SVG loops, no JS — illustrates the specific pain
   point rather than a generic decorative line.
   ===================================================== #}
{% macro painPointVisual(index) %}
  {% if index == 1 %}
    <div class="pp-visual pp-visual--lead pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-5" aria-hidden="true">
      <span class="pp-chat-bubble">
        <span class="pp-chat-dot"></span>
        <span class="pp-chat-dot"></span>
        <span class="pp-chat-dot"></span>
      </span>
      <span class="pp-chat-ring"></span>
    </div>
  {% elif index == 2 %}
    <div class="pp-visual pp-visual--sm pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-4" aria-hidden="true">
      <span class="pp-node pp-node--a"></span>
      <svg class="pp-node-line" viewBox="0 0 60 8" preserveAspectRatio="none"><line x1="2" y1="4" x2="58" y2="4" stroke-width="2" stroke-dasharray="4 4"/></svg>
      <span class="pp-node pp-node--b"></span>
    </div>
  {% else %}
    <div class="pp-visual pp-visual--sm pp-visual--rows pp-visual-card rounded-lg border border-sky-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-4" aria-hidden="true">
      <span class="pp-row" style="animation-delay: 0s"></span>
      <span class="pp-row" style="animation-delay: 0.2s"></span>
      <span class="pp-row" style="animation-delay: 0.4s"></span>
    </div>
  {% endif %}
{% endmacro %}

{# =====================================================
   HERO — centered single-column, matches homepage-v2's hero
   typography/spacing but on a plain white ground (no bg image;
   these are secondary pages, per PAGE_BLUEPRINTS.md §2 Layout's
   "same calm confidence" rule, not a re-run of the homepage's
   signature visual).
   ===================================================== #}
<section class="relative flex flex-col items-center justify-center px-4 pb-8 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pt-40" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    <span class="mb-4 inline-flex items-center rounded-full border border-sky-100/60 bg-sky-50/60 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-sky-600 shadow-subtle">
      {{ industry.eyebrow }}
    </span>

    <h1 id="hero-heading" class="text-center text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
      {{ industry.hero.headline | safe }}
    </h1>

    <p class="mt-4 max-w-[720px] text-center text-[18px] font-medium leading-relaxed text-[#6B7280] sm:text-[20px]">
      {{ industry.hero.subhead | safe }}
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="{{ industry.hero.ctaPrimary.href }}"
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
      >
        {{ industry.hero.ctaPrimary.label }}
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
      </a>
      <a
        href="{{ industry.hero.ctaSecondary.href }}"
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md border border-navy-300 px-5 py-2.5 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
      >
        {{ industry.hero.ctaSecondary.label }}
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

{# =====================================================
   PAIN POINT — short framing strip, 3 compact blocks.
   Deliberately lighter than a full pain-point grid (Kore.ai's
   ai-for-healthcare research informed the rhythm, not the density —
   this is a lead-in, not its own heavy section).
   ===================================================== #}
{% if industry.painPoint %}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="pain-point-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="pain-point-heading" class="mb-8 text-center text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[28px]">
      {{ industry.painPoint.heading }}
    </h2>
    <div class="overflow-hidden rounded-xl border border-navy-100/60 bg-gradient-to-br from-sky-50/60 via-white to-white shadow-card transition-shadow duration-300 hover:shadow-card-hover" data-reveal-stagger>
      <div class="flex flex-col divide-y divide-navy-200 sm:flex-row sm:divide-y-0">
        {% for block in industry.painPoint.blocks %}
          {% if loop.index == 1 %}
            <div class="flex min-h-[360px] flex-col justify-center p-8 sm:w-3/5 sm:border-r sm:border-navy-200 lg:p-12">
              <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-sky-600">Primary</p>
              <p class="text-[26px] font-semibold leading-snug text-[#111827] sm:text-[28px]">{{ block.title }}</p>
              <p class="mt-2 max-w-[38ch] text-[15px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
              {{ painPointVisual(1) }}
            </div>
          {% endif %}
        {% endfor %}
        <div class="flex flex-col sm:w-2/5">
          {% for block in industry.painPoint.blocks %}
            {% if loop.index != 1 %}
              <div class="flex min-h-[180px] flex-1 flex-col justify-center p-7 lg:p-9{% if loop.index == 2 %} border-b border-navy-200{% endif %}">
                <p class="text-[19px] font-semibold leading-snug text-[#111827]">{{ block.title }}</p>
                <p class="mt-1.5 text-[13px] leading-relaxed text-[#6B7280]">{{ block.description }}</p>
                {{ painPointVisual(loop.index) }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .pp-visual {
    margin-top: 20px;
    width: fit-content;
    align-self: flex-start;
  }

  /* Lead visual: a stalled chat bubble — typing dots that never
     resolve into a reply, plus a slow "waiting" ring around it. */
  .pp-visual--lead {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .pp-chat-bubble {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 14px;
    border-radius: 999px 999px 999px 4px;
    background: #eff7ff;
    border: 1px solid #bfe1fc;
  }
  .pp-chat-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2673b8;
    animation: pp-chat-dot-bounce 1.2s ease-in-out infinite;
  }
  .pp-chat-dot:nth-child(2) { animation-delay: 0.15s; }
  .pp-chat-dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pp-chat-dot-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
  .pp-chat-ring {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 999px;
    border: 1px solid #93ccfa;
    opacity: 0;
    animation: pp-chat-ring-pulse 2.4s ease-out infinite;
  }
  @keyframes pp-chat-ring-pulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.25); opacity: 0; }
  }

  /* Secondary visual 1: two nodes with a dashed line whose gap
     pulses — reads as "connected but not really talking." */
  .pp-visual--sm {
    display: flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }
  .pp-node {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #dbeffe;
    border: 1.5px solid #2673b8;
  }
  .pp-node-line {
    width: 44px;
    height: 8px;
    overflow: visible;
  }
  .pp-node-line line {
    stroke: #93ccfa;
    animation: pp-node-line-pulse 2s ease-in-out infinite;
  }
  @keyframes pp-node-line-pulse {
    0%, 100% { stroke-dashoffset: 0; opacity: 0.5; }
    50% { stroke-dashoffset: 8; opacity: 1; }
  }

  /* Secondary visual 2: stacked rows cycling in place — reads as
     repetitive manual sorting/triage. */
  .pp-visual--rows {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
  .pp-row {
    display: block;
    height: 5px;
    width: 46px;
    border-radius: 2px;
    background: #bfe1fc;
    animation: pp-row-cycle 1.8s ease-in-out infinite;
  }
  @keyframes pp-row-cycle {
    0%, 100% { transform: translateX(0); opacity: 0.6; }
    50% { transform: translateX(5px); opacity: 1; background: #60aef5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pp-chat-dot,
    .pp-chat-ring,
    .pp-node-line line,
    .pp-row {
      animation: none;
    }
  }
</style>
{% endif %}

{# =====================================================
   FLAGSHIP PROOF — Industry/Vertical Card, with-client-proof or
   capability-led variant (COMPONENT_LIBRARY.md §4.2). Agencies is
   the one vertical with two proof instances (self-run + Mobilise) —
   rendered as a 2-column grid instead of a single card.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="flagship-proof-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="flagship-proof-heading" class="sr-only">Flagship proof</h2>

    {% if industry.flagshipProof.multi %}
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-2" data-reveal-stagger>
        {% for instance in industry.flagshipProof.instances %}
          <div class="flex flex-col rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-7">
            <span class="mb-3 inline-flex w-fit items-center rounded-full bg-navy-900 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-white">
              {{ instance.categoryPill }}
            </span>
            <h3 class="text-[20px] font-semibold leading-snug text-[#111827]">{{ instance.headline }}</h3>
            <p class="mt-2.5 text-[14px] leading-relaxed text-[#6B7280]">{{ instance.proofLine }}</p>
            <a
              href="{{ instance.cta.href }}"
              class="mt-5 inline-flex min-h-[44px] w-fit items-center gap-2 rounded-md bg-[#76B900] px-4 py-2 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            >
              {{ instance.cta.label }}
            </a>
          </div>
        {% endfor %}
      </div>
      {% if industry.flagshipProof.statsNote %}
        <p class="mt-4 text-center text-[12px] text-navy-500">{{ industry.flagshipProof.statsNote }}</p>
      {% endif %}
    {% else %}
      <div class="flex flex-col rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-8 lg:p-10" data-reveal>
        <span class="mb-3 inline-flex w-fit items-center rounded-full bg-navy-900 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-white">
          {{ industry.flagshipProof.categoryPill }}
        </span>
        <h3 class="max-w-2xl text-[22px] font-semibold leading-snug text-[#111827] sm:text-[26px]">{{ industry.flagshipProof.headline }}</h3>
        <p class="mt-3 max-w-2xl text-[14px] leading-relaxed text-[#6B7280]">{{ industry.flagshipProof.proofLine }}</p>

        {% if industry.flagshipProof.stats and industry.flagshipProof.stats.length %}
          <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
            {% for stat in industry.flagshipProof.stats %}
              <div class="rounded-xl border border-white/50 bg-white/70 px-4 py-3 backdrop-blur-sm">
                <span class="block font-mono text-2xl font-semibold leading-none text-[#111827] sm:text-3xl" data-counter="{{ stat.value }}">{{ stat.value }}</span>
                <span class="mt-1.5 block text-[12px] font-medium leading-relaxed text-[#6B7280]">{{ stat.label }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <a
          href="{{ industry.flagshipProof.cta.href }}"
          class="mt-6 inline-flex min-h-[44px] w-fit items-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ industry.flagshipProof.cta.label }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{# =====================================================
   PRE-BUILT APPLICATION OVERVIEW — 50/50 text+visual pair
   (COMPONENT_LIBRARY.md §3.1 Section Header + §2.2 Hero Visual).
   Visual uses the same glass-gradient placeholder tile as
   homepage-v2's capability tiles until real product screenshots
   are sourced (docs/INDUSTRY_PAGES_CONTENT_PLAN.md flags every
   [NEEDS ASSET]) — never a fabricated screenshot.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="app-overview-heading">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12" data-reveal-stagger>
      <div>
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-navy-500">Pre-Built Application</span>
        <h2 id="app-overview-heading" class="text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[30px]">
          {{ industry.appOverview.heading }}
        </h2>
        <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-[#6B7280]">
          {{ industry.appOverview.body }}
        </p>
      </div>

      <div class="relative flex min-h-[260px] items-center justify-center rounded-xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 backdrop-blur-md" aria-hidden="true">
        <div class="tile-float w-full max-w-[240px] rounded-xl border border-white/70 bg-white p-5 shadow-md">
          <div class="mb-3 flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#76B900]"></span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-navy-500">{{ industry.eyebrow }}</span>
          </div>
          <div class="space-y-2">
            <div class="h-2.5 w-full rounded bg-navy-100/60"></div>
            <div class="h-2.5 w-4/5 rounded bg-navy-100/60"></div>
            <div class="h-2.5 w-3/5 rounded bg-navy-100/60"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes tile-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  .tile-float {
    animation: tile-float 4s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-float {
      animation: none;
    }
  }
</style>

{# =====================================================
   ACCELERATORS — Feature Grid (§3.2) for most verticals; Education
   renders as a How-It-Works sequential-step list instead, per
   PAGE_BLUEPRINTS.md §2's per-vertical note (it's a workflow, not a
   flat capability set).
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="accelerators-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="accelerators-heading" class="mb-8 text-center text-[26px] font-semibold leading-[1.2] text-[#111827] sm:text-[30px]">
      {{ industry.accelerators.heading }}
    </h2>

    {% if industry.accelerators.style == "steps" %}
      <div class="relative">

        {# Mobile/tablet fallback — the node-link diagram below is a lg+ layout only; smaller
           breakpoints get every node as a flat, numbered, still-grouped-by-column card list. #}
        {% set mobileStepAcc = [] %}
        <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:hidden" data-reveal-stagger>
          {% for column in industry.accelerators.columns %}
            {% for node in column.nodes %}
              {% set mobileStepAcc = (mobileStepAcc.push(1), mobileStepAcc) %}
              <li class="rounded-xl border border-navy-100/60 bg-white p-5 shadow-subtle">
                <div class="flex items-start gap-3">
                  <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-zunkiree-600 font-mono text-[11px] font-semibold text-white">{{ mobileStepAcc.length }}</span>
                  <div class="min-w-0">
                    <span class="block font-mono text-[11px] uppercase tracking-wider text-navy-500">{{ column.label }}</span>
                    <p class="mt-0.5 text-[16px] font-semibold leading-snug text-[#111827]">{{ node.name }}</p>
                  </div>
                </div>
                <p class="mt-3 text-[14px] leading-relaxed text-[#6B7280]">{{ node.description }}</p>
                <p class="mt-2 font-mono text-[11px] text-navy-400">{{ node.path }}</p>
                {% if node.tag %}
                  <span class="mt-3 inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 font-mono text-[10.5px] uppercase tracking-wide text-sky-700">{{ node.tag }}</span>
                {% endif %}
              </li>
            {% endfor %}
          {% endfor %}
        </ol>

        {# Node-link pipeline diagram — lg+ only. Each column is a boxed pipeline phase (sky-tint
           surface, matching the pain-point/flagship-proof/platform-tie-in cards elsewhere on this
           page) holding its own white node cards, numbered in overall sequence. Handoff connectors
           sit in dedicated fixed-width tracks between columns (not absolute overlays), so they stay
           correctly positioned regardless of column content height — a line-plus-pill badge, reusing
           the same motif as the "Runs alongside the pipeline" divider below for system consistency. #}
        {% set desktopStepAcc = [] %}
        <div class="hidden lg:grid lg:grid-cols-[minmax(0,1fr)_2.5rem_minmax(0,1fr)_2.5rem_minmax(0,1fr)_2.5rem_minmax(0,1fr)] lg:items-stretch" data-reveal-stagger>
          {% for column in industry.accelerators.columns %}
            <div class="relative z-0 flex min-h-[560px] flex-col border border-sky-100/60 bg-sky-50/50 pb-4">
              <div class="mb-3 flex items-center gap-2 px-4 pt-4 text-left">
                <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-white text-sky-600 shadow-subtle" style="background-color: #ffffff;">{{ column.icon | safe }}</span>
                <span class="font-mono text-[15px] font-semibold uppercase tracking-wider text-navy-700">{{ column.label }}</span>
              </div>

              {# Node stack — plain vertical stack, no connector between cards. #}
              <div class="flex flex-col gap-3 px-4{% if column.nodes.length == 1 %} flex-1 justify-center{% endif %}">
                {% for node in column.nodes %}
                  {% set desktopStepAcc = (desktopStepAcc.push(1), desktopStepAcc) %}
                  <div class="pipeline-node relative -ml-8 max-w-[92%] border border-navy-100/60 bg-white p-4 shadow-subtle transition-shadow duration-300 hover:shadow-card-hover" style="background-color: #ffffff;">
                    {% if node.tag %}
                      {# Tag sits in normal flow above the title, not absolutely
                         positioned over it — an absolute pill wraps to 2 lines on a
                         narrow card and covers the title underneath it. #}
                      <span class="mb-2 inline-flex items-center rounded-full bg-sky-100 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-sky-700">{{ node.tag }}</span>
                    {% endif %}
                    <div class="flex items-start gap-2.5">
                      <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-zunkiree-600 font-mono text-[10px] font-semibold text-white">{{ desktopStepAcc.length }}</span>
                      <div class="min-w-0">
                        <p class="text-left text-[14px] font-semibold leading-snug text-[#111827]">{{ node.name }}</p>
                        <p class="text-left font-mono text-[10.5px] text-navy-400">{{ node.path }}</p>
                      </div>
                    </div>
                    <p class="mt-2.5 text-left text-[12.5px] leading-relaxed text-[#6B7280]">{{ node.description }}</p>
                  </div>
                {% endfor %}
              </div>
            </div>
            {% if not loop.last %}
              <div class="relative z-20 flex items-center justify-center" aria-hidden="true">
                <span class="h-px w-full bg-navy-300"></span>
                {% if industry.accelerators.links and industry.accelerators.links[loop.index0] %}
                  <span class="absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center whitespace-nowrap rounded-full border border-navy-200 bg-white px-2.5 py-1 font-mono text-[9px] uppercase tracking-wider text-navy-600 shadow-subtle">
                    {{ industry.accelerators.links[loop.index0] }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if industry.accelerators.supporting and industry.accelerators.supporting.length %}
          <div class="relative mt-10 lg:mt-12">
            {# Divider, not a fork off the flow — these two run alongside the whole pipeline
               rather than downstream of any one stage, so a labeled rule reads correctly
               regardless of how tall the diagram above it is (a floating stub didn't). #}
            <div class="flex items-center gap-3" aria-hidden="true">
              <span class="h-px flex-1 bg-navy-200"></span>
              <span class="inline-flex items-center rounded-full border border-navy-200 bg-white px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-navy-500">
                Runs alongside the pipeline
              </span>
              <span class="h-px flex-1 bg-navy-200"></span>
            </div>
            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
              {% for item in industry.accelerators.supporting %}
                <div class="rounded-xl border border-navy-100/60 bg-white p-5 shadow-subtle">
                  <p class="text-[16px] font-semibold text-[#111827] sm:text-[18px]">{{ item.title }}</p>
                  <p class="mt-1.5 text-[13.5px] leading-relaxed text-[#6B7280] sm:text-[14px]">{{ item.description }}</p>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    {% elif industry.accelerators.style == "agent-grid" %}
      {# Kore.ai-style nested architecture panel: sunken sky-tinted outer panel (same
         gradient/shadow recipe as flagshipProof/platformTieIn below, for consistency
         with the rest of the page), holding a column per capability area, each column
         holding one or more dashed-border "agent" groups, each group holding its task
         chips. A small live-status dot on each agent pill is the section's one motion
         accent — repeated as a status motif, not scattered per-element entrances. #}
      {% set botIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="9" width="14" height="10" rx="2"/><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/><path d="M12 9V6"/><circle cx="12" cy="4.5" r="1.25"/><path d="M3 13h2M19 13h2"/></svg>' %}
      {% set liveDot %}
        <span class="relative flex h-1.5 w-1.5 flex-shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-400 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-sky-600"></span>
        </span>
      {% endset %}
      <div class="relative overflow-hidden rounded-2xl border border-navy-100/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-5 shadow-card backdrop-blur-md sm:p-7 lg:p-9" data-reveal-stagger>
        {% if industry.accelerators.eyebrow %}
          <div class="mb-7 flex justify-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-sky-100/60 bg-white/70 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-sky-700 shadow-subtle">
              <span class="h-3.5 w-3.5 flex-shrink-0">{{ botIcon | safe }}</span>
              {{ industry.accelerators.eyebrow }}
            </span>
          </div>
        {% endif %}
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 lg:items-stretch">
          {% for column in industry.accelerators.columns %}
            <div class="flex h-full flex-col rounded-xl border border-navy-100/60 bg-white p-4 shadow-subtle transition-shadow duration-300 hover:shadow-card-hover sm:p-5">
              <p class="mb-1 text-center text-[16px] font-semibold tracking-tight text-[#111827]">{{ column.title }}</p>
              <div class="mx-auto mb-4 h-px w-8 bg-sky-200"></div>
              <div class="flex flex-1 flex-col justify-center gap-3">
                {% for group in column.groups %}
                  <div class="rounded-lg border border-dashed border-sky-300/80 bg-gradient-to-br from-sky-50/80 to-white/60 p-3.5 transition-colors duration-300 hover:border-sky-400">
                    <div class="mb-2.5 inline-flex items-center gap-1.5 rounded-full bg-sky-100 py-1 pl-2.5 pr-3 shadow-subtle">
                      <span class="h-3.5 w-3.5 flex-shrink-0 text-sky-700">{{ botIcon | safe }}</span>
                      <span class="font-mono text-[10.5px] font-semibold uppercase tracking-wide text-sky-800">{{ group.name }}</span>
                      {{ liveDot | safe }}
                    </div>
                    <div class="flex flex-wrap gap-1.5">
                      {% for task in group.tasks %}
                        <span class="inline-flex items-center rounded-md border border-navy-100 bg-white px-2.5 py-1.5 text-[12px] font-medium leading-snug text-[#374151] shadow-subtle transition-colors duration-200 hover:border-sky-300 hover:bg-sky-50/60">{{ task }}</span>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
              {% if column.connectsTo %}
                <div class="mt-3.5 flex items-center justify-center gap-1.5 border-t border-dashed border-navy-100 pt-3 font-mono text-[10px] uppercase tracking-wide text-navy-400">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 flex-shrink-0"><path d="M7 17 17 7M7 7h10v10"/></svg>
                  Connects to {{ column.connectsTo }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {% for item in industry.accelerators.items %}
          <div class="flex flex-col rounded-xl border border-navy-100/60 bg-white p-5 shadow-subtle transition-shadow duration-300 hover:shadow-md">
            <p class="text-[18px] font-semibold text-[#111827]">{{ item.title }}</p>
            <p class="mt-1.5 text-[14px] leading-relaxed text-[#6B7280]">{{ item.description }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{# =====================================================
   PLATFORM TIE-IN — dark navy card, shortened version of
   homepage-v2's platform teaser. One of two dark punctuation
   moments on this page (Layout guidance, PAGE_BLUEPRINTS.md §2).
   Stats render only when real numbers exist — never fabricated.
   ===================================================== #}
<section class="px-4 pb-12 pt-12 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8" aria-labelledby="platform-tie-in-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-2xl border border-navy-100/60 p-8 shadow-card backdrop-blur-md transition-shadow duration-300 hover:shadow-card-hover sm:p-10 lg:p-12"
      data-reveal
    >
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-bl from-sky-100/60 via-sky-50/20 to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background-image: radial-gradient(circle at 15% 85%, rgba(118, 185, 0, 0.08) 0%, transparent 55%);"></div>
      <div class="relative z-10">
        <span class="mb-3 block font-mono text-[11px] uppercase tracking-wider text-sky-600">Platform</span>
        <h2 id="platform-tie-in-heading" class="max-w-xl text-[24px] font-medium leading-[1.2] text-[#111827] sm:text-[28px]">
          {{ industry.platformTieIn.heading }}
        </h2>
        <p class="mt-3 max-w-xl text-[14px] leading-relaxed text-[#6B7280]">
          {{ industry.platformTieIn.body }}
        </p>

        {% if industry.platformTieIn.stats and industry.platformTieIn.stats.length %}
          <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {% for stat in industry.platformTieIn.stats %}
              <div>
                <span class="block font-mono text-2xl font-semibold leading-none text-[#111827] sm:text-3xl" data-counter="{{ stat.value }}">{{ stat.value }}</span>
                <span class="mt-1.5 block text-[12px] leading-relaxed text-[#6B7280]">{{ stat.label }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <a
          href="{{ industry.platformTieIn.cta.href }}"
          class="mt-7 inline-flex min-h-[44px] items-center gap-2 rounded-md border border-navy-300 px-5 py-2.5 font-mono text-[12px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ industry.platformTieIn.cta.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   CLOSING DUAL CTA — same dark navy + green-glow shell as
   homepage-v2's closing CTA banner (COMPONENT_LIBRARY.md §2.6,
   dark variant) — kept dark deliberately as the page's one
   signature closer, while Platform Tie-in above stays light
   glass-surface per MASTER_DESIGN_SPEC.md §4/§10.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="closing-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <span class="relative z-10 mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">
        {{ industry.closingCta.eyebrow }}
      </span>
      <h2 id="closing-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        {{ industry.closingCta.headline }}
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        {{ industry.closingCta.body }}
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="{{ industry.closingCta.ctaPrimary.href }}"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ industry.closingCta.ctaPrimary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
        <a
          href="{{ industry.closingCta.ctaSecondary.href }}"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          {{ industry.closingCta.ctaSecondary.label }}
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
