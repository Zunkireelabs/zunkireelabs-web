---
layout: base.njk
schemaType: article
hideChrome: true
bodyClass: "v2-inter"
---

{# =====================================================
   BLOG POST LAYOUT — WEBSITE V2
   Design-only reskin onto the Homepage V2 system (navbar-v2,
   footer-v2, Inter type, navy/green tokens, glass card shells).
   Layout rhythm (hero → featured media → two-col body/sidebar →
   related grid) follows the Kore.ai blog article reference the
   user supplied — section order, content, copy, links, metadata,
   and schema are all unchanged from the prior layout.
   ===================================================== #}

{% set author = authors[authorId] if authorId else authors["zunkiree-team"] %}{% set uiLocale = lang or "en" %}{% set ui = i18n[uiLocale] or i18n["en"] %}

{% include "partials/navbar-v2.njk" %}

{# =====================================================
   ARTICLE SCHEMA
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": "{{ site.url }}{{ page.url }}#article",
  "headline": "{{ title }}",
  "description": "{{ description }}",{% if pillar %}
  "articleSection": "{{ pillar | pillarLabel(lang) }}",{% endif %}{% if lang %}
  "inLanguage": "{{ lang }}",{% endif %}
  {# featuredImage may be a site-relative path (/assets/images/blog/x.jpg, how
     hand-written posts set it) or an already-absolute URL (a remote image
     credited in the front matter). Prefixing site.url onto an absolute URL
     produced "https://zunkireelabs.comhttps://images.pexels.com/..." in the
     Article schema, which is not a resolvable image for any consumer. #}
  {# SVG covers (generated gradients) are not accepted as Article images, so the schema falls back to the site image for them. #}
  {%- set schemaImage = featuredImage | default(site.meta.ogImage) -%}
  {%- if schemaImage.endsWith(".svg") -%}{%- set schemaImage = site.meta.ogImage -%}{%- endif -%}
  "image": "{% if "://" in schemaImage %}{{ schemaImage }}{% else %}{{ site.url }}{{ schemaImage }}{% endif %}",
  "datePublished": "{{ date | date('%Y-%m-%d') }}",
  "dateModified": "{{ lastUpdated | default(date) | date('%Y-%m-%d') }}",
  "isAccessibleForFree": true,{% if pillar %}
  "about": {"@type": "Thing", "name": "{{ pillar | pillarLabel(lang) }}"},{% endif %}{% set kw = [] %}{% for t in tags %}{% if t != "blog" and t != "post" and t.indexOf("blog-") != 0 %}{% set kw = (kw.push(t), kw) %}{% endif %}{% endfor %}{% if kw.length %}
  "keywords": "{{ kw | join(', ') }}",{% endif %}
  "author": {
    "@type": "Person",
    "name": "{{ author.name }}",
    "url": "{{ author.social.linkedin | default(site.url + '/about/') }}"
  },
  "publisher": {
    "@type": "Organization",
    "@id": "{{ site.url }}/#organization",
    "name": "Zunkiree Labs",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/images/zunkireelabs-logo-round.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ site.url }}{{ page.url }}"
  }
}
</script>

{# =====================================================
   PAGE GRID — a single persistent left sidebar (TOC, CTA, Topics,
   Author bio) runs the full height of the page, from the hero
   down through the article body, per user direction. Sidebar
   col-span-4 / content col-span-8 keeps the featured image and
   prose narrower than the old full-bleed treatment.
   ===================================================== #}
<article class="bg-warm-off-white pb-16 pt-32 sm:pt-36 lg:pb-24 lg:pt-44">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">

      {# Sidebar - Table of Contents, CTA, Topics, Author bio #}
      <aside class="order-2 lg:order-2 lg:col-span-4">
        <div class="lg:sticky lg:top-24 space-y-4">
          <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-subtle">
            <p class="mb-4 font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ ui.onThisPage | safe }}</p>
            <nav class="space-y-2.5 text-[14px] leading-snug text-navy-600" id="toc">
              {# TOC will be generated by JS if needed #}
            </nav>
          </div>

          {# CTA — dark navy card, matches homepage-v2's platform-teaser surface #}
          <div class="relative overflow-hidden rounded-2xl bg-navy-950 p-6 text-white" style="box-shadow: 0 30px 50px -25px rgba(15, 23, 42, 0.45);">
            <div class="relative z-10">
              <p class="mb-2 font-medium">{{ ui.needAi | safe }}</p>
              <p class="mb-5 text-[14px] leading-relaxed text-white/60">{{ ui.discuss | safe }}</p>
              <a href="/schedule-a-call/" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-4 py-2.5 font-mono text-[12px] uppercase tracking-wider text-white transition-colors hover:bg-[#5a9100]">
                {{ ui.scheduleCall | safe }}
              </a>
            </div>
          </div>

          {# Tags #}
          {% if tags and tags.length > 1 %}
          <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-subtle">
            <p class="mb-3 font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ ui.topics | safe }}</p>
            <div class="flex flex-wrap gap-2">
              {% for tag in tags %}
              {% if tag != "blog" %}
              <span class="inline-flex items-center rounded-full border border-navy-100 bg-white px-3 py-1 text-[13px] text-navy-600">
                {{ tag }}
              </span>
              {% endif %}
              {% endfor %}
            </div>
          </div>
          {% endif %}

          {# Author Bio — a wordmark avatar (avatarFit: contain, e.g. the
             Zunkiree Labs Team logo) is far wider than it is tall, so it
             gets its own row above the text instead of sitting side-by-side
             with it (side-by-side squeezed the bio text into a sliver of
             the sidebar column). Headshot avatars keep the row layout. #}
          <div class="rounded-2xl border border-navy-100 bg-white p-6 shadow-subtle">
            {% if author.avatar and author.avatarFit == 'contain' %}
            <img
              src="{{ author.avatar }}"
              alt="{{ author.name }}"
              class="mb-4 h-8 w-auto max-w-[160px] object-contain"
              loading="lazy"
            />
            <div>
              <p class="mb-1 font-medium text-[#111827]">{{ author.name }}</p>
              <p class="mb-3 text-[13px] text-navy-400">{{ author.role }}</p>
              <p class="text-[14px] leading-relaxed text-navy-600">{{ author.bio }}</p>
            </div>
            {% else %}
            <div class="flex items-start gap-4">
              {% if author.avatar %}
              <img
                src="{{ author.avatar }}"
                alt="{{ author.name }}"
                class="h-16 w-16 flex-shrink-0 rounded-full object-cover"
                loading="lazy"
              />
              {% endif %}
              <div>
                <p class="mb-1 font-medium text-[#111827]">{{ author.name }}</p>
                <p class="mb-3 text-[13px] text-navy-400">{{ author.role }}</p>
                <p class="text-[14px] leading-relaxed text-navy-600">{{ author.bio }}</p>
              </div>
            </div>
            {% endif %}
          </div>
        </div>
      </aside>

      {# Main Content #}
      <div class="order-1 lg:col-span-8">
        {# Breadcrumb #}
        <nav class="mb-6 flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400" aria-label="{{ ui.breadcrumb | safe }}">
          <a href="{{ ui.homeUrl }}" class="transition-colors hover:text-[#76B900]">{{ ui.home | safe }}</a>
          <span aria-hidden="true">/</span>
          <a href="{{ ui.blogUrl }}" class="transition-colors hover:text-[#76B900]">{{ ui.blog | safe }}</a>
          <span aria-hidden="true">/</span>
          <span class="truncate text-navy-500">{{ title | truncate(40) }}</span>
        </nav>

        {# Cover + Title overlay — the headline sits directly on the cover
           (Kore.ai cover-image treatment). A post with a featuredImage uses it
           (Insights posts use Pexels photos); every other post gets the blog's
           own gradient cover: dark base, two blurred colour blobs and film
           grain, the same recipe as the per-post gradient SVGs in
           /assets/images/blog/. The palette is picked from the slug so each post
           differs but stays stable between builds. #}
        {% set gradientPalettes = [
          { base: '#333f4b', mid: '#4e5752', a: '#887343', b: '#395f65' },
          { base: '#2f3d47', mid: '#4a5a55', a: '#3f7a6e', b: '#2d5a7a' },
          { base: '#2c3646', mid: '#515a5e', a: '#7a6a8f', b: '#3a6f78' },
          { base: '#34404a', mid: '#4f5a52', a: '#5f7f55', b: '#8a6a4a' },
          { base: '#2a3a44', mid: '#4a5660', a: '#4a6f8f', b: '#7a5f7f' },
          { base: '#312f45', mid: '#51505f', a: '#6a5a8f', b: '#3f6f7a' }
        ] %}
        {% set pal = gradientPalettes[((page.fileSlug | length) + (title | length)) % 6] %}
        <div class="relative mb-8 aspect-[2/1] w-full overflow-hidden rounded-2xl border border-navy-100 shadow-card">
          {% if featuredImage %}
          <img
            src="{{ featuredImage }}"
            alt="{{ featuredImageAlt | default(title) }}"
            class="h-full w-full object-cover"
            fetchpriority="high"
            decoding="async"
          />
          {% else %}
          <svg class="h-full w-full" viewBox="0 0 1376 768" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Abstract gradient background" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="hg-base" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="{{ pal.base }}"/><stop offset="0.7" stop-color="{{ pal.base }}"/><stop offset="1" stop-color="{{ pal.mid }}" stop-opacity="0.6"/></linearGradient>
              <filter id="hg-blur" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="100"/></filter>
              <filter id="hg-grain" x="0" y="0" width="100%" height="100%"><feTurbulence type="fractalNoise" baseFrequency="0.62" numOctaves="2" seed="{{ (title | length) % 11 + 1 }}" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/><feComponentTransfer><feFuncR type="linear" slope="2.4" intercept="-0.65"/><feFuncG type="linear" slope="2.4" intercept="-0.65"/><feFuncB type="linear" slope="2.4" intercept="-0.65"/></feComponentTransfer></filter>
            </defs>
            <rect width="1376" height="768" fill="url(#hg-base)"/>
            <ellipse cx="278" cy="472" rx="389" ry="169" fill="{{ pal.a }}" filter="url(#hg-blur)"/>
            <ellipse cx="1053" cy="509" rx="361" ry="169" fill="{{ pal.b }}" filter="url(#hg-blur)"/>
            <rect width="1376" height="768" filter="url(#hg-grain)" style="mix-blend-mode:overlay"/>
          </svg>
          {% endif %}
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/25 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 lg:p-10">
            {% if category %}
            <span class="mb-4 inline-flex items-center rounded-full bg-[#76B900]/20 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-[#c3f562] backdrop-blur-sm">
              {{ category }}
            </span>
            {% endif %}
            {% if pillar %}
            <span class="mb-4 ml-2 inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur-sm">
              {{ pillar | pillarLabel(lang) }}
            </span>
            {% endif %}
            <h1 class="max-w-3xl text-[26px] font-semibold leading-[1.15] tracking-tight text-white sm:text-[34px] lg:text-[40px]">
              {{ title }}
            </h1>
            {% if readTime %}
            <span class="mt-3 block text-[13px] text-white/70">{{ readTime }} {{ ui.minRead | safe }}</span>
            {% endif %}
          </div>
        </div>

        {# Description #}
        {% if description %}
        <p class="mb-8 text-[16px] leading-relaxed text-navy-500 sm:text-[18px]">
          {{ description }}
        </p>
        {% endif %}

        {# Author + Date #}
        <div class="mb-10 flex items-center gap-4 border-t border-navy-100 pt-6">
          {% if author.avatar %}
          {% if author.avatarFit == 'contain' %}
          <img
            src="{{ author.avatar }}"
            alt="{{ author.name }}"
            class="h-12 w-auto max-w-[120px] flex-shrink-0 object-contain"
            loading="lazy"
          />
          {% else %}
          <img
            src="{{ author.avatar }}"
            alt="{{ author.name }}"
            class="h-12 w-12 rounded-full object-cover"
            loading="lazy"
          />
          {% endif %}
          {% endif %}
          <div>
            <p class="font-medium text-[#111827]">{{ author.name }}</p>
            <p class="text-[13px] text-navy-400">
              <time datetime="{{ date | date('%Y-%m-%d') }}">{% if uiLocale == 'en' %}{{ date | date('%B %d, %Y') }}{% else %}{{ date | localDate(uiLocale) }}{% endif %}</time>
              {% if lastUpdated %}
              <span class="mx-2">&middot;</span>
              {{ ui.updated | safe }} <time datetime="{{ lastUpdated | date('%Y-%m-%d') }}">{% if uiLocale == 'en' %}{{ lastUpdated | date('%B %d, %Y') }}{% else %}{{ lastUpdated | localDate(uiLocale) }}{% endif %}</time>
              {% endif %}
            </p>
          </div>
        </div>

        <div class="prose prose-lg max-w-none
          prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-[#111827]
          prose-h2:text-[24px] prose-h2:md:text-[28px] prose-h2:mt-14 prose-h2:mb-6 prose-h2:scroll-mt-28
          prose-h3:text-[19px] prose-h3:md:text-[22px] prose-h3:mt-10 prose-h3:mb-4 prose-h3:scroll-mt-28
          prose-h4:text-[16px] prose-h4:md:text-[18px] prose-h4:mt-8 prose-h4:mb-3
          prose-p:leading-relaxed prose-p:text-navy-600
          prose-a:text-[#5a9100] prose-a:font-medium prose-a:no-underline hover:prose-a:underline
          prose-strong:font-semibold prose-strong:text-[#111827]
          prose-ul:my-6 prose-li:my-2 prose-li:text-navy-600 prose-li:marker:text-[#76B900]
          prose-ol:my-6 prose-ol:marker:text-navy-400 prose-ol:marker:font-medium
          prose-img:rounded-2xl prose-img:border prose-img:border-navy-100 prose-img:shadow-card
          prose-hr:border-navy-100 prose-hr:my-12
          prose-blockquote:rounded-xl prose-blockquote:border-l-4 prose-blockquote:border-l-[#76B900] prose-blockquote:bg-sky-50/60 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-navy-700
          prose-table:overflow-hidden
          prose-thead:bg-navy-50/60
          prose-th:font-mono prose-th:text-[11px] prose-th:uppercase prose-th:tracking-wider prose-th:text-navy-500 prose-th:font-semibold
          prose-td:text-navy-600 prose-td:align-top
          prose-code:rounded prose-code:bg-navy-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-[0.9em] prose-code:text-navy-700 prose-code:before:content-none prose-code:after:content-none
        ">
          <style>
            /* Posts generated from Sept 24 on wrap their body in
               <div class="container-custom py-12 md:py-20">. Inside the article
               column that wrapper only adds side padding and a tall top gap, so the
               text sits narrower and lower than the March 30 posts, which have no
               wrapper. Neutralise it here so every post renders the same way. */
            .prose .container-custom { max-width: none; margin: 0; padding: 0; }

            /* Table shell to match the card system — prose-table utilities can't
               reach border/radius on the <table> element itself. */
            .prose table { border: 1px solid #e3eaec; border-radius: 1rem; border-spacing: 0; }
            .prose thead th:first-child { border-top-left-radius: 1rem; }
            .prose thead th:last-child { border-top-right-radius: 1rem; }
            .prose th, .prose td { padding: 0.85rem 1.25rem; border-bottom: 1px solid #e3eaec; }
            .prose tr:last-child td { border-bottom: none; }

            /* Action Center's expand-content generator wraps its section in
               its own py-12/md:py-20 padding, authored for a plain page body
               — not for landing inside .prose, which already gives every h2
               inside it a generous 3.5rem top margin (prose-h2:mt-14 above).
               The two stack, producing the large empty gap reported around
               these generated sections. Neutralized here, once, for every
               post that carries this marker, rather than hand-edited in each
               post's own markdown. */
            .prose section.py-12 {
              padding: 1.5rem !important;
              margin-top: 2rem;
              margin-bottom: 2rem;
              background: #f9fafb;
              border: 1px solid #e5e7eb;
              border-radius: 0.75rem;
              box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);
            }
            .prose section.py-12 table { background: #fff; }

            /* Action Center's Q&A/FAQ generators wrap their output in
               bg-gray-50 rounded-lg with no border, which reads as
               indistinguishable from the page background at this bg-gray-50
               shade. Adds a visible border/shadow so it reads as a real card,
               without touching the generators' own markup. */
            .prose .bg-gray-50.rounded-lg {
              border: 1px solid #e5e7eb;
              box-shadow: 0 1px 2px 0 rgba(15, 23, 42, 0.04);
            }
          </style>
          {{ content | safe }}
        </div>
      </div>

    </div>
  </div>
</article>

{# =====================================================
   RELATED POSTS (if available)
   ===================================================== #}
{# Insights end with more Insights (newest first); other locales relate within their own language; regular posts relate by topic across the blog (Insights excluded) #}
{% if uiLocale != "en" %}
  {% set relatedPosts = collections['blog-' + (uiLocale | lower)] | relatedByTopic(page, 3) %}
  {% set relatedHeading = ui.moreFromBlog %}
{% elif category == "Insights" %}
  {% set relatedPosts = collections.insights | reverse | rejectattr("url", "equalto", page.url) | head(3) %}
  {% set relatedHeading = "More Insights" %}
{% else %}
  {% set relatedPosts = collections.articles | relatedByTopic(page, 3) %}
  {% set relatedHeading = "More from the blog" %}
{% endif %}
{% if relatedPosts.length > 0 %}
<section class="border-t border-navy-100 bg-warm-off-white py-16 md:py-24">
  <div class="mx-auto max-w-[1000px] px-4 sm:px-6 lg:px-8">
    <h2 class="mb-8 text-[24px] font-semibold tracking-tight text-[#111827] md:text-[28px]">{{ relatedHeading | safe }}</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {% for post in relatedPosts %}
      <a href="{{ post.url }}" class="group block overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-subtle transition-shadow duration-300 hover:shadow-card-hover">
        {% if post.data.featuredImage %}
        <div class="aspect-[16/9] overflow-hidden">
          <img
            src="{{ post.data.featuredImage }}"
            alt="{{ post.data.title }}"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        {% endif %}
        <div class="p-6">
          <p class="mb-2 text-[13px] text-navy-400">{% if uiLocale == 'en' %}{{ post.date | date('%B %d, %Y') }}{% else %}{{ post.date | localDate(uiLocale) }}{% endif %}</p>
          <h3 class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-[#5a9100]">
            {{ post.data.title }}
          </h3>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "partials/footer-v2.njk" %}
