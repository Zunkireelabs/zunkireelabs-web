<!DOCTYPE html>
<html lang="{{ lang or 'en' }}" class="scroll-smooth">
<head>
  <!-- Google Analytics — gated by cookie consent, see the consent-loader script below -->
  {% if env.GA_MEASUREMENT_ID %}
  <script type="text/plain" data-cookie-consent="analytics" async data-src="https://www.googletagmanager.com/gtag/js?id={{ env.GA_MEASUREMENT_ID }}"></script>
  <script type="text/plain" data-cookie-consent="analytics">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ env.GA_MEASUREMENT_ID }}');
  </script>
  {% endif %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.meta.title }}</title>
  <meta name="description" content="{{ description or site.description }}">

  <!-- Stylesheet loaded as a blocking <link> (not a JS-import side-effect) so it paints
       before the JS module graph resolves — avoids a flash of unstyled content on cold reload -->
  <link rel="stylesheet" href="/assets/css/main.css">

  <!-- Robots: noindex for non-production environments, and for utility pages that set `noindex: true` in front matter -->
  {% if env.ELEVENTY_ENV != 'production' or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {% endif %}

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title or site.meta.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ ogImageUrl or (site.url + site.meta.ogImage) }}">
  {% if not ogImageUrl %}<meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  {% if ogType == 'article' %}
  <meta property="article:published_time" content="{{ date | date('%Y-%m-%d') }}">
  <meta property="article:modified_time" content="{{ lastUpdated | default(date) | date('%Y-%m-%d') }}">
  {% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
  {% endif %}
  <meta property="og:locale" content="{{ ogLocale or 'en_US' }}">
  <meta property="og:site_name" content="{{ site.name }}">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.meta.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ ogImageUrl or (site.url + site.meta.ogImage) }}">

  <link rel="alternate" type="application/atom+xml" title="Zunkiree Labs Insights" href="{{ site.url }}/feed.xml">

  <!-- Canonical URL -->
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ site.url }}{{ canonicalUrl }}">
  {% else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% endif %}
  {% if category == "Insights" and layout == "blog-post.njk" and page.url.startsWith("/blog/") %}
  <link rel="alternate" type="text/markdown" href="{{ site.url }}{{ page.url }}index.md">
  {% endif %}

  <!-- Hreflang alternates (language/region variants of this page) -->
  {% set pageAlternates = hreflangAlternates or (translationKey | hreflangFor(collections.all)) %}{% if pageAlternates | length %}
  {% for alt in pageAlternates %}
  <link rel="alternate" hreflang="{{ alt.lang }}" href="{{ site.url }}{{ alt.url }}">
  {% endfor %}
  {% endif %}

  <!-- Preload Critical Resources for LCP -->
  {% if heroImage %}
  <link rel="preload" href="{{ heroImage }}" as="image" fetchpriority="high">
  {% endif %}

  <!-- DNS Prefetch for third-party domains -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://zunkiree-search-v1.vercel.app">
  <link rel="dns-prefetch" href="https://api.zunkireelabs.com">

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Schema.org Structured Data - Organization (Global) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "{{ site.url }}/#organization",
    "name": "Zunkiree Labs",
    "alternateName": ["Zunkireelabs", "ZunkireeLabs"],
    "knowsAbout": ["AI development", "RAG pipelines", "AI agents", "AI orchestration", "Enterprise software", "Answer engine optimization"],
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/assets/images/zunkireelabs-logo-light.png",
    "description": "AI infrastructure company building custom AI systems, RAG pipelines, AI agents, and enterprise software. Headquartered in Kathmandu, Nepal.",
    "foundingDate": "2018",
    "founder": {
      "@type": "Person",
      "name": "Sadin Shrestha"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kathmandu",
      "addressRegion": "Bagmati Province",
      "addressCountry": "NP"
    },
    "sameAs": [
      "{{ site.social.linkedin }}",
      "{{ site.social.clutch }}",
      "{{ site.social.goodfirms }}",
      "{{ site.social.techbehemoths }}",
      "{{ site.social.startupsnepal }}",
      "{{ site.social.instagram }}"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": "{{ site.email }}",
      "telephone": "{{ site.phone }}",
      "url": "{{ site.url }}/contact/"
    }
  }
  </script>

  <!-- Schema.org - WebSite (Homepage only) -->
  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Zunkiree Labs",
    "url": "{{ site.url }}/",
    "description": "{{ site.description }}"
  }
  </script>
  <!-- Schema.org - LocalBusiness (Homepage only) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#localbusiness",
    "name": "Zunkiree Labs",
    "description": "AI development company in Kathmandu, Nepal. Custom AI systems, AI agents, RAG pipelines, and enterprise software.",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "logo": "{{ site.url }}/assets/images/zunkireelabs-logo-light.png",
    "image": "{{ site.url }}/assets/images/og-image.svg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Kathmandu",
      "addressRegion": "Bagmati",
      "addressCountry": "NP"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "18:00"
      }
    ],
    "priceRange": "$$"
  }
  </script>
  {% endif %}

  <!-- Schema.org - Page-specific (Product/Service/Article) -->
  {% if schemaType == "product" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "{{ title }}",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web",
    "description": "{{ description }}",
    "url": "{{ site.url }}{{ page.url }}",
    "provider": {
      "@type": "Organization",
      "name": "Zunkiree Labs",
      "url": "{{ site.url }}"
    }
  }
  </script>
  {% endif %}

  {% if schemaType == "industry" and industryId %}
  <script type="application/ld+json">
  {{ {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": site.url + page.url + "#service",
    "name": title,
    "description": description,
    "url": site.url + page.url,
    "serviceType": "AI software for " + (industryId | replace("-", " ")),
    "provider": { "@type": "Organization", "@id": site.url + "/#organization", "name": "Zunkiree Labs", "url": site.url }
  } | dump | safe }}
  </script>
  {% endif %}

  {% if schemaType == "service" and serviceId %}
  {%- set serviceData = servicesDetails[serviceId] -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "{{ site.url }}{{ page.url }}#service",
    "name": "{{ serviceData.title }}",
    "description": "{{ serviceData.description }}",
    "url": "{{ site.url }}{{ page.url }}",
    "serviceType": "{{ serviceData.category }}",
    "provider": {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "name": "Zunkiree Labs",
      "url": "{{ site.url }}"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Nepal"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "{{ serviceData.title }} Services",
      "itemListElement": [
        {% for useCase in serviceData.useCases %}
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "{{ useCase.title }}",
            "description": "{{ useCase.description }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  }
  </script>
  {% endif %}

  {# FAQPage schema - supports explicit faqs, service page FAQs, and product page FAQs #}
  {%- set productFaqData = (platformProducts | find("id", productId)) if productId else null -%}
  {%- set pageFaqs = faqs if faqs else (servicesDetails[serviceId].faq if serviceId and servicesDetails[serviceId] else (productFaqData.faq if productFaqData else null)) -%}
  {# hasServiceFaqs: location x service pages that render their own FAQ block (and FAQPage schema) in the layout #}
  {# A page body that already carries its own FAQPage JSON-LD (SEOAI:QACONTENT) wins; emitting a second one makes duplicate FAQPage entities #}
  {%- set bodyHasFaqSchema = ('"FAQPage"' in (content | string)) -%}
  {% if pageFaqs and not hasServiceFaqs and not bodyHasFaqSchema %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in pageFaqs %}
      {
        "@type": "Question",
        "name": "{{ faq.question }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.answer }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <!-- Schema.org - BreadcrumbList (all pages except homepage) -->
  {% if page.url != "/" %}
  {%- set urlParts = page.url | split("/") -%}
  {%- set breadcrumbPath = "" -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ site.url }}/"
      }{% if urlParts.length > 0 %},{% endif %}
      {% for part in urlParts %}
      {%- set breadcrumbPath = breadcrumbPath + "/" + part -%}
      {
        "@type": "ListItem",
        "position": {{ loop.index + 1 }},
        "name": "{{ part | titleCase }}"{% if not loop.last %},
        "item": "{{ site.url }}{{ breadcrumbPath }}/"{% endif %}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicon.png">

  <!-- Fonts - DM Sans + DM Mono (non-render-blocking) -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap"></noscript>

  {% if bodyClass == "v2-inter" %}
  <!-- Fonts - Inter (Homepage V2 preview only, cloned from kore.ai's actual typeface — MASTER_DESIGN_SPEC.md §5) -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"></noscript>

  <!-- Fonts - Instrument Serif italic (Orca dark hero only, 2026-09-25) — the
       "Meet { X }" tagline / subhead accent, matching the Kore.ai Artemis hero's
       editorial-italic treatment. Loaded alongside Inter since only v2-inter
       pages use font-editorial. -->
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"></noscript>
  {% endif %}

  <!-- SEOAI:HEAD:START -->
<!-- SEOAI:ANALYTICSSCRIPTGA4:START --><script type="text/plain" data-cookie-consent="analytics" async data-src="https://www.googletagmanager.com/gtag/js?id=G-2ZQRDS0D14"></script>
<script type="text/plain" data-cookie-consent="analytics">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-2ZQRDS0D14');
</script><!-- SEOAI:ANALYTICSSCRIPTGA4:END -->
