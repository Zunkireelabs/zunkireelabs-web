<script>
  // Cookie-consent loader — activates the analytics/marketing scripts above
  // (shipped inert as type="text/plain" data-cookie-consent="...") once
  // consent is known. Default: granted (matches this site's existing
  // behavior prior to the /cookie-preferences/ page existing) until a
  // visitor explicitly opts out there. See /cookie-preferences/ for the
  // control UI and the localStorage key this reads.
  (function () {
    var consent = { analytics: true, marketing: true };
    try {
      var raw = localStorage.getItem('zunkiree-cookie-consent');
      if (raw) {
        var stored = JSON.parse(raw);
        if (stored && typeof stored === 'object') {
          if (stored.analytics === false) consent.analytics = false;
          if (stored.marketing === false) consent.marketing = false;
        }
      }
    } catch (e) {}

    document.querySelectorAll('script[data-cookie-consent]').forEach(function (inert) {
      var category = inert.getAttribute('data-cookie-consent');
      if (!consent[category]) return;
      var active = document.createElement('script');
      Array.prototype.forEach.call(inert.attributes, function (attr) {
        if (attr.name === 'type') return;
        if (attr.name === 'data-src') { active.src = attr.value; return; }
        if (attr.name === 'data-cookie-consent') return;
        active.setAttribute(attr.name, attr.value);
      });
      active.text = inert.text;
      inert.parentNode.replaceChild(active, inert);
    });
  })();
</script><!-- SEOAI:HEAD:END -->
</head>
<body class="font-sans antialiased overflow-x-clip {% if hideChrome %}bg-white{% endif %} {{ bodyClass }}">

  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  {% if not hideChrome %}
  {% include "partials/header.njk" %}
  {% endif %}

  <main id="main-content">
    {{ content | safe }}
  </main>

  {% if not hideChrome %}
  {% include "partials/footer.njk" %}
  {% endif %}

  <!-- Main JS + CSS (bundled via Vite) -->
  <script type="module" src="/assets/js/main.js"></script>

  {# Zunkiree Search Widget - lazy loaded for performance #}
  <script>
    // Lazy load widget after page is interactive
    var widgetLoaded = false;
    function loadZunkireeWidget() {
      if (widgetLoaded) return;
      widgetLoaded = true;
      var script = document.createElement('script');
      script.src = 'https://zunkiree-search-v1.vercel.app/zunkiree-widget.iife.js';
      script.dataset.siteId = 'zunkireelabs';
      script.dataset.apiUrl = 'https://api.zunkireelabs.com';
      document.body.appendChild(script);
    }

    // Load on idle, user interaction, or after 3 seconds (whichever comes first)
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadZunkireeWidget, { timeout: 3000 });
    } else {
      setTimeout(loadZunkireeWidget, 2000);
    }

    // Also load immediately if user tries to open it
    function openZunkireeWidget() {
      loadZunkireeWidget();
      // Wait for widget to load, then click
      var checkInterval = setInterval(function() {
        var fab = document.querySelector('.zk-fab');
        if (fab) {
          clearInterval(checkInterval);
          fab.click();
        }
      }, 100);
      // Stop checking after 5 seconds
      setTimeout(function() { clearInterval(checkInterval); }, 5000);
    }
  </script>

</body>
</html>
