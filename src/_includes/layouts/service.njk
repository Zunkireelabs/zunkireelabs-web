---
layout: base.njk
schemaType: service
hideChrome: true
bodyClass: "v2-inter"
---

{# =====================================================
   SERVICE PAGE LAYOUT — DESIGNED ALONGSIDE HOMEPAGE V2
   Reskinned onto the Homepage V2 design system (navbar-v2 +
   footer-v2 chrome, Inter typeface, flat pure-white page
   background, navy/green tokens, glass + soft-elevation card
   shells). Homepage V2 is the single source of truth for the
   design system and component recipes.

   This is the SHARED Services template driving /services/*.
   Content, headings, copy hierarchy, SEO structure, metadata,
   links, images, and all data bindings are preserved verbatim
   from the prior layout (data via servicesDetails.json,
   servicesStories, services.json, locations). Only the visual
   layer changes — every page using this layout inherits the
   V2 design automatically.
   ===================================================== #}

{% set service = servicesDetails[serviceId] %}
{% set stories = servicesStories %}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

<div class="relative bg-white overflow-x-clip">

{# =====================================================
   SECTION 1 — SERVICE HERO (light, centered)
   Breadcrumb + H1 + description + dual mono CTA.
   Top padding clears the fixed 72px V2 navbar.
   ===================================================== #}
<section class="relative overflow-hidden px-4 pt-32 pb-6 text-center sm:px-6 sm:pt-36 sm:pb-8 lg:px-8 lg:pt-44" aria-labelledby="service-hero-heading">
  {# Background Image - positioned right, full bleed (AI-managed field, optional) #}
  {% if service.heroImage %}
  <div class="absolute inset-0 hidden lg:block overflow-hidden">
    <img
      src="{{ service.heroImage }}"
      alt="{{ service.heroAlt or '' }}"
      class="absolute right-0 top-0 h-full w-full object-cover object-right opacity-10"
      aria-hidden="true"
    />
  </div>
  {% endif %}
  <div class="relative z-10 mx-auto max-w-[56rem]" data-reveal-stagger>

    <nav class="mb-8 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors duration-200 hover:text-[#5a9100]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/services/" class="transition-colors duration-200 hover:text-[#5a9100]">Services</a>
      <span aria-hidden="true">/</span>
      <span class="truncate text-navy-500">{{ service.title }}</span>
    </nav>

    <h1 id="service-hero-heading" class="mx-auto max-w-3xl text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[44px] lg:text-[54px]">
      {{ service.tagline }}
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-body-lg leading-relaxed text-[#6B7280]">
      {{ service.description }}
    </p>

    <div class="mx-auto mt-8 flex max-w-[320px] flex-col items-center justify-center gap-2 sm:max-w-none sm:flex-row sm:gap-3">
      <a
        href="{{ service.cta.primaryButton.url }}"
        class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:w-auto"
        data-track="cta"
        data-cta-id="service-hero-primary"
      >
        {{ service.cta.primaryButton.text }}
        <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
      </a>
      <a
        href="{{ service.cta.secondaryButton.url }}"
        class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-navy-300 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:w-auto"
        data-track="cta"
        data-cta-id="service-hero-secondary"
      >
        {{ service.cta.secondaryButton.text }}
        <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

{# =====================================================
   SECTION 2 — CLIENT MARQUEE (trust bar)
   Content (7 client logos + heading) preserved verbatim. Reuses
   the #logo-marquee / #logo-marquee-track ids so main.js's
   initLogoMarquee() auto-scroll + drag interaction keeps working.
   Light treatment matches homepage-v2's client marquee.
   ===================================================== #}
{% set clientLogos = [
  { "logo": "/images/clients/mach24orbital.webp", "name": "Mach24 Orbitals" },
  { "logo": "/images/clients/corecloud365.svg", "name": "Corecloud365" },
  { "logo": "/images/clients/rapid-investment.svg", "name": "Rapid Investment" },
  { "logo": "/images/clients/khushbu-nirman-sewa.webp", "name": "Khushbu Nirman Sewa" },
  { "logo": "/images/clients/cms-group.webp", "name": "CMS Group" },
  { "logo": "/images/clients/admizz.webp", "name": "Admizz" },
  { "logo": "/images/clients/khems-cleaning.webp", "name": "Khems Cleaning" }
] %}
<section class="px-4 pb-10 pt-2 sm:px-6 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-8 text-center font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
      Teams already building with Zunkiree.
    </h2>

    <div id="logo-marquee" class="relative w-full overflow-hidden py-2">
      <div class="pointer-events-none absolute left-0 top-0 bottom-0 z-10 w-16 bg-gradient-to-r from-white to-transparent" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-0 top-0 bottom-0 z-10 w-16 bg-gradient-to-l from-white to-transparent" aria-hidden="true"></div>

      <div id="logo-marquee-track" class="flex items-center gap-10 animate-marquee-scroll">
        {% for client in clientLogos %}
        <div class="h-6 w-40 flex items-center justify-center flex-shrink-0">
          <img src="{{ client.logo }}" alt="{{ client.name }}" class="max-h-full max-w-full object-contain grayscale opacity-60 mix-blend-multiply select-none" loading="lazy" width="128" height="32" />
        </div>
        {% endfor %}
        {% for client in clientLogos %}
        <div class="h-6 w-40 flex items-center justify-center flex-shrink-0">
          <img src="{{ client.logo }}" alt="{{ client.name }}" class="max-h-full max-w-full object-contain grayscale opacity-60 mix-blend-multiply select-none" loading="lazy" width="128" height="32" />
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# =====================================================
   SECTION 3 — OVERVIEW / VALUE PROP
   Two-column soft-elevation card (white + hairline + shadow),
   same structure as homepage-v2's block cards.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="service-definition-heading">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-6 rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10 lg:p-12">
      <div data-reveal>
        <h2 id="service-definition-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
          {{ service.definition.heading }}
        </h2>
      </div>
      <div class="lg:pt-1" data-reveal>
        <p class="text-[16px] leading-relaxed text-[#6B7280] sm:text-[17px]">
          {{ service.definition.content }}
        </p>
      </div>
    </div>
  </div>
</section>

{# =====================================================
   SECTION 4 — BENEFITS
   "Benefits" label (left) + benefit card grid (right). Icons
   recolored from legacy sage gradient to the #76B900 brand
   accent. Content preserved verbatim.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-5xl">

    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Benefits</span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        What changes
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3" data-reveal-stagger>
          {% for benefit in service.benefits %}
          <div class="rounded-2xl border border-navy-100/50 bg-white p-6 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-md">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-[#76B900]/10 ring-1 ring-inset ring-[#76B900]/20">
              {% if benefit.icon == "workflow" %}
              <svg class="h-7 w-7" fill="none" stroke="#76B900" viewBox="0 0 24 24" stroke-width="1.5">
                <circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><circle cx="12" cy="12" r="2"/>
                <path d="M6 8v2M6 14v2M18 8v2M18 14v2M8 6h2M14 6h2M8 18h2M14 18h2M8 12h2M14 12h2M12 8v2M12 14v2"/>
              </svg>
              {% elif benefit.icon == "speed" %}
              <svg class="h-7 w-7" fill="none" stroke="#76B900" viewBox="0 0 24 24" stroke-width="1.5">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/><circle cx="12" cy="12" r="3"/>
              </svg>
              {% elif benefit.icon == "integrate" %}
              <svg class="h-7 w-7" fill="none" stroke="#76B900" viewBox="0 0 24 24" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"/><circle cx="4" cy="8" r="2"/><circle cx="20" cy="8" r="2"/><circle cx="4" cy="16" r="2"/><circle cx="20" cy="16" r="2"/>
                <path d="M6 8h3M15 8h3M6 16h3M15 16h3"/>
              </svg>
              {% else %}
              <svg class="h-7 w-7" fill="none" stroke="#76B900" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/>
              </svg>
              {% endif %}
            </div>
            <h3 class="mb-2 text-[17px] font-semibold leading-snug text-[#111827]">{{ benefit.title }}</h3>
            <p class="text-[14px] leading-relaxed text-[#6B7280]">{{ benefit.description }}</p>
          </div>
          {% endfor %}
        </div>

  </div>
</section>

{# =====================================================
   SECTION 5 — USE CASES
   V2 platform-style tabs (navy/white inactive, solid #76B900
   active). Alpine tab logic + copy preserved verbatim.
   ===================================================== #}
<section
  class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20"
  aria-labelledby="service-usecases-heading"
  x-data="{ activeTab: '{{ service.useCases[0].id }}' }"
>
  <div class="mx-auto max-w-5xl">

    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Use cases</span>
      <h2 id="service-usecases-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">Industries in action</h2>
    </div>

    <div class="mb-12 flex justify-center overflow-x-auto" data-reveal>
      <div role="tablist" aria-label="Use cases" class="inline-flex flex-shrink-0 items-center gap-1 rounded-xl border border-navy-100/60 bg-white p-1 shadow-subtle">
        {% for useCase in service.useCases %}
        <button
          type="button"
          role="tab"
          :aria-selected="activeTab === '{{ useCase.id }}' ? 'true' : 'false'"
          @click="activeTab = '{{ useCase.id }}'"
          class="flex flex-shrink-0 items-center gap-2 whitespace-nowrap rounded-lg px-4 py-2.5 font-mono text-[11px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          :class="activeTab === '{{ useCase.id }}' ? 'bg-[#76B900] text-white' : 'text-navy-700 hover:bg-navy-50 hover:text-navy-900'"
        >
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full transition-colors duration-200" :class="activeTab === '{{ useCase.id }}' ? 'bg-white' : 'bg-navy-300'" aria-hidden="true"></span>
          {{ useCase.title }}
        </button>
        {% endfor %}
      </div>
    </div>

    {% for useCase in service.useCases %}
    <div
      x-show="activeTab === '{{ useCase.id }}'"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      role="tabpanel"
      class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12 lg:items-center"
    >
      <div class="pt-4">
        <h3 class="mb-4 text-[22px] font-semibold leading-[1.3] tracking-tight text-[#111827] sm:text-[26px]">
          {{ useCase.headline }}
        </h3>
        <p class="mb-6 text-[16px] leading-relaxed text-[#6B7280]">
          {{ useCase.description }}
        </p>
        <a href="/contact/" class="inline-flex items-center gap-2 font-medium text-[#5a9100] transition-all duration-200 hover:gap-3 hover:text-[#4d7a00]">
          Learn more
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

      <div class="relative">
        <div class="aspect-[16/9] overflow-hidden rounded-2xl border border-navy-100/60 bg-white shadow-subtle">
          {% if useCase.image %}
          <img
            src="{{ useCase.image }}"
            alt="{{ useCase.headline }}"
            class="h-full w-full object-cover"
            loading="lazy"
          >
          {% else %}
          <div class="flex h-full w-full items-center justify-center rounded-2xl bg-navy-50">
            <span class="text-[14px] text-navy-400">{{ useCase.headline }}</span>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}

  </div>
</section>

{# =====================================================
   SECTION 6 — CLIENT STORIES
   Story data (filtered by service.clients) + slider kept
   verbatim, reskinned to light cards.
   ===================================================== #}
{% set clientStories = [] %}
{% for clientId in service.clients %}
  {% for story in stories %}
    {% if story.id == clientId %}
      {% set clientStories = clientStories.concat([story]) %}
    {% endif %}
  {% endfor %}
{% endfor %}

{% if clientStories.length > 0 %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="service-stories-heading" x-data="{ currentSlide: 0, totalSlides: {{ clientStories.length }} }" data-reveal>
  <div class="mx-auto max-w-5xl">

    <div class="mb-12 flex flex-col lg:flex-row lg:items-end lg:justify-between">
      <div class="mb-6 lg:mb-0">
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Case Studies</span>
        <h2 id="service-stories-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
          See how our clients build with Zunkiree
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        {% for story in clientStories %}
        <img
          src="{{ story.logo }}"
          alt="{{ story.name }}"
          class="h-6 w-auto object-contain grayscale opacity-40 transition-all duration-200 hover:grayscale-0 hover:opacity-90 md:h-8"
          loading="lazy"
        >
        {% endfor %}
      </div>
    </div>

    <div class="relative overflow-hidden">
      <div
        class="flex transition-transform duration-500 ease-out"
        :style="'transform: translateX(-' + (currentSlide * 100) + '%)'"
      >
        {% for story in clientStories %}
        <div class="w-full flex-shrink-0 px-2">
          <div class="overflow-hidden rounded-2xl border border-navy-100/60 bg-white shadow-card">
            <div class="grid grid-cols-1 lg:grid-cols-2">
              <div class="flex flex-col justify-center bg-sky-50/60 p-7 sm:p-10 lg:p-12">
                <span class="mb-5 inline-flex w-fit items-center gap-2 rounded-full bg-[#76B900]/10 px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-[#5a9100]">
                  <img src="{{ story.logo }}" alt="{{ story.name }}" class="h-4 w-auto object-contain" loading="lazy" />
                  {{ story.name }}
                </span>
                <h3 class="text-[26px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[30px] lg:text-[34px]">
                  {{ story.headline }}
                </h3>
                <p class="mt-4 max-w-md text-[16px] leading-relaxed text-[#6B7280]">
                  {{ story.description }}
                </p>
                <div class="mt-6 flex items-baseline gap-2">
                  <span class="text-3xl font-semibold text-[#76B900] md:text-4xl">{{ story.stat }}</span>
                  <span class="text-[14px] text-[#6B7280]">{{ story.statLabel }}</span>
                </div>
                {% if story.ctaUrl %}
                <div class="mt-8 w-fit rounded-lg border border-dashed border-navy-200 p-2">
                  <a
                    href="{{ story.ctaUrl }}"
                    class="inline-flex items-center gap-2 rounded-md bg-navy-900 px-5 py-3 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-navy-800"
                  >
                    {{ story.ctaText }}
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  </a>
                </div>
                {% endif %}
              </div>

              <div class="relative min-h-[280px] lg:min-h-full">
                <img
                  src="{{ story.image }}"
                  alt="{{ story.name }} project"
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    {% if clientStories.length > 1 %}
    <div class="mt-8 flex items-center justify-center gap-6">
      <button
        @click="currentSlide = currentSlide > 0 ? currentSlide - 1 : totalSlides - 1"
        class="flex h-12 w-12 items-center justify-center rounded-lg border border-navy-200 text-navy-600 transition-colors hover:border-navy-300 hover:text-navy-900"
        aria-label="Previous stories"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <div class="flex items-center gap-2">
        <template x-for="i in totalSlides" :key="i">
          <button
            @click="currentSlide = i - 1"
            class="h-2.5 w-2.5 rounded-full transition-colors"
            :class="currentSlide === (i - 1) ? 'bg-[#76B900]' : 'bg-navy-200 hover:bg-navy-300'"
            :aria-label="'Go to slide ' + i"
          ></button>
        </template>
      </div>

      <button
        @click="currentSlide = currentSlide < totalSlides - 1 ? currentSlide + 1 : 0"
        class="flex h-12 w-12 items-center justify-center rounded-lg border border-navy-200 text-navy-600 transition-colors hover:border-navy-300 hover:text-navy-900"
        aria-label="Next stories"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
    {% endif %}

  </div>
</section>
{% endif %}

{# =====================================================
   SECTION 7 — TECH STACK
   "Technology" label (left) + responsive tech card grid (right).
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="service-tech-heading">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">

      <div class="lg:col-span-3" data-reveal>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Technology</span>
        <h2 id="service-tech-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
          Technologies we use
        </h2>
      </div>

      <div class="lg:col-span-9">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4" data-reveal-stagger>
          {% for tech in service.techStack %}
          <div class="rounded-xl border border-navy-100/50 bg-white p-5 text-center shadow-subtle transition-all duration-200 hover:border-[#76B900]/30 hover:shadow-md">
            {% if tech.logo %}
            <div class="mb-3 flex h-10 items-center justify-center">
              <img
                src="{{ tech.logo }}"
                alt="{{ tech.name }}"
                class="max-h-8 max-w-[100px] object-contain opacity-70"
                loading="lazy"
              />
            </div>
            {% endif %}
            <p class="mb-0.5 text-sm font-medium text-[#111827]">{{ tech.name }}</p>
            <p class="mb-0.5 text-xs text-[#5a9100]">{{ tech.category }}</p>
            <p class="text-[11px] text-[#6B7280]">{{ tech.description }}</p>
          </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>

{# =====================================================
   SECTION 8 — RELATED SERVICES
   Card grid. Related-service content/links/icons preserved.
   ===================================================== #}
{% if service.relatedServices.length > 0 %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="service-related-heading">
  <div class="mx-auto max-w-5xl">

    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Related Services</span>
      <h2 id="service-related-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        You might also need
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-3" data-reveal-stagger>
      {% for relatedId in service.relatedServices %}
      {% set related = services | find("id", relatedId) %}
      {% if related %}
      <a href="{{ related.url }}" class="group flex flex-col justify-between rounded-2xl border border-navy-100/60 bg-white p-6 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-md">
        <div class="mb-6">
          <h3 class="mb-2 text-[16px] font-semibold leading-snug text-[#111827] transition-colors group-hover:text-[#5a9100]">{{ related.title }}</h3>
          <p class="text-[13px] leading-relaxed text-[#6B7280]">{{ related.description }}</p>
        </div>
        <div class="flex items-end justify-between">
          <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#76B900]/10 ring-1 ring-inset ring-[#76B900]/20">
            {% if related.icon == "ai" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            {% elif related.icon == "chat" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
            {% elif related.icon == "data" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
            </svg>
            {% elif related.icon == "code" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
            {% elif related.icon == "cloud" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
            </svg>
            {% elif related.icon == "globe" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
            </svg>
            {% elif related.icon == "mobile" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
            {% elif related.icon == "search" %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            {% else %}
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke="#76B900" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            {% endif %}
          </span>
          <svg class="h-5 w-5 text-navy-300 transition-colors group-hover:text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>

  </div>
</section>
{% endif %}

{# =====================================================
   SECTION 9 — SERVICE LOCATIONS
   Location pills. Links /locations/{id}/{serviceId}/ preserved.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" data-reveal>
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Service Locations</span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        {{ service.title }} available in
      </h2>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      {% for location in locations %}
      <a href="/locations/{{ location.id }}/{{ serviceId }}/" class="inline-flex items-center rounded-lg border border-navy-100 bg-white px-5 py-2.5 text-[14px] font-medium text-navy-600 shadow-subtle transition-colors hover:border-[#76B900]/40 hover:text-navy-900">
        <svg class="mr-2 h-4 w-4 text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {{ location.name }}
        <svg class="ml-2 h-4 w-4 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   SECTION 10 — CLOSING CTA + FAQ
   CTA banner reuses homepage-v2's navy-950 rounded-[28px]
   gradient-bloom recipe; FAQ is an accordion (Expand/Collapse
   All) in the V2 divide-by-navy-100 style.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-5xl">

    {# CTA Banner — dual CTA, homepage-v2 closing-banner recipe #}
    <div class="relative mb-16 overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16" style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);" data-reveal>
      <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true" style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"></div>

      <span class="relative z-10 mb-4 block font-mono text-[11px] uppercase tracking-wider text-white/50">Get Started</span>
      <h2 class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        Take the next step
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-white/60">
        {{ service.cta.description }}
      </p>
      <div class="relative z-10 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="{{ service.cta.primaryButton.url }}"
          class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:w-auto"
          data-track="cta"
          data-cta-id="service-bottom-primary"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          {{ service.cta.primaryButton.text }}
        </a>
        <a
          href="{{ service.cta.secondaryButton.url }}"
          class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/20 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:border-white/40 hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:w-auto"
          data-track="cta"
          data-cta-id="service-bottom-secondary"
        >
          {{ service.cta.secondaryButton.text }}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>

    {# FAQ Accordion #}
    <div x-data="{ activeIndex: null, expandAll: false }">
      <div class="mb-6 flex items-center justify-between border-b border-navy-100 pb-4">
        <h3 class="text-[20px] font-semibold leading-[1.3] tracking-tight text-[#111827] sm:text-[24px]">Get to know {{ service.title }}</h3>
        <button
          @click="expandAll = !expandAll; activeIndex = expandAll ? 'all' : null"
          class="whitespace-nowrap pl-4 text-sm font-medium text-[#5a9100] transition-colors hover:text-[#4d7a00]"
        >
          <span x-text="expandAll ? 'Collapse All' : 'Expand All'"></span>
        </button>
      </div>

      <div class="divide-y divide-navy-100">
        {% for faq in service.faq %}
        <div class="py-5">
          <button
            @click="activeIndex = (activeIndex === {{ loop.index }} && !expandAll) ? null : {{ loop.index }}"
            class="group flex w-full items-center justify-between gap-4 text-left"
            :aria-expanded="activeIndex === {{ loop.index }} || expandAll ? 'true' : 'false'"
            aria-controls="service-faq-answer-{{ loop.index }}"
          >
            <span class="pr-4 text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
              {{ faq.question }}
            </span>
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} || expandAll ? 'rotate-45' : ''">
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            id="service-faq-answer-{{ loop.index }}"
            x-show="activeIndex === {{ loop.index }} || expandAll"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-4 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">
              {{ faq.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

</div>

{% include "partials/footer-v2.njk" %}