---
layout: base.njk
bodyClass: "v2-inter"
hideChrome: true
---

{#
  DIRECTION CONTRACT
  THESIS: A glossary entry reads like a page from the platform's own reference
  manual, not a bolted-on wiki stub — homepage-v2's navy/green/glass system
  carries a single-term definition the same way it carries the GaaS guide.
  OWN-WORLD: #F8FAFC/white ground, #76B900 the one accent (definition callout,
  category badges, CTA), navy-950 dark card for the quick-reference sidebar,
  mono uppercase eyebrows/breadcrumbs, rounded-2xl glass-tinted cards
  (border-white/60, gradient sky-100/60 via sky-50/25 to white/50,
  backdrop-blur-sm, shadow-subtle), Inter at homepage-v2 weights.
  STORY: visitor lands on the term, reads the AEO short definition in the
  green callout immediately, gets the full explanation, then either follows a
  related term, jumps to the related product, or converts on the CTA.
  FIRST VIEWPORT: breadcrumb + category badge + H1 + green definition callout,
  same restrained Read-mode hero rhythm as /resources/what-is-gaas/.
  FORM: extend the established homepage-v2/what-is-gaas world onto the
  glossary term surface — content and data bindings inherited unchanged, no
  new visual system invented.
#}

{# Get current term data #}
{% set currentTerm = null %}
{% for t in glossary %}
  {% if t.id == termId %}
    {% set currentTerm = t %}
  {% endif %}
{% endfor %}

{# Get related service #}
{% set relatedService = null %}
{% for svc in services %}
  {% if svc.id == currentTerm.relatedService %}
    {% set relatedService = svc %}
  {% endif %}
{% endfor %}

{# =====================================================
   DEFINED TERM SCHEMA
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  "@id": "{{ site.url }}/glossary/{{ currentTerm.id }}/#term",
  "name": "{{ currentTerm.term }}",
  "description": "{{ currentTerm.definition | replace('"', '\\"') }}",
  "inDefinedTermSet": {
    "@type": "DefinedTermSet",
    "name": "Zunkiree Labs AI Glossary",
    "url": "{{ site.url }}/glossary/"
  }
}
</script>

{# FAQPage schema for the definition #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is {{ currentTerm.term }}?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ currentTerm.definition | replace('"', '\\"') }}"
      }
    }
  ]
}
</script>

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   HERO — term definition, homepage-v2 Read-mode hero rhythm
   ===================================================== #}
<section class="bg-white px-4 pb-10 pt-28 md:px-6 md:pb-14 md:pt-36">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">

      {# Main Content Column #}
      <div class="lg:col-span-8">
        {# Breadcrumb #}
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400">
            <li><a href="/" class="transition-colors hover:text-[#5a9100]">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/glossary/" class="transition-colors hover:text-[#5a9100]">Glossary</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-navy-900">{{ currentTerm.term }}</li>
          </ol>
        </nav>

        {# Category badge #}
        <span
          class="mb-5 inline-flex items-center gap-2 rounded-full border border-sky-300/40 bg-sky-100/60 px-3 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-sky-700"
          data-reveal
        >
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-500" aria-hidden="true"></span>
          {{ currentTerm.category }}
        </span>

        {# H1 #}
        <h1
          class="mb-6 text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] lg:text-[48px]"
          data-reveal
        >
          {{ currentTerm.term }}
        </h1>

        {# Short Definition — AEO featured callout, matches what-is-gaas Definition box #}
        <div class="mb-8 rounded-2xl border border-[#76B900]/20 bg-[#76B900]/[0.06] p-6" data-reveal>
          <span class="mb-3 block font-mono text-[11px] font-medium uppercase tracking-wider text-[#4a7a00]">Definition</span>
          <p class="mb-0 text-[17px] leading-relaxed text-navy-900">
            {{ currentTerm.shortDef }}
          </p>
        </div>

        {# Full Definition #}
        <div class="mb-2" data-reveal>
          <p class="leading-relaxed text-navy-400">
            {{ currentTerm.definition }}
          </p>
        </div>
      </div>

      {# Sidebar Column #}
      <aside class="lg:col-span-4">
        <div class="space-y-6 lg:sticky lg:top-24">

          {# Related Terms #}
          <div class="rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/60 via-sky-50/25 to-white/50 p-6 shadow-subtle backdrop-blur-sm" data-reveal>
            <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-wider text-navy-400">Related Terms</h3>
            <div class="space-y-4">
              {% set count = 0 %}
              {% for t in glossary %}
                {% if t.category == currentTerm.category and t.id != currentTerm.id and count < 5 %}
                  {% set count = count + 1 %}
                  {% if not loop.first %}<hr class="border-navy-100/40">{% endif %}
                  <a href="/glossary/{{ t.id }}/" class="group block">
                    <p class="font-medium leading-snug text-navy-900 transition-colors group-hover:text-[#5a9100]">
                      {{ t.term }}
                    </p>
                  </a>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          {% if relatedService %}
          {# Related Service #}
          <div class="rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/60 via-sky-50/25 to-white/50 p-6 shadow-subtle backdrop-blur-sm" data-reveal>
            <h3 class="mb-4 font-mono text-[11px] font-medium uppercase tracking-wider text-navy-400">Related Service</h3>
            <a href="/services/{{ relatedService.id }}/" class="group block">
              <p class="mb-1 font-medium leading-snug text-navy-900 transition-colors group-hover:text-[#5a9100]">
                {{ relatedService.title }}
              </p>
              <p class="text-[13px] text-navy-400">{{ relatedService.description | truncate(90) }}</p>
            </a>
          </div>
          {% endif %}

          {# CTA Card #}
          <div class="rounded-2xl border border-[#76B900]/25 bg-[#76B900]/[0.06] p-6" data-reveal>
            <h3 class="mb-3 font-medium text-[#111827]">Need help implementing {{ currentTerm.term | split('(') | first | trim }}?</h3>
            <p class="mb-5 text-[14px] text-navy-400">
              Our team can build this for your business.
            </p>
            <a
              href="/contact/"
              class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-4 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
              data-track="cta" data-cta-id="glossary-term-cta"
            >
              Get Expert Help
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
            </a>
          </div>

        </div>
      </aside>

    </div>
  </div>
</section>

{# =====================================================
   MORE TERMS — glass-card grid, same recipe as the
   /resources/ index card grid
   ===================================================== #}
<section class="bg-white px-4 pb-16 pt-6 md:px-6 md:pb-24" aria-labelledby="more-terms-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="more-terms-heading" class="mb-8 text-[24px] font-medium leading-[1.2] text-[#111827] md:text-[28px]" data-reveal>
      Explore more AI terms
    </h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6" data-reveal-stagger>
      {% set count = 0 %}
      {% for t in glossary | sort(attribute='term') %}
        {% if t.id != currentTerm.id and count < 8 %}
          {% set count = count + 1 %}
          <a href="/glossary/{{ t.id }}/" class="group block overflow-hidden rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/60 via-sky-50/25 to-white/50 p-5 shadow-subtle backdrop-blur-sm transition-shadow duration-300 hover:shadow-card-hover">
            <p class="mb-3">
              <span class="inline-flex items-center rounded-full border border-sky-300/40 bg-sky-100/60 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-sky-700">{{ t.category }}</span>
            </p>
            <h3 class="mb-4 text-[15.5px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-[#5a9100]">
              {{ t.term }}
            </h3>
            <span class="inline-flex items-center gap-1.5 text-[13px] font-medium text-sky-700 transition-all group-hover:gap-2.5">
              Read definition
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="mt-10 text-center" data-reveal>
      <a href="/glossary/" class="inline-flex items-center gap-2 font-mono text-[13px] uppercase tracking-wide text-[#4a7a00] transition-all hover:gap-3">
        View all terms
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
