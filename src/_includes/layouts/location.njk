---
layout: base.njk
---

{# =====================================================
   LOCATION PAGE LAYOUT — Website V2
   Reskin only: content, copy, headings, links, and the
   `locations`/`services` data bindings are unchanged from the
   prior version. Chrome and section styling rebuilt to match
   homepage-v2.njk / locations/index.njk exactly (same navbar-v2 +
   footer-v2 chrome, hero recipe, card recipe, closing-CTA recipe)
   per explicit "Homepage V2 is the single source of truth"
   direction — no new copy, no SEO/structure changes. hideChrome
   is now set on location-pages.njk's frontmatter so this layout
   owns its own navbar-v2/footer-v2 include, same pattern as
   locations/index.njk.
   ===================================================== #}

{% set location = null %}
{% for loc in locations %}
  {% if loc.id == locationId %}
    {% set location = loc %}
  {% endif %}
{% endfor %}

{# =====================================================
   LOCAL BUSINESS SCHEMA — unchanged
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "{{ site.url }}/locations/{{ location.id }}/#localbusiness",
  "name": "Zunkiree Labs - {{ location.name }}",
  "description": "{{ location.description }}",
  "url": "{{ site.url }}/locations/{{ location.id }}/",
  "telephone": "{{ location.phone | default(site.phone) }}",
  "email": "{{ location.email | default(site.email) }}",
  "image": "{{ site.url }}/assets/images/zunkireelabs-logo-round.svg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{ location.name }}",
    "addressRegion": "{{ location.region }}",
    "addressCountry": "{{ location.countryCode }}"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "27.7172",
    "longitude": "85.3240"
  },
  "parentOrganization": {
    "@type": "Organization",
    "@id": "{{ site.url }}/#organization"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ location.name }}"
  }
}
</script>

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   REVIEW / AGGREGATE RATING SCHEMA (AI-managed — written by the Action Center)
   Only rendered when location.reviewSchema is present; never fabricated
   here or by the generator that writes it — see server/generators/schema.js.
   ===================================================== #}
{% if location.reviewSchema %}
<script type="application/ld+json">
{{ location.reviewSchema | dump | safe }}
</script>
{% endif %}

{# =====================================================
   HERO SECTION — breadcrumb + eyebrow + h1 + intro + CTAs on
   the left (homepage-v2 heading recipe), contact/hours glass
   card on the right (locations/index.njk HQ-card treatment).
   ===================================================== #}
<section class="relative z-10 px-4 pb-12 pt-40 sm:px-6 sm:pt-44 lg:px-8 lg:pt-48" aria-labelledby="hero-heading">
  <div class="mx-auto max-w-5xl">
    <nav aria-label="Breadcrumb" class="mb-8">
      <ol class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400">
        <li><a href="/" class="transition-colors hover:text-navy-700">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/locations/" class="transition-colors hover:text-navy-700">Locations</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-navy-600">{{ location.name }}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2" data-reveal-stagger>
      {# Left: Content #}
      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
          {% if location.isHeadquarters %}Headquarters{% else %}Service Area{% endif %}
        </span>
        <h1 id="hero-heading" class="text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
          AI Development in {{ location.name }}
        </h1>
        <p class="mt-5 max-w-[540px] text-[18px] font-medium leading-relaxed text-[#6B7280] sm:text-[20px]">
          {{ location.intro }}
        </p>

        {# CTAs #}
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          >
            Contact Us
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
          </a>
          <a
            href="/services/"
            class="inline-flex items-center justify-center gap-2 rounded-md border border-navy-200 px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-navy-700 transition-colors duration-200 hover:border-navy-300 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
          >
            View Services
          </a>
        </div>

        {# About — moved up into the hero's left column to fill the
           vertical space left below the CTAs by the taller map card. #}
        {% if location.content %}
        <div class="mt-14">
          <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
            About
          </span>
          <h2 class="text-[24px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[28px]">
            About Zunkiree Labs in {{ location.name }}
          </h2>
          <div class="prose prose-lg prose-gray mt-6 max-w-none text-[#6B7280] leading-relaxed">
            {{ location.content | safe }}
          </div>
        </div>
        {% endif %}
      </div>

      {# Right: Map or Contact Card — sticky so it stays in view while
         the left column's About copy scrolls past it. #}
      <div class="rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-7 lg:sticky lg:top-28 lg:self-start">
        {% if location.mapEmbed %}
        <div class="mb-6 aspect-[4/3] w-full overflow-hidden rounded-xl">
          <iframe
            src="{{ location.mapEmbed }}"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Zunkiree Labs {{ location.name }} location"
          ></iframe>
        </div>
        {% endif %}

        <h3 class="text-[16px] font-semibold text-[#111827] mb-4">Contact Information</h3>
        <ul class="space-y-3 text-[#6B7280]">
          {% if location.address %}
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[#76B900] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-[14px] leading-relaxed">{{ location.address.city }}, {{ location.address.country }}</span>
          </li>
          {% endif %}
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[#76B900] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:{{ location.phone | default(site.phone) }}" class="text-[14px] leading-relaxed transition-colors hover:text-[#4d7a00]">
              {{ location.phone | default(site.phone) }}
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-[#76B900] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:{{ location.email | default(site.email) }}" class="text-[14px] leading-relaxed transition-colors hover:text-[#4d7a00]">
              {{ location.email | default(site.email) }}
            </a>
          </li>
        </ul>

        {% if location.hours %}
        <div class="mt-6 pt-6 border-t border-navy-100/60">
          <h4 class="text-[13px] font-semibold text-[#111827] mb-3">Business Hours</h4>
          <ul class="space-y-1.5 text-[13px] text-[#6B7280]">
            <li class="flex justify-between">
              <span>Monday - Friday</span>
              <span class="font-medium text-navy-700">{{ location.hours.weekdays }}</span>
            </li>
            <li class="flex justify-between">
              <span>Saturday</span>
              <span class="font-medium text-navy-700">{{ location.hours.saturday }}</span>
            </li>
            <li class="flex justify-between">
              <span>Sunday</span>
              <span class="font-medium text-navy-700">{{ location.hours.sunday }}</span>
            </li>
          </ul>
        </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{# =====================================================
   SERVICES GRID
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        What We Offer
      </span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        Services in {{ location.name }}
      </h2>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {% for service in services %}
      <a
        href="/locations/{{ location.id }}/{{ service.id }}/"
        class="group flex flex-col rounded-2xl border border-navy-100/60 bg-white p-6 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-card-hover"
      >
        <h3 class="text-[16px] font-semibold leading-snug text-[#111827] transition-colors group-hover:text-[#4d7a00] mb-2">
          {{ service.title }}
        </h3>
        <p class="text-[13px] leading-relaxed text-[#6B7280] line-clamp-2 flex-grow">
          {{ service.description }}
        </p>
        <div class="mt-4 flex items-center gap-2 font-mono text-[12px] uppercase tracking-wide text-navy-900 transition-colors group-hover:text-[#4d7a00]">
          Learn more
          <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   FAQs
   ===================================================== #}
{% if location.faqs and location.faqs.length > 0 %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Support
      </span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="mx-auto mt-8 max-w-3xl" x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for faq in location.faqs %}
        <div class="py-3">
          <button
            @click="activeIndex = activeIndex === {{ loop.index }} ? null : {{ loop.index }}"
            class="group flex w-full items-center justify-between gap-4 py-2 text-left"
            :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
            aria-controls="location-faq-answer-{{ loop.index }}"
          >
            <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 pr-4">{{ faq.question }}</span>
            <span
              class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200"
              :class="{ 'rotate-45': activeIndex === {{ loop.index }} }"
            >
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            id="location-faq-answer-{{ loop.index }}"
            x-show="activeIndex === {{ loop.index }}"
            x-transition
            class="overflow-hidden pb-3 pr-10 text-[14px] leading-relaxed text-[#6B7280]"
          >
            {{ faq.answer }}
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# FAQPage Schema for location FAQs — unchanged #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in location.faqs %}
    {
      "@type": "Question",
      "name": "{{ faq.question }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ faq.answer }}"
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{# =====================================================
   NEARBY LOCATIONS — individually bordered badges, not one
   shared pill-bar wrapper (matches the fix already applied
   elsewhere on the site for this component family).
   ===================================================== #}
{% if location.nearbyCities and location.nearbyCities.length > 0 %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Nearby
      </span>
      <h2 class="text-[20px] font-semibold leading-[1.2] tracking-tight text-[#111827] mb-6">
        Also Serving
      </h2>
    </div>
    <div class="flex flex-wrap justify-center gap-3" data-reveal-stagger>
      {% for cityId in location.nearbyCities %}
        {% for loc in locations %}
          {% if loc.id == cityId %}
          <a
            href="/locations/{{ loc.id }}/"
            class="inline-flex items-center gap-2 rounded-xl border border-navy-100/60 bg-white px-4 py-2.5 text-[14px] font-medium text-navy-700 shadow-subtle transition-colors hover:border-[#76B900]/30 hover:text-[#4d7a00]"
          >
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
            {{ loc.name }}
          </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{# =====================================================
   EXPANDED CONTENT (AI-managed — written by the Action Center)
   Only rendered when location.expandedContent is present; never
   fabricated here or by the generator that writes it — see
   server/generators/expand-content.js. Already a fully rendered HTML
   block (wrapper + rows), not raw text.
   ===================================================== #}
{% if location.expandedContent %}
{{ location.expandedContent | safe }}
{% endif %}

{# =====================================================
   Q&A CONTENT (AI-managed — written by the Action Center)
   Only rendered when location.qaContentHtml is present — see
   server/generators/qa-content.js.
   ===================================================== #}
{% if location.qaContentHtml %}
{{ location.qaContentHtml | safe }}
{% endif %}

{# =====================================================
   RELATED / INTERNAL LINKS (AI-managed — written by the Action Center)
   Only rendered when location.internalLinksHtml is present — see
   server/generators/internal-links.js.
   ===================================================== #}
{% if location.internalLinksHtml %}
{{ location.internalLinksHtml | safe }}
{% endif %}

{# =====================================================
   CTA — dark navy + green-glow shell (COMPONENT_LIBRARY.md
   §2.6 dark variant), matches locations/index.njk exactly.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="location-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <h2 id="location-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        Ready to build with AI in {{ location.name }}?
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        Let's discuss how AI can transform your business.
      </p>
      <div class="relative z-10 mt-8 flex justify-center">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          Schedule a Discovery Call
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
