{#
  Canonical FAQ accordion — the single FAQ presentation used across the site.

  The markup is the accordion already in use on about.njk and the location
  pages; this only lifts it into one place so every FAQ renders identically
  instead of each page carrying its own copy. Those copies are why /team/
  rendered a plain <details> list and several pages rendered an accordion in
  generic blue rather than the brand colour.

  The visible list and the FAQPage schema below both loop the SAME faqItems,
  so what a visitor reads and what search engines are told cannot disagree.
  Question and answer text goes through | dump, so a question containing a
  quote can never produce invalid JSON-LD.

  Usage:
    {% set faqItems = teamFaq %}
    {% set faqHeading = "About our team" %}
    {% include "components/faq-accordion.njk" %}
#}
{% if faqItems and faqItems.length %}
<section class="py-12 md:py-20">
  <div class="container-custom">
    <div x-data="{ activeIndex: null, expandAll: false }">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl md:text-3xl font-medium text-gray-900">{{ faqHeading or "Frequently asked questions" }}</h3>
        <button
          @click="expandAll = !expandAll; activeIndex = expandAll ? 'all' : null"
          class="text-sm text-gray-500 hover:text-gray-900 transition-colors"
        >
          <span x-text="expandAll ? 'Collapse All' : 'Expand All'"></span>
        </button>
      </div>

      <div class="divide-y divide-gray-200">
        {% for item in faqItems %}
        <div class="py-5">
          <button
            @click="activeIndex = (activeIndex === {{ loop.index }} && !expandAll) ? null : {{ loop.index }}"
            class="w-full flex items-center justify-between text-left group"
          >
            <span class="text-lg font-medium text-gray-900 group-hover:text-zunkiree-600 transition-colors pr-4">
              {{ item.question }}
            </span>
            <span class="flex-shrink-0 text-gray-400">
              <svg
                class="w-5 h-5 transition-transform duration-200"
                :class="{ 'rotate-45': activeIndex === {{ loop.index }} || expandAll }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            x-show="activeIndex === {{ loop.index }} || expandAll"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-4 text-gray-600 leading-relaxed">
              {{ item.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faqItems %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | dump | safe }} }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{% endif %}
