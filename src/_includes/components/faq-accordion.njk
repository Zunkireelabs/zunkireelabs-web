{#
  Canonical FAQ accordion — the single FAQ presentation used across the site.

  The markup is the accordion already in use on about.njk and the location
  pages; this only lifts it into one place so every FAQ renders identically
  instead of each page carrying its own copy. Those copies are why /team/
  rendered a plain <details> list and several pages rendered an accordion in
  generic blue rather than the brand colour.

  The visible list and the FAQPage schema below both loop the SAME faqItems,
  so what a visitor reads and what search engines are told cannot disagree.
  Question and answer text goes through | dump, so a question containing a
  quote can never produce invalid JSON-LD.

  Usage:
    {% set faqItems = teamFaq %}
    {% set faqHeading = "About our team" %}
    {% include "components/faq-accordion.njk" %}
#}
{% if faqItems and faqItems.length %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-accordion-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Support</span>
      <h2 id="faq-accordion-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">{{ faqHeading or "Frequently asked questions" }}</h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for item in faqItems %}
        <div class="py-5">
          <button
            @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
            class="group flex w-full items-center justify-between gap-4 text-left"
            :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
            aria-controls="faq-accordion-answer-{{ loop.index }}"
          >
            <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
              {{ item.question }}
            </span>
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            id="faq-accordion-answer-{{ loop.index }}"
            x-show="activeIndex === {{ loop.index }}"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">
              {{ item.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faqItems %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | dump | safe }} }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{% endif %}
