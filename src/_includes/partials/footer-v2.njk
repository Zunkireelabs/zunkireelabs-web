{# =====================================================
   FOOTER — WEBSITE V2 (homepage-v2 scope only)
   Direct structural copy of the Kore.ai mega-footer: pale gradient
   band → logo + tagline + language/region row → dashed divider →
   link columns + a "Let's work together" CTA card on the right →
   social row + G2-style trust badge → legal bottom bar.

   Scoped to Website V2 only — does not replace/modify the existing
   shared `footer.njk` used by other (non-v2) pages. Links reuse the
   same real destinations as footer.njk (About/Careers/Blog/Contact,
   legal pages, LinkedIn, Instagram) rather than inventing new ones.
   ===================================================== #}
{% set fUi = i18n[lang or "en"] or i18n["en"] %}{% set fEn = (lang or "en") == "en" %}
<footer class="relative z-10 border-t border-navy-100 bg-white">
  <div class="mx-auto max-w-[1280px] px-4 pt-12 pb-10 sm:px-6 sm:pt-16 lg:px-8">

    <!-- Logo + tagline + language -->
    <div class="mb-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <div class="flex flex-wrap items-center gap-4">
        <img src="/assets/images/zunkireelabs-logo-footer.png" alt="Zunkiree Labs" class="h-6 w-auto" width="225" height="24" />
        <span class="hidden h-5 w-px bg-navy-200 sm:block" aria-hidden="true"></span>
        <span class="text-[15px] font-medium text-navy-600">{{ fUi.fTagline | safe }}</span>
      </div>
      <span class="inline-flex w-full items-center justify-center gap-1.5 rounded-md border border-navy-200 px-3 py-1.5 font-mono text-[12px] uppercase tracking-wider text-navy-500 sm:w-auto sm:justify-start">
        Nepal &middot; Global
      </span>
    </div>

    <div class="mb-12 border-t border-dashed border-navy-200"></div>

    <!-- Link columns + CTA card -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 {% if fEn %} lg:grid-cols-[repeat(4,1fr)_22rem] {% else %} lg:grid-cols-[1fr_22rem] {% endif %}">

{% if fEn %}      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ fUi.fIndustries | safe }}</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/industries/education/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fEducation | safe }}</a></li>
          <li><a href="/industries/agencies/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fAgencies | safe }}</a></li>
          <li><a href="/industries/healthcare/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fHealthcare | safe }}</a></li>
          <li><a href="/industries/real-estate/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fRealEstate | safe }}</a></li>
        </ul>
      </div>
{% endif %}
      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ fUi.fCompany | safe }}</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="{{ fUi.aboutUrl }}" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fAbout | safe }}</a></li>
          {% if fEn %}          <li><a href="/careers/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fCareers | safe }}</a></li>
          {% endif %}          <li><a href="{{ fUi.blogUrl }}" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fBlog | safe }}</a></li>
          {% if not fEn %}<li><a href="{{ fUi.servicesUrl }}" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fServices | safe }}</a></li>{% endif %}
          <li><a href="{{ fUi.contactUrl }}" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fContact | safe }}</a></li>
        </ul>
      </div>

{% if fEn %}      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ fUi.fResources | safe }}</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="{{ fUi.servicesUrl }}" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fServices | safe }}</a></li>
          <li><a href="/team/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fTeam | safe }}</a></li>
          <li><a href="/pricing/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fPricing | safe }}</a></li>
        </ul>
      </div>
{% endif %}
{% if fEn %}      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">{{ fUi.fLocations | safe }}</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/locations/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ fUi.fAllLocations | safe }}</a></li>
          {% for location in locations %}
          <li><a href="/locations/{{ location.id }}/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ location.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
{% endif %}
      <!-- "Let's work together" CTA card — full-width below the link groups until
           lg, where it drops into the wide 22rem column beside them (sm:grid-cols-2
           alone would squeeze it into a half-width slot, too narrow for its copy/button). -->
      <div class="col-span-2 rounded-2xl border border-dashed border-navy-300 p-6 lg:col-span-1">
        <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-[#76B900] text-white" aria-hidden="true">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.163-3.02-.462L3 20l1.5-3.75C3.55 15.06 3 13.57 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </span>
        <h3 class="mb-1.5 text-lg font-medium text-navy-900">{{ fUi.fCtaTitle | safe }}</h3>
        <p class="mb-5 text-[14px] leading-relaxed text-navy-500">
          {{ fUi.fCtaBody | safe }}
        </p>
        <a
          href="{{ fUi.contactUrl }}"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 text-[13px] font-medium uppercase tracking-wider text-white transition-colors hover:bg-[#5a9100]"
        >
          {{ fUi.fCtaButton | safe }}
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-navy-100 pt-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <!-- Social — -m-2/p-2 expands the tap target to ~36px without inflating the visible icon -->
        <div class="flex items-center gap-2 text-navy-400 sm:gap-3">
          <a href="https://www.linkedin.com/company/zunkireelabs" class="-m-2 rounded-md p-2 transition-colors hover:text-navy-900" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="{{ site.social.clutch }}" class="-m-2 rounded-md p-2 text-[13px] font-medium transition-colors hover:text-navy-900" aria-label="Zunkiree Labs on Clutch" target="_blank" rel="noopener noreferrer">Clutch</a>
          <a href="{{ site.social.goodfirms }}" class="-m-2 rounded-md p-2 text-[13px] font-medium transition-colors hover:text-navy-900" aria-label="Zunkiree Labs on GoodFirms" target="_blank" rel="noopener noreferrer">GoodFirms</a>
          <a href="{{ site.social.techbehemoths }}" class="-m-2 rounded-md p-2 text-[13px] font-medium transition-colors hover:text-navy-900" aria-label="Zunkiree Labs on TechBehemoths" target="_blank" rel="noopener noreferrer">TechBehemoths</a>
          <a href="{{ site.social.startupsnepal }}" class="-m-2 rounded-md p-2 text-[13px] font-medium transition-colors hover:text-navy-900" aria-label="Zunkiree Labs on Startups Nepal" target="_blank" rel="noopener noreferrer">Startups Nepal</a>
          <a href="{{ site.social.instagram }}" class="-m-2 rounded-md p-2 transition-colors hover:text-navy-900" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>

        <!-- Legal row -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] text-navy-400">
          <a href="/privacy/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">{{ fUi.fPrivacy | safe }}</a>
          <a href="/terms/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">{{ fUi.fTerms | safe }}</a>
          <a href="/cookie-policy/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">{{ fUi.fCookie | safe }}</a>
          {% include "partials/language-switcher.njk" %}
        </div>
      </div>

      <p class="mt-6 text-[13px] text-navy-400">
        &copy; {% year %} {{ site.name }}. {{ fUi.fRights | safe }}
      </p>
    </div>
  </div>
</footer>
