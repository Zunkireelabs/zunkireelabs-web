{# =====================================================
   FOOTER — WEBSITE V2 (homepage-v2 scope only)
   Direct structural copy of the Kore.ai mega-footer: pale gradient
   band → logo + tagline + language/region row → dashed divider →
   link columns + a "Let's work together" CTA card on the right →
   social row + G2-style trust badge → legal bottom bar.

   Scoped to Website V2 only — does not replace/modify the existing
   shared `footer.njk` used by other (non-v2) pages. Links reuse the
   same real destinations as footer.njk (About/Careers/Blog/Contact,
   legal pages, LinkedIn) rather than inventing new ones.
   ===================================================== #}
<footer class="relative z-10 border-t border-navy-100 bg-white">
  <div class="mx-auto max-w-[1280px] px-4 pt-12 pb-10 sm:px-6 sm:pt-16 lg:px-8">

    <!-- Logo + tagline + language -->
    <div class="mb-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
      <div class="flex flex-wrap items-center gap-4">
        <img src="/assets/images/zunkireelabs-logo-footer.png" alt="Zunkiree Labs" class="h-6 w-auto" width="200" height="24" />
        <span class="hidden h-5 w-px bg-navy-200 sm:block" aria-hidden="true"></span>
        <span class="text-[15px] font-medium text-navy-600">The AI infrastructure company.</span>
      </div>
      <span class="inline-flex w-full items-center justify-center gap-1.5 rounded-md border border-navy-200 px-3 py-1.5 font-mono text-[12px] uppercase tracking-wider text-navy-500 sm:w-auto sm:justify-start">
        Nepal &middot; Global
      </span>
    </div>

    <div class="mb-12 border-t border-dashed border-navy-200"></div>

    <!-- Link columns + CTA card -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 lg:grid-cols-[repeat(4,1fr)_22rem]">

      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">Industries</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/industries/education/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Education</a></li>
          <li><a href="/industries/agencies/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Agencies</a></li>
          <li><a href="/industries/healthcare/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Healthcare</a></li>
          <li><a href="/industries/real-estate/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Real Estate</a></li>
        </ul>
      </div>

      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">Company</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/about/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">About Us</a></li>
          <li><a href="/careers/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Careers</a></li>
          <li><a href="/blog/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Blog</a></li>
          <li><a href="/contact/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Contact</a></li>
        </ul>
      </div>

      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">Resources</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/services/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Services</a></li>
          <li><a href="/team/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Team</a></li>
          <li><a href="/pricing/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">Pricing</a></li>
        </ul>
      </div>

      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-navy-400">Locations</span>
        <ul class="space-y-1 sm:space-y-3">
          <li><a href="/locations/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">All Locations</a></li>
          {% for location in locations %}
          <li><a href="/locations/{{ location.id }}/" class="inline-block py-2 text-[15px] text-navy-600 transition-colors hover:text-navy-900 sm:py-0">{{ location.name }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <!-- "Let's work together" CTA card — full-width below the link groups until
           lg, where it drops into the wide 22rem column beside them (sm:grid-cols-2
           alone would squeeze it into a half-width slot, too narrow for its copy/button). -->
      <div class="col-span-2 rounded-2xl border border-dashed border-navy-300 p-6 lg:col-span-1">
        <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-[#76B900] text-white" aria-hidden="true">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8-1.06 0-2.077-.163-3.02-.462L3 20l1.5-3.75C3.55 15.06 3 13.57 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </span>
        <h3 class="mb-1.5 text-lg font-medium text-navy-900">Let's work together</h3>
        <p class="mb-5 text-[14px] leading-relaxed text-navy-500">
          Get answers and a customized plan for your industry.
        </p>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-5 py-2.5 text-[13px] font-medium uppercase tracking-wider text-white transition-colors hover:bg-[#5a9100]"
        >
          Talk to us
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-navy-100 pt-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <!-- Social — -m-2/p-2 expands the tap target to ~36px without inflating the visible icon -->
        <div class="flex items-center gap-2 text-navy-400 sm:gap-3">
          <a href="https://www.linkedin.com/company/zunkireelabs/" class="-m-2 rounded-md p-2 transition-colors hover:text-navy-900" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="#" class="-m-2 rounded-md p-2 transition-colors hover:text-navy-900" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="-m-2 rounded-md p-2 transition-colors hover:text-navy-900" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>

        <!-- Legal row -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] text-navy-400">
          <a href="/privacy/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">Privacy Policy</a>
          <a href="/terms/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">Terms of Service</a>
          <a href="/cookie-policy/" class="-my-1.5 py-1.5 transition-colors hover:text-navy-700">Cookie Policy</a>
        </div>
      </div>

      <p class="mt-6 text-[13px] text-navy-400">
        &copy; {% year %} {{ site.name }}. All trademarks are property of their respective owners.
      </p>
    </div>
  </div>
</footer>
