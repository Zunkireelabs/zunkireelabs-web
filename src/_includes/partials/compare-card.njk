{# Compact link card to a comparison page. Input: ccard = { href, title, blurb }. #}
{% if ccard and ccard.href %}
<section class="px-4 py-8 sm:px-6 lg:px-8" aria-label="Comparison">
  <div class="mx-auto max-w-5xl">
    <a href="{{ ccard.href }}" class="group flex flex-col gap-5 rounded-2xl border border-navy-100 bg-white p-6 shadow-subtle transition-shadow duration-300 hover:shadow-card-hover sm:flex-row sm:items-center sm:justify-between sm:p-7">
      <div class="max-w-2xl">
        <span class="mb-2 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Compare</span>
        <h3 class="text-[20px] font-medium leading-snug tracking-tight text-[#111827] transition-colors group-hover:text-[#5a9100]">{{ ccard.title }}</h3>
        <p class="mt-1.5 text-[14px] leading-relaxed text-[#6B7280]">{{ ccard.blurb }}</p>
      </div>
      <span class="inline-flex flex-shrink-0 items-center justify-center gap-1.5 self-start rounded-md border border-navy-300 px-4 py-2.5 font-mono text-[11px] uppercase tracking-wide text-navy-900 transition-colors duration-200 group-hover:border-navy-400 group-hover:bg-navy-50 sm:self-center">
        See the comparison
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </span>
    </a>
  </div>
</section>
{% endif %}
