{# Related Insights cards, shared by industry, location and product layouts.
   Inputs (set before including): riPosts = [{ href, title }], riDark = true on dark hero pages.
   Cover, topic and read time are looked up from the blog collection by URL; a post without
   a cover gets a gradient band so every card keeps the same shape.
   Header: label + heading on the left, "View all" on the right. Below the cards: a button to /solutions/. #}
{% if riPosts and riPosts.length %}
<section class="px-4 pb-12 pt-4 sm:px-6 sm:pb-16 lg:px-8" aria-labelledby="related-insights-heading">
  <div class="mx-auto max-w-5xl">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 sm:mb-8">
      <div>
        <span class="mb-2 block font-mono text-[11px] uppercase tracking-wider {{ 'text-white/50' if riDark else 'text-[#9CA3AF]' }}">Insights</span>
        <h2 id="related-insights-heading" class="text-[24px] font-semibold leading-[1.2] tracking-tight sm:text-[28px] {{ 'text-white' if riDark else 'text-[#111827]' }}">Related Insights</h2>
      </div>
      <a href="/blog/insights/" class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider transition-all hover:gap-2.5 {{ 'text-white/70 hover:text-white' if riDark else 'text-navy-600 hover:text-navy-900' }}">
        View all insights
        <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6"/></svg>
      </a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 md:grid-cols-3">
      {% for item in riPosts %}
      {% set match = collections.blog | find("url", item.href) %}
      <a href="{{ item.href }}" class="group flex flex-col overflow-hidden rounded-xl border transition-all duration-300 {{ 'border-white/10 bg-white/[0.04] hover:bg-white/[0.07]' if riDark else 'border-navy-100 bg-white shadow-subtle hover:shadow-card-hover' }}">
        {% set riCover = match.data.featuredImage if match else "" %}
        <div class="aspect-[5/2] overflow-hidden {{ 'bg-white/5' if riDark else 'bg-gradient-to-br from-navy-900 to-navy-950' }}">
          {% if riCover and (("://" in riCover) or (riCover | fileExists)) %}
          <img src="{{ riCover }}" alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" width="480" height="192" />
          {% endif %}
        </div>
        <div class="flex flex-1 flex-col p-4">
          {% if match and (match.data.pillar or match.data.readTime) %}
          <span class="mb-2 block font-mono text-[10px] uppercase tracking-wider {{ 'text-white/50' if riDark else 'text-[#9CA3AF]' }}">
            {% if match.data.pillar %}{{ match.data.pillar | pillarLabel(lang) }}{% endif %}{% if match.data.pillar and match.data.readTime %} · {% endif %}{% if match.data.readTime %}{{ match.data.readTime }} min read{% endif %}
          </span>
          {% endif %}
          <h3 class="line-clamp-3 text-[15px] font-medium leading-snug transition-colors {{ 'text-white group-hover:text-[#9BD43A]' if riDark else 'text-[#111827] group-hover:text-[#5a9100]' }}">{{ item.title }}</h3>
        </div>
      </a>
      {% endfor %}
    </div>
    <div class="mt-8 flex justify-center">
      <a href="/solutions/" class="inline-flex items-center justify-center gap-1.5 rounded-md border px-5 py-3 font-mono text-[11px] uppercase tracking-wide transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] {{ 'border-white/25 text-white hover:border-white/40 hover:bg-white/10' if riDark else 'border-navy-300 text-navy-900 hover:border-navy-400 hover:bg-navy-50' }}">
        See our solutions
        <span class="h-1 w-1 flex-shrink-0 rounded-full {{ 'bg-white/50' if riDark else 'bg-navy-400' }}" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>
{% endif %}
