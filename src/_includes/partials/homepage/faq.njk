{#
  Homepage FAQ block. Shared structure across all locales. This is its own
  partial (not the site's shared components/faq-accordion.njk) because the
  homepage version has a bg-gray-50 section background and SEOAI:FAQ markers
  that the generic accordion doesn't — swapping it in would silently change
  the homepage's visual background, which is out of scope here.

  Question/answer text goes through | dump for the JSON-LD, same safety
  pattern as components/faq-accordion.njk, so a quote in the text can never
  break the schema.

  Expects: faqHeading, expandAllText, collapseAllText,
  faqItems — array of {question, answer}
#}
<!-- SEOAI:FAQ:START --><section class="py-12 md:py-20 bg-gray-50">
  <div class="container-custom">
    <div x-data="{ activeIndex: null, expandAll: false }">
      <div class="flex items-center justify-between mb-6">
        <h3 class="text-2xl md:text-3xl font-medium text-gray-900">{{ faqHeading }}</h3>
        <button
          @click="expandAll = !expandAll; activeIndex = expandAll ? 'all' : null"
          class="text-sm text-gray-500 hover:text-gray-900 transition-colors"
        >
          <span x-text="expandAll ? '{{ collapseAllText }}' : '{{ expandAllText }}'"></span>
        </button>
      </div>

      <div class="divide-y divide-gray-200">
        {% for item in faqItems %}
        <div class="py-5">
          <button
            @click="activeIndex = (activeIndex === {{ loop.index }} && !expandAll) ? null : {{ loop.index }}"
            class="w-full flex items-center justify-between text-left group"
          >
            <span class="text-lg font-medium text-gray-900 group-hover:text-zunkiree-600 transition-colors pr-4">
              {{ item.question }}
            </span>
            <span class="flex-shrink-0 text-gray-400">
              <svg
                class="w-5 h-5 transition-transform duration-200"
                :class="{ 'rotate-45': activeIndex === {{ loop.index }} || expandAll }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            x-show="activeIndex === {{ loop.index }} || expandAll"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-4 text-gray-600 leading-relaxed">
              {{ item.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section><script type="application/ld+json">{"@type":"FAQPage","@context":"https://schema.org","mainEntity":[{%- for item in faqItems %}{"name":{{ item.question | dump | safe }},"@type":"Question","acceptedAnswer":{"text":{{ item.answer | dump | safe }},"@type":"Answer"}}{{ "," if not loop.last }}{%- endfor %}]}</script><!-- SEOAI:FAQ:END -->
