{#
  Homepage social-proof bar (logo marquee + stats). Shared structure across
  all locales. Client logos/names are never translated.

  Expects: trustText, statProductsLabel, statIndustriesLabel, statServicesLabel
#}
<section class="py-6 bg-white border-y border-gray-200">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">

      {# Left: Trust Text with Divider #}
      <div class="lg:col-span-2 flex items-center gap-4">
        <p class="text-xs text-gray-500 uppercase tracking-wider leading-relaxed">{{ trustText }}</p>
        <div class="hidden lg:block w-px h-8 bg-gray-200"></div>
      </div>

      {# Middle: Logo Marquee #}
      <div class="lg:col-span-7 relative overflow-hidden">
        <div class="marquee-fade-light">
          <div class="flex items-center gap-10 animate-marquee-scroll">
            {% set marqueeClients = [
              {"logo": "/images/clients/chayce-properties.webp", "name": "Chayce Properties"},
              {"logo": "/images/clients/mach24orbital.webp", "name": "Mach24orbital"},
              {"logo": "/images/clients/corecloud365.svg", "name": "Corecloud365"},
              {"logo": "/images/clients/rapid-investment.svg", "name": "Rapid Investment"},
              {"logo": "/images/clients/khushbu-nirman-sewa.webp", "name": "Khushbu Nirman Sewa"},
              {"logo": "/images/clients/prime-tiles.webp", "name": "Prime Tiles"},
              {"logo": "/images/clients/cms-group.webp", "name": "CMS Group"},
              {"logo": "/images/clients/admizz.webp", "name": "Admizz"},
              {"logo": "/images/clients/khems-cleaning.webp", "name": "Khems Cleaning"}
            ] %}
            {% for c in marqueeClients %}
            <div class="w-32 h-8 flex items-center justify-center flex-shrink-0">
              <img src="{{ c.logo }}" alt="{{ c.name }}" class="max-w-full max-h-full object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300" loading="lazy" width="128" height="32" />
            </div>
            {% endfor %}
            {# Duplicate set for seamless loop #}
            {% for c in marqueeClients %}
            <div class="w-32 h-8 flex items-center justify-center flex-shrink-0">
              <img src="{{ c.logo }}" alt="{{ c.name }}" class="max-w-full max-h-full object-contain grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300" loading="lazy" width="128" height="32" />
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# Right: Stats #}
      <div class="lg:col-span-3 flex items-center justify-end gap-8">
        <div class="text-center">
          <p class="text-2xl font-medium text-gray-900">5+</p>
          <p class="text-xs text-gray-500">{{ statProductsLabel }}</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-medium text-gray-900">7</p>
          <p class="text-xs text-gray-500">{{ statIndustriesLabel }}</p>
        </div>
        <div class="text-center">
          <p class="text-2xl font-medium text-gray-900">8</p>
          <p class="text-xs text-gray-500">{{ statServicesLabel }}</p>
        </div>
      </div>

    </div>
  </div>
</section>
