{#
  Homepage "solutions by industry" grid. Shared structure across all locales.

  NOTE: preserved byte-for-byte from the original EN markup, including that
  each industry's icon/heading/arrow are NOT wrapped in a per-item container
  — they're direct children of the 3-column grid. That's how the page
  already rendered in production; fixing it is a separate visual decision
  outside this refactor's scope, so it's kept exactly as-is here.

  Expects: solutionsEyebrow, solutionsHeading, industriesGradientId,
  industries — array of exactly 6 {name}, in this fixed order: Healthcare,
  Manufacturing, Legal, Professional Services, Education, Human Resources.
#}
<section class="py-16 md:py-24">
  <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 lg:px-6">
    <div class="max-w-2xl mb-12">
      <p class="text-xs uppercase tracking-widest text-zunkiree-600 font-medium mb-4">{{ solutionsEyebrow }}</p>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal text-gray-900">{{ solutionsHeading }}</h2>
    </div>

    {# SVG Gradient Definition #}
    <svg width="0" height="0" class="absolute">
      <defs>
        <linearGradient id="{{ industriesGradientId }}" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#ff6b5c"/>
          <stop offset="100%" style="stop-color:#eb1600"/>
        </linearGradient>
      </defs>
    </svg>

    {% set industryIcons = [
      "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
      "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
      "M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3",
      "M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
      "M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222",
      "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
    ] %}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for industry in industries %}
      <svg class="w-16 h-16 flex-shrink-0" fill="none" stroke="url(#{{ industriesGradientId }})" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="{{ industryIcons[loop.index0] }}"></path>
      </svg>
      <h3 class="flex-1 text-lg font-normal text-gray-900">{{ industry.name }}</h3>
      <svg class="w-5 h-5 text-gray-400 group-hover:text-gray-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H7M17 7V17"></path>
      </svg>
      {% endfor %}
    </div>
  </div>
</section>
