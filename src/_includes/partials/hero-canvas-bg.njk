{# =====================================================
   PAGE CANVAS BACKGROUND — WebGL Animated Mesh Gradient
   
   Replaces the static SVG shapes with a full-viewport WebGL
   canvas that renders dynamic, flowing diagonal gradient waves.
   ===================================================== #}
<div class="hero-ribbon-bg" style="transform: none; left: auto; right: 0; width: 55%; height: 100vh; clip-path: polygon(0 0, 100% 0, 100% 100%, 65% 100%);" aria-hidden="true">
  <canvas id="gradient-canvas" style="display: block; width: 100%; height: 100%; object-fit: cover; --gradient-color-1: #635bff; --gradient-color-2: #f15b80; --gradient-color-3: #ff7c3b; --gradient-color-4: #facc15;"></canvas>
</div>
