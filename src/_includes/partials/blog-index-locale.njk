{# =====================================================
   LOCALIZED BLOG LISTING (de / nl / de-CH)
   Same card, grid and pagination markup as src/blog/index.njk (the English
   listing), with locale strings from src/_data/i18n.js. Included by each
   locale's own index page, which sets `lang`, paginates that locale's
   collection as `posts` and provides the page title/description.
   hideChrome: true + navbar-v2/footer-v2 included directly, same convention
   as the English listing and blog-post.njk.
   ===================================================== #}
{% set uiLocale = lang or "en" %}{% set ui = i18n[uiLocale] or i18n["en"] %}
{% include "partials/navbar-v2.njk" %}

<section class="pt-32 pb-12 sm:pt-36 md:pb-16 lg:pt-44 bg-white">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center gap-2 text-sm mb-8" aria-label="{{ ui.breadcrumb | safe }}">
      <a href="{{ ui.homeUrl }}" class="text-zunkiree-600 hover:underline">{{ ui.home | safe }}</a>
      <span class="text-warm-400">/</span>
      <span class="text-warm-600">{{ ui.blog | safe }}</span>
    </nav>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-normal text-gray-900 tracking-tight leading-tight mb-6">
      {{ ui.blogTitle | safe }}
    </h1>
    <p class="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl">
      {{ ui.blogIntro | safe }}
    </p>
  </div>
</section>

<section class="pb-16 md:pb-24 bg-white">
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">

    {% if posts.length > 0 %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for post in posts %}
      <a href="{{ post.url }}" class="group block bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-lg transition-shadow">
        {# Featured Image #}
        {% if post.data.featuredImage %}
        <div class="relative aspect-[4/5] overflow-hidden bg-gray-100">
          <img
            src="{{ post.data.featuredImage }}"
            alt="{{ post.data.title }}"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/10 flex items-center justify-center p-6">
            <h2 class="text-white text-2xl md:text-3xl font-medium text-center leading-tight drop-shadow-md line-clamp-3">
              {{ post.data.title }}
            </h2>
          </div>
        </div>
        {% else %}
        <div class="relative aspect-[4/5] bg-gradient-to-br from-zunkiree-500 to-zunkiree-700 flex items-center justify-center p-6">
          <h2 class="text-white text-2xl md:text-3xl font-medium text-center leading-tight drop-shadow-md line-clamp-3">
            {{ post.data.title }}
          </h2>
        </div>
        {% endif %}

        {# Content #}
        <div class="p-6">
          {# Category + Date #}
          <div class="flex items-center gap-3 mb-3">
            {% if post.data.category %}
            <span class="text-xs font-medium text-zunkiree-600">{{ post.data.category }}</span>
            <span class="text-gray-300">·</span>
            {% endif %}
            <time class="text-sm text-gray-500" datetime="{{ post.date | date('%Y-%m-%d') }}">
              {{ post.date | localDate(uiLocale) }}
            </time>
          </div>

          {# Description #}
          {% if post.data.description %}
          <p class="text-gray-600 text-sm line-clamp-2">
            {{ post.data.description }}
          </p>
          {% endif %}

          {# Read more #}
          <div class="mt-4 flex items-center gap-2 text-sm font-medium text-zunkiree-600 group-hover:gap-3 transition-all">
            {{ ui.readArticle | safe }}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>

    {% if pagination.pages.length > 1 %}
    {# Pagination — reuses this page's own real link/button/icon classes #}
    <nav class="mt-12 flex items-center justify-between" aria-label="Blog pagination">
      {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}" class="inline-flex items-center gap-2 px-6 py-3 border border-gray-200 text-gray-900 font-medium hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 17l-5-5m0 0l5-5m-5 5h12"></path>
        </svg>
        {{ ui.previous | safe }}
      </a>
      {% else %}
      <span></span>
      {% endif %}

      <span class="text-sm text-gray-500">{{ ui.pageOf(pagination.pageNumber + 1, pagination.pages.length) }}</span>

      {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="inline-flex items-center gap-2 px-6 py-3 bg-zunkiree-600 text-white font-medium hover:bg-zunkiree-700 transition-colors">
        {{ ui.next | safe }}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      {% else %}
      <span></span>
      {% endif %}
    </nav>
    {% endif %}

    {% else %}
    {# Empty state #}
    <div class="text-center py-16">
      <svg class="w-16 h-16 text-gray-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
      </svg>
      <h2 class="text-xl font-medium text-gray-900 mb-2">Coming soon</h2>
      <p class="text-gray-600 mb-8">We're working on our first articles. Check back soon.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-zunkiree-600 text-white font-medium hover:bg-zunkiree-700 transition-colors">
        Back to Home
      </a>
    </div>
    {% endif %}

  </div>
</section>

{% include "partials/footer-v2.njk" %}
