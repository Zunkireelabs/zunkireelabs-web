{# =====================================================
   LOCATIONS INDEX PAGE — Website V2
   Reskin only: content, copy, headings, links, and the
   `locations` data binding are unchanged from the prior
   version. Chrome and section styling rebuilt to match
   homepage-v2.njk / catalog.njk exactly (same navbar-v2 +
   footer-v2 chrome, hero recipe, card recipe, closing-CTA
   recipe) per explicit "Homepage V2 is the single source of
   truth" direction — no new copy, no SEO/structure changes.
   ===================================================== #}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   HERO — centered single-column, matches catalog.njk /
   homepage-v2.njk's hero typography and breadcrumb recipe.
   ===================================================== #}
<section class="relative z-10 flex flex-col items-center justify-center px-4 pb-12 pt-40 sm:px-6 sm:pt-44 lg:px-8 lg:pt-48" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    <nav aria-label="Breadcrumb" class="mb-5">
      <ol class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400">
        <li><a href="/" class="transition-colors hover:text-navy-700">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-navy-600">Locations</li>
      </ol>
    </nav>

    <h1 id="hero-heading" class="text-center text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
      Our Locations
    </h1>

    <p class="mt-4 max-w-[640px] text-center text-[18px] font-medium leading-relaxed text-[#6B7280] sm:text-[20px]">
      Zunkiree Labs is headquartered in Kathmandu, Nepal, serving clients locally and globally. We provide AI development and software services across Nepal and to international clients.
    </p>
  </div>
</section>

{# =====================================================
   LOCATIONS GRID — restyled as homepage-v2's glass-surface
   card (COMPONENT_LIBRARY.md card recipe). Data loop, hrefs,
   HQ badge, and truncated intro copy are unchanged.
   ===================================================== #}
<section class="px-4 pb-12 sm:px-6 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {% for location in locations %}
      <a
        href="/locations/{{ location.id }}/"
        class="group flex flex-col p-6 shadow-subtle transition-all duration-300 hover:shadow-card-hover {% if location.isHeadquarters %}rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 backdrop-blur-md hover:border-[#76B900]/30{% else %}rounded-2xl border border-navy-100/60 bg-white hover:border-[#76B900]/30{% endif %}"
      >
        <div class="mb-4 flex items-start justify-between gap-3">
          <div>
            <h2 class="text-[18px] font-semibold leading-snug text-[#111827] transition-colors group-hover:text-[#4d7a00]">
              {{ location.name }}
            </h2>
            <p class="mt-1 text-[13px] text-[#6B7280]">
              {{ location.region }}, {{ location.country }}
            </p>
          </div>
          {% if location.isHeadquarters %}
          <span class="inline-flex flex-shrink-0 items-center gap-1.5 rounded-full bg-[#76B900]/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-[#4d7a00]">
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
            HQ
          </span>
          {% endif %}
        </div>
        <p class="mb-5 flex-grow text-[14px] leading-relaxed text-[#6B7280] line-clamp-2">
          {{ location.intro | truncate(120) }}
        </p>
        <div class="inline-flex items-center gap-2 font-mono text-[12px] uppercase tracking-wide text-navy-900 transition-colors group-hover:text-[#4d7a00]">
          View location
          <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   INTERNATIONAL CLIENTS — restyled as homepage-v2's
   section-header (eyebrow + headline) with pill chips
   matching the card border/mono-label language. Copy and
   country list unchanged.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8" data-reveal>
  <div class="mx-auto max-w-5xl">
    <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
      Global Reach
    </span>
    <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
      Serving Clients Globally
    </h2>
    <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-[#6B7280]">
      While headquartered in Nepal, we work with clients worldwide. Our remote collaboration processes ensure seamless communication across time zones.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      {% set globalClients = ["United States", "United Kingdom", "Australia", "Germany", "Singapore", "India", "UAE"] %}
      {% for country in globalClients %}
      <div class="flex items-center gap-2.5 rounded-xl border border-navy-100/60 bg-white px-4 py-3 text-[14px] font-medium text-navy-700 shadow-subtle">
        <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-[#76B900]" aria-hidden="true"></span>
        {{ country }}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   CLOSING CTA — homepage-v2/catalog.njk's dark navy +
   green-glow shell (COMPONENT_LIBRARY.md §2.6 dark variant).
   Copy and single "Contact Us" link unchanged.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="locations-cta-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="relative overflow-hidden rounded-[28px] bg-navy-950 px-6 py-14 text-center sm:px-12 sm:py-16"
      style="box-shadow: 0 40px 60px -25px rgba(15, 23, 42, 0.45);"
      data-reveal
    >
      <div
        class="pointer-events-none absolute inset-0 z-0"
        aria-hidden="true"
        style="background: radial-gradient(ellipse 60% 80% at 15% 100%, rgba(118,185,0,0.20) 0%, transparent 60%), radial-gradient(ellipse 50% 70% at 100% 0%, rgba(87,119,130,0.25) 0%, transparent 60%);"
      ></div>

      <h2 id="locations-cta-heading" class="relative z-10 mx-auto max-w-2xl text-[28px] font-semibold leading-[1.2] tracking-tight text-white sm:text-[32px] lg:text-[36px]">
        Ready to work with us?
      </h2>
      <p class="relative z-10 mx-auto mt-4 max-w-xl text-body-lg text-white/60">
        Whether you're in Nepal or anywhere in the world, let's discuss how we can help.
      </p>
      <div class="relative z-10 mt-8 flex justify-center">
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        >
          Contact Us
          <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-white/70" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>
