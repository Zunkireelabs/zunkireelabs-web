{% set categories = [] %}
{% for term in glossary %}
  {% if term.category not in categories %}
    {% set categories = (categories.push(term.category), categories) %}
  {% endif %}
{% endfor %}
{% set sortedCategories = categories | sort %}

{# =====================================================
   FILTER + TERMS GRID — single Alpine scope so the pill
   filters actually drive the grid below. Filter bar keeps
   /products/gaamma/'s sliding-pill animation (product-app.njk:
   a pill glides beneath the active tab, measured off its own
   bounding box) but tracks top+left+height instead of just
   left, so the slide still lands correctly when tabs wrap to a
   second row. Colors: whole tab row sits inside one white,
   shadowed card; inactive tabs are plain/transparent, and the
   sliding pill under the active tab carries the sky tint.
   ===================================================== #}
<section
  class="bg-white px-4 pb-16 pt-2 md:px-6 md:pb-24"
  x-data="{
    filter: 'all',
    pillTop: 0,
    pillLeft: 0,
    pillWidth: 0,
    pillHeight: 0,
    updatePill() {
      const el = this.$refs['filterTab-' + this.filter];
      if (el) { this.pillTop = el.offsetTop; this.pillLeft = el.offsetLeft; this.pillWidth = el.offsetWidth; this.pillHeight = el.offsetHeight; }
    }
  }"
  x-init="$nextTick(() => updatePill())"
  @resize.window="updatePill()"
>
  <div class="mx-auto max-w-5xl">

    {# Category Filter #}
    <div class="sticky top-[88px] z-20 -mx-4 mb-10 bg-white/90 px-4 py-4 backdrop-blur-md md:-mx-6 md:px-6" data-reveal>
{# Mobile dropdown #}
        <div class="md:hidden relative">
          <label for="glossary-filter" class="sr-only">Filter by category</label>
          <select
            id="glossary-filter"
            x-model="filter"
            @change="updatePill()"
            class="w-full rounded-lg border border-navy-200 bg-white px-4 py-2.5 pr-10 font-mono text-[12px] text-navy-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 appearance-none"
          >
<option value="all">All Terms</option>
            {% for category in sortedCategories %}
            {% set slug = category | lower | replace(' ', '-') %}
            <option value="{{ slug }}">{{ category }}</option>
            {% endfor %}
          </select>
          <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </div>

      {# Desktop pill tabs #}
      <div class="hidden md:flex" role="tablist" aria-label="Filter by category">
        <div class="relative flex flex-wrap items-center gap-2 rounded-3xl border border-navy-100/50 bg-white p-2 shadow-subtle">
          <span
            class="absolute rounded-full border border-sky-200/60 bg-sky-100/80 transition-all duration-300 ease-out"
            :style="`top: ${pillTop}px; left: ${pillLeft}px; width: ${pillWidth}px; height: ${pillHeight}px;`"
            aria-hidden="true"
          ></span>

          <button
            type="button"
            role="tab"
            :aria-selected="filter === 'all' ? 'true' : 'false'"
            @click="filter = 'all'; updatePill()"
            x-ref="filterTab-all"
            class="relative z-10 flex items-center gap-2 rounded-full px-4 py-2.5 font-mono text-[11px] uppercase tracking-wide text-navy-700 transition-colors duration-200 hover:text-navy-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            :class="filter === 'all' ? 'text-navy-900' : ''"
          >
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full transition-colors duration-200" :class="filter === 'all' ? 'bg-[#76B900]' : 'bg-sky-300'" aria-hidden="true"></span>
            All Terms
          </button>

          {% for category in sortedCategories %}
          {% set slug = category | lower | replace(' ', '-') %}
          <button
            type="button"
            role="tab"
            :aria-selected="filter === '{{ slug }}' ? 'true' : 'false'"
            @click="filter = '{{ slug }}'; updatePill()"
            x-ref="filterTab-{{ slug }}"
            class="relative z-10 flex items-center gap-2 rounded-full px-4 py-2.5 font-mono text-[11px] uppercase tracking-wide text-navy-700 transition-colors duration-200 hover:text-navy-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
            :class="filter === '{{ slug }}' ? 'text-navy-900' : ''"
          >
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full transition-colors duration-200" :class="filter === '{{ slug }}' ? 'bg-[#76B900]' : 'bg-sky-300'" aria-hidden="true"></span>
            {{ category }}
          </button>
          {% endfor %}
        </div>
      </div>
    </div>

    {# Terms Grid #}
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-reveal-stagger>
      {% for term in glossary | sort(attribute='term') %}
      <a
        href="/glossary/{{ term.id }}/"
        class="group block overflow-hidden rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/60 via-sky-50/25 to-white/50 p-6 shadow-subtle backdrop-blur-sm transition-shadow duration-300 hover:shadow-card-hover"
        x-show="filter === 'all' || filter === '{{ term.category | lower | replace(' ', '-') }}'"
        x-transition
      >
        <p class="mb-3">
          <span class="inline-flex items-center rounded-full border border-sky-300/40 bg-sky-100/60 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-sky-700">{{ term.category }}</span>
        </p>
        <h2 class="mb-3 text-[17px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-[#5a9100]">
          {{ term.term }}
        </h2>
        <p class="text-[14px] leading-relaxed text-navy-400">
          {{ term.shortDef }}
        </p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   CLOSING CTA BANNER — same navy-950 rounded-[28px] pattern
