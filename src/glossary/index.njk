{# =====================================================
   HERO
   ===================================================== #}
<section class="bg-white px-4 pb-10 pt-28 md:px-6 md:pb-14 md:pt-36">
  <div class="mx-auto max-w-5xl">
    <nav class="mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400">
        <li><a href="/" class="transition-colors hover:text-[#5a9100]">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-navy-900">Glossary</li>
      </ol>
    </nav>

    <div class="max-w-3xl">
      <span
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-sky-300/40 bg-sky-100/60 px-3 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-sky-700"
        data-reveal
      >
        <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-sky-500" aria-hidden="true"></span>
