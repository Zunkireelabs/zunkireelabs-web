layout: base.njk
title: "Apply | Careers at Zunkiree Labs"
description: "Apply for an open role at Zunkiree Labs. AI engineers, software developers, designers, and data scientists building intelligent platforms from Kathmandu, Nepal."
permalink: /apply/
hideChrome: true
bodyClass: "v2-inter"
---

{# =====================================================
   APPLY — WEBSITE V2
   Same visual system as contact.njk/get-a-quote.njk. Careers.njk's
   "Apply Now" buttons used to link straight to /contact/ — a
   general-inquiry form with no position field, no resume upload,
   and no portfolio/LinkedIn field, so an application arrived with
   no way to tell which role it was for. This is the dedicated
   application path instead; /contact/ is untouched.

   Submits as multipart/form-data (not JSON, unlike contact.njk/
   get-a-quote.njk) because of the resume file upload, to this
   site's own /api/submit-lead?form=apply serverless function —
   same proxy, same server-side bearer token, different EdgeX form
   slug (FORM_SLUGS.apply in api/submit-lead.js is a placeholder;
   confirm/update it once the "careers-application" form actually
   exists in EdgeX).

   Position is pre-filled from a ?position= query param when
   arriving from a specific careers.njk "Apply Now" button (each
   button links here with its own role's title), but stays a real,
   editable dropdown — not a hidden field — since someone can also
   land here directly and should be able to pick.
   ===================================================== #}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
  /* Country-code dropdown list already scrolls (max-h-64 overflow-y-auto) —
     macOS/most browsers just hide the scrollbar until actively scrolling,
     so it read as cut-off/broken. Force it visible as a thin track instead. */
  .country-scroll {
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
  }
  .country-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .country-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .country-scroll::-webkit-scrollbar-thumb {
    background-color: #d1d5db;
    border-radius: 9999px;
  }
</style>

{# =====================================================
   HERO
   ===================================================== #}
<section class="relative flex flex-col items-center justify-center px-4 pb-8 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pt-40" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    <span class="mb-4 inline-flex items-center rounded-full border border-navy-100/60 bg-white px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-500 shadow-subtle">
      Apply
    </span>

    <h1 id="hero-heading" class="text-center text-balance text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
      Join the team
    </h1>

    <p class="mt-4 max-w-[560px] px-4 text-center text-balance text-[18px] font-medium leading-relaxed text-[#6B7280] sm:text-[20px]">
      Tell us about yourself and share your resume — a Zunkiree Labs team member will follow up if it's a fit.
    </p>
  </div>
</section>

{# =====================================================
   APPLICATION FORM SECTION
   ===================================================== #}
<section class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8 lg:pb-24" aria-labelledby="apply-form-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="apply-form-heading" class="sr-only">Application form and open roles</h2>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-12" data-reveal-stagger>

      {# Left: Open Roles (2/5 width) #}
      <div class="lg:col-span-2 lg:order-1">
        <div class="rounded-2xl border border-navy-100/60 bg-white p-6 shadow-subtle sm:p-7">
          <span class="mb-6 block font-mono text-[11px] uppercase tracking-wider text-navy-500">
            Open roles
          </span>
          <div class="space-y-4">
            {% set openRoles = [
              { "title": "Senior Full-Stack Engineer", "department": "Engineering" },
              { "title": "Machine Learning Engineer", "department": "Engineering" },
              { "title": "Product Designer", "department": "Design" },
              { "title": "DevOps Engineer", "department": "Engineering" }
            ] %}
            {% for role in openRoles %}
            <div class="{% if not loop.first %}border-t border-navy-100/60 pt-4{% endif %}">
              <p class="text-[15px] font-medium text-[#111827]">{{ role.title }}</p>
              <p class="mt-0.5 text-[13px] text-[#6B7280]">{{ role.department }} · Remote · Full-time</p>
            </div>
            {% endfor %}
          </div>
          <div class="mt-6 border-t border-navy-100/60 pt-5 text-[13px]">
            <a href="/careers/" class="font-medium text-[#5a9100] transition-colors hover:text-[#4d7a00]">See full role descriptions →</a>
          </div>
        </div>
      </div>

      {# Right: Application Form (3/5 width) #}
      <div class="lg:col-span-3 lg:order-2">
        <div class="rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-8"
            x-data="{
              firstName: '',
              lastName: '',
              workEmail: '',
              countryCodes: {{ countryCodes | dump }},
              phoneCode: '+977',
              phoneCountryName: 'Nepal',
              phoneFlag: '🇳🇵',
              phone: '',
              position: '',
              portfolioUrl: '',
              coverNote: '',
              resumeFile: null,
              submitting: false,
              submitted: false,
              error: false,
              init() {
                const params = new URLSearchParams(window.location.search);
                const fromQuery = params.get('position');
                if (fromQuery) this.position = fromQuery;
              },
              handleResumeChange(e) {
                this.resumeFile = e.target.files[0] || null;
              },
              async submitApplyForm() {
                if (!this.firstName.trim() || !this.lastName.trim() || !this.workEmail.trim() || !this.position) return;
                this.submitting = true;
                this.error = false;
                try {
                  const fd = new FormData();
                  fd.append('first_name', this.firstName.trim());
                  fd.append('last_name', this.lastName.trim());
                  fd.append('work_email', this.workEmail.trim());
                  if (this.phone.trim()) fd.append('phone', this.phoneCode + ' ' + this.phone.trim());
                  fd.append('position', this.position);
                  if (this.portfolioUrl.trim()) fd.append('portfolio_url', this.portfolioUrl.trim());
                  if (this.coverNote.trim()) fd.append('cover_note', this.coverNote.trim());
                  fd.append('lead_source', 'careers-application');
                  if (this.resumeFile) fd.append('resume', this.resumeFile);

                  const res = await fetch('/api/submit-lead?form=apply', {
                    method: 'POST',
                    body: fd
                  });
                  if (!res.ok) throw new Error('Submit failed: ' + res.status);
                  this.submitted = true;
                } catch (err) {
                  console.error('[apply form] submit error', err);
                  this.error = true;
                } finally {
                  this.submitting = false;
                }
              }
            }"
          >
            {# Success state #}
            <div x-show="submitted" x-cloak class="py-10 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100]">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-[18px] font-medium text-[#111827]">Application received</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-[#6B7280]">A Zunkiree Labs team member will follow up if it's a fit.</p>
            </div>

            {# Form #}
            <form x-show="!submitted" @submit.prevent="submitApplyForm()" novalidate>
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="first_name" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">First Name <span class="text-[#76B900]">*</span></label>
                  <input type="text" id="first_name" x-model="firstName" required
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
                <div>
                  <label for="last_name" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Last Name <span class="text-[#76B900]">*</span></label>
                  <input type="text" id="last_name" x-model="lastName" required
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
              </div>

              <div class="mt-5">
                <label for="work_email" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Email <span class="text-[#76B900]">*</span></label>
                <input type="email" id="work_email" x-model="workEmail" required
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
              </div>

              <div class="mt-5">
                <label for="phone" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Phone</label>
                <div class="flex gap-2">
                  <div class="relative" x-data="{ codeOpen: false, codeSearch: '' }" @click.outside="codeOpen = false">
                    <button type="button" @click="codeOpen = !codeOpen"
                      class="flex w-[92px] flex-shrink-0 items-center justify-between gap-1 rounded-md border border-navy-100/60 bg-white px-2.5 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                      <span class="flex items-center gap-1">
                        <span x-text="phoneFlag"></span>
                        <span x-text="phoneCode"></span>
                      </span>
                      <svg class="h-3 w-3 flex-shrink-0 text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"></path>
                      </svg>
                    </button>
                    <div x-show="codeOpen" x-cloak x-transition
                      class="absolute z-20 mt-1 w-72 overflow-hidden rounded-md border border-navy-100 bg-white shadow-lg">
                      <div class="border-b border-navy-100 p-2">
                        <input type="text" x-model="codeSearch" placeholder="Search country…"
                          class="w-full rounded border border-navy-100/60 px-2 py-1.5 text-[13px] outline-none focus:border-[#76B900]">
                      </div>
                      <div class="country-scroll max-h-64 overflow-y-auto overscroll-contain py-1" data-lenis-prevent>
                        <button type="button" x-show="!codeSearch" @click="codeOpen = false"
                          class="flex w-full items-center gap-2 bg-[#F0F5E8] px-3 py-2.5 text-left text-[13px] font-medium text-[#111827]">
                          <span x-text="phoneFlag"></span>
                          <span x-text="phoneCountryName + ' (' + phoneCode + ')'"></span>
                        </button>
                        <template x-for="c in countryCodes.filter(c => c.name !== phoneCountryName && (c.name.toLowerCase().includes(codeSearch.toLowerCase()) || c.code.includes(codeSearch)))" :key="c.name">
                          <button type="button" @click="phoneCode = c.code; phoneCountryName = c.name; phoneFlag = c.flag; codeOpen = false; codeSearch = ''"
                            class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-[13px] text-[#111827] transition-colors hover:bg-navy-50">
                            <span x-text="c.flag"></span>
                            <span x-text="c.name + ' (' + c.code + ')'"></span>
                          </button>
                        </template>
                      </div>
                    </div>
                  </div>
                  <input type="tel" id="phone" x-model="phone" placeholder="98XXXXXXXX"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
              </div>

              <div class="mt-5">
                <label for="position" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Position <span class="text-[#76B900]">*</span></label>
                <select id="position" x-model="position" required
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                  <option value="" disabled>Select a role</option>
                  <option value="Senior Full-Stack Engineer">Senior Full-Stack Engineer</option>
                  <option value="Machine Learning Engineer">Machine Learning Engineer</option>
                  <option value="Product Designer">Product Designer</option>
                  <option value="DevOps Engineer">DevOps Engineer</option>
                  <option value="General Application">General Application (no specific role)</option>
                </select>
              </div>

              <div class="mt-5">
                <label for="portfolio_url" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">LinkedIn / Portfolio URL</label>
                <input type="url" id="portfolio_url" x-model="portfolioUrl" placeholder="https://"
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
              </div>

              <div class="mt-5">
                <label for="resume" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Resume / CV <span class="text-[#76B900]">*</span></label>
                <input type="file" id="resume" @change="handleResumeChange" accept=".pdf,.doc,.docx" required
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors file:mr-3 file:rounded file:border-0 file:bg-[#76B900] file:px-3 file:py-1.5 file:text-[13px] file:font-medium file:text-white focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                <p class="mt-1.5 text-[12px] text-[#6B7280]">PDF or Word, up to 10MB.</p>
              </div>

              <div class="mt-5">
                <label for="cover_note" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Anything else we should know?</label>
                <textarea id="cover_note" x-model="coverNote" rows="4" placeholder="Optional — a few lines about why you're a good fit"
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30"></textarea>
              </div>

              <p x-show="error" x-cloak class="mt-4 text-[13px] font-medium text-red-600">
                Something went wrong submitting your application. Please try again or email us directly.
              </p>

              <button type="submit" :disabled="submitting"
                class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 text-[14px] font-medium text-white transition-colors hover:bg-[#5a9100] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto">
                <span x-show="!submitting">Submit Application</span>
                <span x-show="submitting" class="flex items-center gap-2">
                  <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Submitting…
                </span>
              </button>
            </form>
        </div>
      </div>

    </div>
  </div>
</section>

{% include "partials/footer-v2.njk" %}
