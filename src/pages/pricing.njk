<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does AI development cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI development projects typically range from $15,000 to $150,000+ depending on complexity. Simple AI integrations start around $15,000, while custom RAG systems and enterprise AI platforms range from $50,000 to $150,000+. We provide detailed estimates after understanding your requirements."
      }
    },
    {
      "@type": "Question",
      "name": "What engagement models do you offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer three engagement models: Project-Based for defined scope work, Dedicated Team for ongoing development with 2-8 engineers, and Retainer for continuous support and maintenance. Each model includes project management and quality assurance."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer fixed-price contracts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we offer fixed-price contracts for projects with well-defined scope and requirements. After a discovery phase, we provide a detailed proposal with fixed pricing, timeline, and deliverables. This works best for MVP development and specific feature implementations."
      }
    },
    {
      "@type": "Question",
      "name": "What is included in your pricing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All pricing includes project management, code reviews, QA testing, documentation, and deployment support. We also provide 30 days of post-launch support included with every project. Infrastructure costs (cloud hosting, APIs) are billed separately at cost."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get started with Zunkiree Labs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Start with a free consultation call where we discuss your requirements and goals. We then provide a detailed proposal within 3-5 business days. Once approved, we begin with a discovery phase to finalize technical specifications before development starts."
      }
    }
  ]
}
</script>

