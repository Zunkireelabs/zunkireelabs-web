{# =====================================================
   SCHEMA MARKUP — preserved from the original catalog.njk render
   ===================================================== #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{{ schemaType }}",
  "name": "{{ heroTitle }} - Zunkiree Labs",
