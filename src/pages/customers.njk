{# =====================================================
   FEATURED STORY — rebuilt to match the Kore.ai customer-stories
   reference card 1:1 (badge / headline / description / dashed-
   border "View Case Study" CTA box / full-bleed photo right),
   recolored onto our own navy/#76B900 token language. Links out
   to the real Admizz case study at /resources/admizz-case-study/
   using its actual title, subtitle and cover art.
   ===================================================== #}
{% set featured = resources.items | find("slug", "admizz-case-study") %}
<section class="px-4 pb-12 sm:px-6 sm:pb-16 lg:px-8 lg:pb-20" aria-labelledby="featured-story-heading">
  <h2 id="featured-story-heading" class="sr-only">Featured customer story</h2>
  <div class="mx-auto max-w-5xl">
    <div class="overflow-hidden rounded-2xl border border-navy-100/60 bg-white shadow-card" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-2">
        {# Text column #}
        <div class="flex flex-col justify-center bg-sky-50/60 p-7 sm:p-10 lg:p-12">
          <span class="mb-5 inline-flex w-fit items-center rounded-full bg-[#76B900]/10 px-3 py-1.5 font-mono text-[11px] uppercase tracking-wider text-[#5a9100]">
            Featured Customer Story
          </span>
          <h3 class="text-[26px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[30px] lg:text-[34px]">
            {{ featured.title }}
          </h3>
          <p class="mt-4 max-w-md text-[16px] leading-relaxed text-[#6B7280]">
            {{ featured.description }}
          </p>
          <div class="mt-8 w-fit rounded-lg border border-dashed border-navy-200 p-2">
            <a
              href="/resources/admizz-case-study/"
              class="inline-flex items-center gap-2 rounded-md bg-navy-900 px-5 py-3 font-mono text-[12px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-navy-800"
            >
              View Case Study
              <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
          </div>
        </div>

        {# Photo column #}
        <div class="relative min-h-[280px] lg:min-h-full">
          <img
            src="https://images.unsplash.com/photo-1723746571161-e45723f5db33?auto=format&fit=crop&q=80&w=1200"
            alt="{{ featured.title }}"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

