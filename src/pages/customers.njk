<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="stories-heading" x-data="{ expanded: false }">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
      <h2 id="stories-heading" class="mb-4 text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Stories from our customers
      </h2>
      <p class="text-[16px] leading-relaxed text-[#6B7280] sm:text-[18px]">
        Real results from teams who chose to build with Zunkiree Labs.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {% for story in customerStories %}
        <div class="group flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-subtle transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover hover:border-navy-200"{% if loop.index0 >= 6 %} x-show="expanded" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0" x-cloak{% endif %}>
          {# Brand/photo block — industry-matched photo fills the top,
             category chip layered on top with a scrim for legibility. #}
          <div class="relative h-40 overflow-hidden bg-gradient-to-br {{ story.from }} {{ story.to }}">
            <img
              src="{{ story.photo }}"
              alt="{{ story.name }} — {{ story.category }}"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-950/50 via-navy-950/5 to-transparent" aria-hidden="true"></div>
            <span class="absolute left-4 top-4 rounded-full bg-white/90 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-navy-900 shadow-subtle">
              {{ story.category }}
            </span>
          </div>

          <div class="flex flex-1 flex-col bg-sky-50/50 p-5 sm:p-6">
            <p class="mb-5 text-[14.5px] leading-relaxed text-[#374151]">{{ story.quote }}</p>
            <div class="mt-auto flex items-center gap-3 border-t border-navy-100 pt-4">
              <img
                src="{{ story.logo }}"
                alt="{{ story.name }}"
                loading="lazy"
                class="h-6 w-auto flex-shrink-0 object-contain opacity-80 mix-blend-multiply transition-opacity duration-200 group-hover:opacity-100"
              />
              <div class="min-w-0">
                <p class="truncate text-[13.5px] font-medium text-[#111827]">{{ story.name }}</p>
                <p class="truncate text-[12px] text-[#9CA3AF]">{{ story.role }}</p>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="mt-10 flex justify-center" data-reveal>
      <button
        type="button"
        @click="expanded = !expanded"
        class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-md border border-navy-300 px-6 py-2.5 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2"
        x-text="expanded ? 'Show less' : 'Show more'"
      >Show more</button>
    </div>
  </div>
</section>

