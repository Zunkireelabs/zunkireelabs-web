{% raw %}
<script>
window.pathPicker = function () {
  return {
    i: 0,
    opts: [
      { t: 'A workflow only my business has', rec: 'Build a custom agent.', why: 'When the documents, systems and rules are specific to you, there is nothing off the shelf to start from. The narrow scope is what makes it trustworthy.', next: ['We scope the one workflow and say honestly if an agent is the wrong tool.', 'We give it only the tools it needs, with your rules and approval gates enforced around it.', 'You see the first version handle your real cases before committing.'] },
      { t: 'A common job: phone booking, selling in chat, scheduling', rec: 'Start from one of our agents.', why: 'When the job is a familiar one, the hard parts have already been built and tested. We connect it to your systems and set your rules instead of rebuilding it.', next: ['We match the job to an agent we have already built.', 'We connect it to your systems and set your hours, rules and escalation path.', 'You judge it on your own cases, not a scripted demo.'] },
      { t: 'A common job, plus steps that are specific to us', rec: 'Start from ours, then add a custom edge.', why: 'The shared parts come from an agent that already works, and the parts that are yours are built on top, so you only pay to build what is genuinely different.', next: ['We start from the closest agent we have built.', 'We scope only the parts that are specific to your business.', 'The custom part gets the same limits, approval gates and audit trail.'] },
      { t: 'I am not sure yet', rec: 'Bring us one workflow you are tired of.', why: 'You do not need to choose in advance. Describe the work and we will tell you which way fits, and whether an agent is the right tool at all.', next: ['Describe where the work arrives and what done means.', 'We tell you honestly which route fits, or that neither does.', 'If it fits, we show you a first version before you commit.'] }
    ],
    get cur() { return this.opts[this.i]; }
  };
};
window.runTrace = function () {
  var STEPS = [
    { t: 'Trigger', d: 'A schedule, a webhook, a new row, an inbound email. It runs without anybody deciding to run it.', l: [['09:00:00', 'info', 'schedule fired: supplier-invoices'], ['09:00:00', 'info', 'run #2041 started, toolset loaded (2 tools)']] },
    { t: 'Read', d: 'Source material is pulled from where it already lives: inbox, drive, database, API. Reading messy unstructured input is the part agents are genuinely good at.', l: [['09:00:02', 'tool', 'inbox.read(folder="invoices")'], ['09:00:03', 'ok', '50 messages with attachments fetched'], ['09:00:04', 'info', 'attachments parsed: PDF, scan, spreadsheet']] },
    { t: 'Plan and act', d: 'The agent works through the steps, calling only the tools this workflow was given. The sequence is decided at runtime, which is what lets it handle cases nobody enumerated.', l: [['09:00:06', 'info', 'plan: classify, extract, match to purchase order'], ['09:00:07', 'tool', 'extract(fields=[supplier, date, total, po])'], ['09:00:12', 'info', 'handling a case with no PO number: look up by supplier']] },
    { t: 'Check against your rules', d: 'Output is validated against your business rules, not the model\u2019s judgement. Below a confidence threshold it stops rather than guesses.', l: [['09:00:19', 'ok', 'rule: total matches purchase order'], ['09:00:19', 'ok', 'rule: supplier is on the approved list'], ['09:00:20', 'warn', '3 items below confidence: held back, not guessed']] },
    { t: 'Write back', d: 'Results are written into your system of record through its own API. No parallel spreadsheet for somebody to reconcile.', l: [['09:00:31', 'tool', 'ledger.post(batch)'], ['09:00:32', 'ok', '47 entries posted through the ledger API'], ['09:00:32', 'info', 'no spreadsheet created, nothing to reconcile']] },
    { t: 'Log and escalate', d: 'Every tool call and decision is recorded. Anything uncertain or above its authority goes to a person with the context attached.', l: [['09:00:33', 'warn', 'queued 3 for review with the reason for each'], ['09:00:33', 'ok', 'every call logged against the record it touched'], ['09:00:33', 'info', 'run #2041 complete']] }
  ];
  return {
    steps: STEPS, i: 0, counting: false, timer: null, inView: false, auto: true,
    lines() { return STEPS[this.i].l; },
    init() {
      this.auto = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var self = this;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { self.inView = e.isIntersecting; if (e.isIntersecting) { self.tick(); } else { self.stop(); } }); }, { threshold: 0.35 });
        io.observe(this.$el);
      }
    },
    stop() { clearTimeout(this.timer); this.timer = null; this.counting = false; },
    tick() { var self = this; this.stop(); if (!this.auto || !this.inView) return; this.counting = true; this.timer = setTimeout(function () { self.i = (self.i + 1) % STEPS.length; self.tick(); }, 4200); },
    hold() { this.stop(); },
    release() { this.tick(); },
    pick(k) { this.i = k; this.stop(); }
  };
};
window.authBoard = function () {
  var LANES = [
    { id: 'alone', title: 'Acts alone', sub: 'Allowed without asking, and logged.', box: 'border-[#76B900]/30 bg-[#76B900]/[0.06]', text: 'text-[#3d6600]', pill: 'bg-[#76B900]/20 text-[#3d6600]', tag: 'ALONE', cls: 'text-[#9bd600]', say: function (a) { return a + ': allowed to act alone, every call logged'; } },
    { id: 'person', title: 'Needs a person', sub: 'Stops at an approval gate with the context attached.', box: 'border-amber-300/50 bg-amber-50', text: 'text-amber-800', pill: 'bg-amber-200 text-amber-900', tag: 'GATE', cls: 'text-amber-300', say: function (a) { return a + ': now stops at an approval gate until a person signs off'; } },
    { id: 'never', title: 'Forbidden', sub: 'Not in its toolset. It cannot do this at all.', box: 'border-navy-200 bg-slate-100', text: 'text-navy-700', pill: 'bg-navy-200 text-navy-800', tag: 'REMOVED', cls: 'text-red-300', say: function (a) { return a + ': tool removed, it is not available to the agent at all'; } }
  ];
  var ORDER = ['alone', 'person', 'never'];
  return {
    lanes: LANES, n: 0, log: [],
    items: [
      { id: 1, label: 'Match an invoice to its purchase order', lane: 'alone' }, { id: 2, label: 'Classify and file the document', lane: 'alone' },
      { id: 3, label: 'Post a confident match to the ledger', lane: 'alone' }, { id: 4, label: 'Flag a mismatch for review', lane: 'alone' },
      { id: 5, label: 'Email a supplier', lane: 'person' }, { id: 6, label: 'Pay a supplier', lane: 'person' },
      { id: 7, label: 'Change a supplier\u2019s bank details', lane: 'never' }, { id: 8, label: 'Delete a record', lane: 'never' }
    ],
    move(a) {
      var next = ORDER[(ORDER.indexOf(a.lane) + 1) % ORDER.length];
      a.lane = next;
      var L = LANES.filter(function (l) { return l.id === next; })[0];
      this.n++; this.log.unshift({ n: this.n, tag: L.tag, cls: L.cls, text: L.say(a.label) });
      this.log = this.log.slice(0, 3);
    }
  };
};
window.versus = function () {
  var OPTIONS = [{ id: 'assistant', name: 'Assistant + your docs' }, { id: 'rpa', name: 'RPA / scripted automation' }];
  var ROWS = [
    ['Handles messy input', { assistant: 'Yes', rpa: 'Poorly: breaks on variation' }, 'Yes'],
    ['Runs unattended', { assistant: 'No', rpa: 'Yes' }, 'Yes'],
    ['Writes to your systems', { assistant: 'No', rpa: 'Yes' }, 'Yes, under set limits'],
    ['Copes with a new edge case', { assistant: 'A person decides', rpa: 'Breaks, needs a rule' }, 'Escalates with context'],
    ['Audit trail', { assistant: 'No', rpa: 'Usually' }, 'Yes, every tool call'],
    ['Breaks when the UI changes', { assistant: 'n/a', rpa: 'Frequently' }, 'No: works through APIs'],
    ['Best when', { assistant: 'A person is in the loop anyway', rpa: 'The process never varies' }, 'Volume plus variation']
  ];
  return { options: OPTIONS, rows: ROWS, side: 'assistant', get current() { var s = this.side; return OPTIONS.filter(function (o) { return o.id === s; })[0]; } };
};
window.scopeList = function () {
  return {
    items: [
      { t: 'One workflow, described end to end', d: 'Where the work arrives, what a person does with it today, and what \u201cdone\u201d means. One workflow, not a category: \u201cprocess supplier invoices\u201d rather than \u201cfinance\u201d.', on: false },
      { t: 'The rules it is checked against', d: 'What makes an output correct, and what makes one suspicious enough to escalate. If this only exists in somebody\u2019s head, extracting it is the first piece of work.', on: false },
      { t: 'Access to the destination system', d: 'API access to write results where they belong. Source material can be messy; the destination is the part that needs to be in order.', on: false },
      { t: 'Your authority boundaries', d: 'Which actions it may take alone, which need approval, and which are forbidden. These become enforced limits, not prompt instructions.', on: false },
      { t: 'A sample of real cases', d: 'Thirty or so, including the awkward ones. The edge cases are what determine whether this is worth building, so we would rather see them early than after launch.', on: false }
    ],
    get done() { return this.items.filter(function (i) { return i.on; }).length; }
  };
};
</script>
