{# ============ RUN TRACE ============ #}
<section id="run" class="scroll-mt-20 relative overflow-hidden bg-[#0b1115] px-4 py-20 sm:px-6 sm:py-24 lg:px-8 lg:py-28" aria-labelledby="ca-run-heading" x-data="runTrace()" x-init="init()" @mouseenter="hold()" @mouseleave="release()">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse 55% 60% at 0% 0%, rgba(118,185,0,0.16) 0%, transparent 60%), radial-gradient(ellipse 45% 55% at 100% 100%, rgba(87,119,130,0.22) 0%, transparent 60%);"></div>
  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 max-w-3xl" data-reveal>
      <span class="mb-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-[#9bd600]"><span class="h-px w-8 bg-[#9bd600]"></span>How an agent run works</span>
      <h2 id="ca-run-heading" class="text-balance text-[34px] font-medium leading-[1.1] tracking-tight text-white sm:text-[46px]">Reliability comes from narrowness.</h2>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-white/60">One workflow, a fixed set of tools, and an explicit edge where it stops and asks. Follow a single run, step by step.</p>
    </div>
    <div data-reveal>
      <div class="relative mb-10 hidden md:block">
        <span class="absolute left-0 right-0 top-[19px] h-px bg-white/15" aria-hidden="true"></span>
        <span class="absolute left-0 top-[19px] h-px bg-[#9bd600] transition-all duration-500" :style="'width:' + (i / (steps.length - 1) * 100) + '%'" aria-hidden="true"></span>
        <div class="relative grid grid-cols-6">
          <template x-for="(s, k) in steps" :key="s.t"><button type="button" @click="pick(k)" class="group flex flex-col items-start gap-3 text-left"><span class="flex h-10 w-10 items-center justify-center rounded-full border font-mono text-[12px] transition-all duration-300" :class="k < i ? 'border-[#76B900] bg-[#76B900] text-white' : (k === i ? 'border-[#9bd600] bg-[#0b1115] text-[#9bd600] shadow-[0_0_0_6px_rgba(155,214,0,.15)]' : 'border-white/20 bg-[#0b1115] text-white/40 group-hover:border-white/50')" x-text="k + 1"></span><span class="text-[13.5px] transition-colors" :class="k === i ? 'font-medium text-white' : 'text-white/45 group-hover:text-white/75'" x-text="s.t"></span></button></template>
        </div>
      </div>
      <div class="mb-6 flex gap-1.5 overflow-x-auto md:hidden"><template x-for="(s, k) in steps" :key="s.t"><button type="button" @click="pick(k)" class="shrink-0 rounded-full border px-3.5 py-1.5 text-[12px]" :class="k === i ? 'border-[#9bd600] bg-[#76B900]/20 text-white' : 'border-white/15 text-white/50'" x-text="(k + 1) + '. ' + s.t"></button></template></div>
      <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="min-h-[170px]"><template x-for="(s, k) in steps" :key="'d' + k"><div x-show="k === i" x-transition.opacity.duration.250ms style="display:none"><p class="font-mono text-[11px] uppercase tracking-wider text-[#9bd600]" x-text="'Step ' + (k + 1) + ' of 6'"></p><h3 class="mt-2 text-[28px] font-medium tracking-tight text-white" x-text="s.t"></h3><p class="mt-3 max-w-md text-[16px] leading-relaxed text-white/60" x-text="s.d"></p></div></template></div>
        <div class="overflow-hidden rounded-2xl border border-white/10 bg-black/40">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-3"><span class="font-mono text-[10px] uppercase tracking-wider text-white/45">Run #2041 &middot; trace</span><span class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-wider" :class="counting ? 'text-[#9bd600]' : 'text-white/35'"><i class="h-1.5 w-1.5 rounded-full" :class="counting ? 'animate-pulse bg-[#76B900]' : 'bg-white/25'"></i><span x-text="counting ? 'Replaying' : 'Paused'"></span></span></div>
          <div class="h-[210px] space-y-1.5 overflow-hidden px-5 py-4 font-mono text-[12px] leading-relaxed">
            <template x-for="(l, k) in lines()" :key="i + '-' + k"><p class="ca-pop"><span class="mr-2 text-white/30" x-text="l[0]"></span><span class="mr-2 inline-block w-14 text-[10px] uppercase tracking-wider" :class="l[1] === 'ok' ? 'text-emerald-300' : (l[1] === 'warn' ? 'text-amber-300' : 'text-sky-300')" x-text="l[1]"></span><span class="text-white/80" x-text="l[2]"></span></p></template>
            <p class="text-white/40"><span class="ca-cursor">_</span></p>
          </div>
        </div>
      </div>
      <p class="mt-5 font-mono text-[10px] uppercase tracking-wider text-white/35">Illustrative trace. Times, counts and tool names are examples, not a real run.</p>
    </div>
  </div>
</section>

{# ============ AUTHORITY BOARD ============ #}
<section id="authority" class="scroll-mt-20 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="ca-auth-heading" x-data="authBoard()">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 grid gap-6 lg:grid-cols-2 lg:items-end" data-reveal>
      <div>
        <span class="mb-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-[#5a9100]"><span class="h-px w-8 bg-[#5a9100]"></span>Bounded authority, not good intentions</span>
        <h2 id="ca-auth-heading" class="text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-[#111827] sm:text-[44px]">You decide what it does alone.</h2>
      </div>
      <p class="max-w-xl text-[16px] leading-relaxed text-[#6B7280] lg:pb-2">Each agent is given a fixed set of tools and nothing else. Limits and approval gates are enforced in the surrounding system, not requested in a prompt. Click any action to move it between lanes.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-3" data-reveal>
      <template x-for="lane in lanes" :key="lane.id">
        <div class="flex min-h-[270px] flex-col rounded-3xl border p-5 transition-colors" :class="lane.box">
          <div class="mb-4 flex items-center justify-between"><p class="font-mono text-[11px] uppercase tracking-wider" :class="lane.text" x-text="lane.title"></p><span class="rounded-full px-2.5 py-0.5 font-mono text-[10px]" :class="lane.pill" x-text="items.filter(function (a) { return a.lane === lane.id; }).length"></span></div>
          <p class="mb-4 text-[13px] leading-snug text-[#6B7280]" x-text="lane.sub"></p>
          <div class="flex flex-1 flex-col gap-2">
            <template x-for="a in items.filter(function (x) { return x.lane === lane.id; })" :key="a.id"><button type="button" @click="move(a)" class="group flex items-center justify-between gap-3 rounded-xl border border-navy-100 bg-white px-3.5 py-2.5 text-left text-[13.5px] text-[#111827] shadow-sm transition-all hover:-translate-y-0.5 hover:border-[#76B900]/60 hover:shadow-md"><span x-text="a.label"></span><span class="font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF] transition-colors group-hover:text-[#5a9100]">move &rarr;</span></button></template>
            <p x-show="items.filter(function (x) { return x.lane === lane.id; }).length === 0" class="rounded-xl border border-dashed border-navy-200 px-3.5 py-3 text-[12.5px] text-[#9CA3AF]">Nothing here. Click an action in another lane.</p>
          </div>
        </div>
      </template>
    </div>
    <div class="mt-4 overflow-hidden rounded-2xl bg-[#0b1115]" data-reveal>
      <div class="flex items-center justify-between border-b border-white/10 px-5 py-3"><span class="font-mono text-[10px] uppercase tracking-wider text-white/45">What the surrounding system enforces</span><span class="font-mono text-[10px] uppercase tracking-wider text-[#9bd600]">Supplier invoices example</span></div>
      <div class="min-h-[110px] space-y-1.5 px-5 py-4 font-mono text-[12.5px] leading-relaxed">
        <p x-show="log.length === 0" class="text-white/35">Move an action to see the rule it creates.</p>
        <template x-for="(l, k) in log" :key="l.n"><p class="ca-pop"><span class="mr-2 inline-block w-16 text-[10px] uppercase tracking-wider" :class="l.cls" x-text="l.tag"></span><span class="text-white/80" x-text="l.text"></span></p></template>
      </div>
    </div>
    <p class="mt-4 text-[14px] leading-relaxed text-[#6B7280]" data-reveal>Anything outside the toolset is not refused by the model. It is simply not available to it, which is a far stronger guarantee than instruction-following.</p>
  </div>
</section>

{# ============ USE-CASE RAIL ============ #}
<section class="border-t border-navy-100 bg-[#F8FAFC] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24" aria-labelledby="ca-fit-heading" x-data="{ scrollBy(dir) { var r = this.$refs.rail; r.scrollBy({ left: dir * Math.min(420, r.clientWidth * 0.8), behavior: 'smooth' }); } }">
  <div class="mx-auto max-w-6xl">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div class="max-w-3xl">
        <span class="mb-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-[#5a9100]"><span class="h-px w-8 bg-[#5a9100]"></span>Where custom agents pay off</span>
        <h2 id="ca-fit-heading" class="text-balance text-[32px] font-medium leading-[1.12] tracking-tight text-[#111827] sm:text-[44px]">Repetitive, a clear definition of done, quickly checkable.</h2>
        <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-[#6B7280]">Those three properties matter more than how impressive the workflow sounds.</p>
      </div>
      <div class="flex gap-2"><button type="button" @click="scrollBy(-1)" class="flex h-11 w-11 items-center justify-center rounded-full border border-navy-200 bg-white text-navy-700 transition-colors hover:border-[#76B900] hover:text-[#5a9100]" aria-label="Previous"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg></button><button type="button" @click="scrollBy(1)" class="flex h-11 w-11 items-center justify-center rounded-full border border-navy-200 bg-white text-navy-700 transition-colors hover:border-[#76B900] hover:text-[#5a9100]" aria-label="Next"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></button></div>
    </div>
    <div x-ref="rail" x-init="$el.addEventListener('wheel', function (e) { if (Math.abs(e.deltaX) > Math.abs(e.deltaY) * 0.4) { e.preventDefault(); e.stopPropagation(); $el.scrollLeft += e.deltaX; } }, { passive: false })" class="ca-rail -mx-4 flex gap-5 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0" data-reveal>
      <article class="group relative flex w-[300px] shrink-0 snap-start flex-col overflow-hidden rounded-[26px] bg-[#141F24] transition-transform duration-300 hover:-translate-y-1.5 sm:w-[360px]" style="box-shadow: 0 30px 50px -30px rgba(15,23,42,.55);">
        <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse 70% 50% at 100% 100%, rgba(118,185,0,.2) 0%, transparent 60%);"></div>
        <div class="relative overflow-hidden bg-[#141F24] "><img src="/assets/images/solutions/agent-document-processing.svg" alt="Document intake illustration" class="block w-full" width="640" height="360" loading="lazy" decoding="async"></div>
        <div class="relative flex flex-1 flex-col p-6"><span class="font-mono text-[11px] text-[#9bd600]">01</span><h3 class="mt-2 text-[21px] font-medium leading-snug tracking-tight text-white">Document intake</h3><p class="mt-2 text-[14.5px] leading-relaxed text-white/60">Invoices, applications, claims and contracts read, classified, checked against your rules and entered into the system of record, with uncertain cases queued rather than guessed.</p></div>
      </article>
