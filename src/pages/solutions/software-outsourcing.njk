<script>
window.modelPicker = function () {
  return {
    m: 0, counting: false, timer: null, inView: false, auto: true, n: 3,
    init() {
      this.auto = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var self = this;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { self.inView = e.isIntersecting; if (e.isIntersecting) { self.tick(); } else { self.stop(); } }); }, { threshold: 0.35 });
        io.observe(this.$el);
      }
    },
    stop() { clearTimeout(this.timer); this.timer = null; this.counting = false; },
    tick() { var self = this; this.stop(); if (!this.auto || !this.inView) return; this.counting = true; this.timer = setTimeout(function () { self.m = (self.m + 1) % self.n; self.tick(); }, 5000); },
    hold() { this.stop(); },
    release() { this.tick(); },
    pick(i) { this.m = i; this.stop(); }
  };
};
</script>
