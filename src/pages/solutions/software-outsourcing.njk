<section class="bg-[#F8FAFC] px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="so-faq-heading">
  <div class="mx-auto grid max-w-5xl grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">

    <div data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">FAQ</span>
      <h2 id="so-faq-heading" class="mb-6 text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">
        Working with us as an outsourcing partner
      </h2>
      <a href="/contact/" class="inline-flex items-center gap-2 font-medium text-[#5a9100] underline-offset-4 transition-colors hover:underline">
        Have more questions? Talk to us
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div x-data="{ activeIndex: 0, expandAll: false }">
      <div class="mb-4 flex items-center justify-end">
        <button
          type="button"
          @click="expandAll = !expandAll; activeIndex = expandAll ? 'all' : 0"
          class="font-mono text-[11px] uppercase tracking-wider text-navy-400 transition-colors hover:text-navy-900"
        >
          <span x-text="expandAll ? 'Collapse All' : 'Expand All'"></span>
        </button>
      </div>

      <div class="divide-y divide-navy-100 border-y border-navy-100">
        {% for item in faqs %}
        <div class="py-5" data-reveal>
          <button
            type="button"
            @click="activeIndex = (activeIndex === {{ loop.index }} && !expandAll) ? null : {{ loop.index }}"
            :aria-expanded="(activeIndex === {{ loop.index }} || expandAll).toString()"
            class="group flex w-full items-center justify-between text-left"
          >
            <span class="pr-4 text-[16px] font-medium text-[#111827] transition-colors group-hover:text-[#5a9100]">
              {{ item.question }}
            </span>
            <span class="flex-shrink-0 text-navy-400">
              <svg
                class="h-5 w-5 transition-transform duration-200"
                :class="{ 'rotate-45': activeIndex === {{ loop.index }} || expandAll }"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            x-show="activeIndex === {{ loop.index }} || expandAll"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-4 text-[15px] leading-relaxed text-[#6B7280]">
              {{ item.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

