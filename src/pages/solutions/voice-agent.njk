          <span class="font-mono text-[12px] transition-colors" :class="tab === 2 ? 'text-[#5a9100]' : ''">03</span>
          <span class="flex-1 text-[19px] font-medium tracking-tight sm:text-[22px]">Reminders</span>
          <span class="text-[18px] transition-all" :class="tab === 2 ? 'translate-x-0 text-[#5a9100] opacity-100' : '-translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-60'" aria-hidden="true">&rarr;</span>
          <template x-if="tab === 2 && counting"><span class="tabfill absolute bottom-[-1px] left-0 h-[2px] bg-[#76B900]" style="animation-duration: 4.5s"></span></template>
        </button>
        <button type="button" role="tab" @click="pick(3)" :aria-selected="tab === 3" class="group relative flex w-full items-center gap-4 border-t border-navy-100 py-5 text-left transition-colors last:border-b" :class="tab === 3 ? 'text-[#111827]' : 'text-[#9CA3AF] hover:text-navy-600'">
          <span class="font-mono text-[12px] transition-colors" :class="tab === 3 ? 'text-[#5a9100]' : ''">04</span>
