          <span class="text-[18px] transition-all" :class="tab === 3 ? 'translate-x-0 text-[#5a9100] opacity-100' : '-translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-60'" aria-hidden="true">&rarr;</span>
          <template x-if="tab === 3 && counting"><span class="tabfill absolute bottom-[-1px] left-0 h-[2px] bg-[#76B900]" style="animation-duration: 4.5s"></span></template>
