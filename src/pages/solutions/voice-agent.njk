    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_22rem_minmax(0,1fr)] lg:gap-10" data-reveal :class="status === 'live' ? 'va-live' : ''">
      {# ---------- LEFT: calendar ---------- #}
      <div class="order-2 flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] backdrop-blur lg:order-1 lg:h-[600px]">
        <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
          <div><p class="text-[15px] font-semibold text-white"><span class="text-[#9bd600]">&#10022;</span> Zennly calendar <span class="ml-1 inline-flex items-center gap-1 align-middle font-mono text-[10px] uppercase tracking-wider text-[#9bd600]"><span class="h-1.5 w-1.5 rounded-full bg-[#76B900]"></span>Live</span></p><p class="mt-0.5 text-[12px] text-white/50" x-text="sc.title"></p></div>
          <span class="rounded-full bg-white/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-white"><span x-text="bookings.length"></span> bookings</span>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto px-5 py-4">
          <div class="grid gap-1.5" :style="'grid-template-columns: 3.2rem repeat(' + sc.cols.length + ', minmax(0,1fr))'">
            <div></div>
            <template x-for="c in sc.cols" :key="c"><div class="pb-0.5 text-center font-mono text-[10px] uppercase tracking-wider text-white/45" x-text="c"></div></template>
            <template x-for="(r, ri) in sc.rows" :key="r">
              <div class="contents">
                <div class="pr-1 pt-2 text-right font-mono text-[10px] text-white/35" x-text="r"></div>
                <template x-for="(c, ci) in sc.cols" :key="ci">
                  <div class="flex h-9 items-center justify-center rounded-lg border text-[10.5px] font-medium transition-colors duration-500 lg:h-11" :class="cellClassD(ci + '-' + ri)" x-text="cellLabel(ci + '-' + ri)"></div>
                </template>
              </div>
            </template>
          </div>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[9px] uppercase tracking-wider text-white/40">
            <span class="flex items-center gap-1.5"><i class="inline-block h-2.5 w-2.5 rounded border border-white/15 bg-white/[0.04]"></i>Free</span>
            <span class="flex items-center gap-1.5"><i class="va-busy inline-block h-2.5 w-2.5 rounded border border-white/15"></i>Taken</span>
            <span class="flex items-center gap-1.5"><i class="inline-block h-2.5 w-2.5 rounded border border-amber-400 bg-amber-400/20"></i>Offered</span>
            <span class="flex items-center gap-1.5"><i class="inline-block h-2.5 w-2.5 rounded border border-[#76B900] bg-[#76B900]"></i>Booked</span>
          </div>
        </div>
        <div class="border-t border-white/10 px-5 py-3">
          <div x-show="sms" class="sms-in mb-2 flex items-start gap-2 rounded-xl bg-white px-3.5 py-2.5 text-[12px] leading-snug text-[#111827]" style="display:none"><span class="shrink-0 font-mono text-[10px] uppercase tracking-wider text-[#5a9100]">SMS sent</span><span x-text="sms"></span></div>
          <ul class="space-y-1.5">
            <template x-for="(b, i) in bookings.slice(0, 2)" :key="b.n + b.t + i">
              <li class="flex items-center justify-between rounded-lg px-3 py-1.5 text-[13px]" :class="i === 0 && b.fresh ? 'bg-[#76B900]/20 ring-1 ring-[#76B900]/50' : 'bg-white/[0.05]'"><span class="font-medium text-white" x-text="b.n"></span><span class="text-white/55" x-text="b.t"></span><span class="rounded-full bg-[#76B900]/25 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[#9bd600]" x-text="b.s"></span></li>
            </template>
          </ul>
        </div>
      </div>

      {# ---------- CENTRE: phone with sonar rings ---------- #}
      <div class="relative order-1 lg:order-2">
        <div class="pointer-events-none absolute left-1/2 top-1/2 -z-0 hidden h-[420px] w-[420px] lg:block" aria-hidden="true"><span class="va-ring h-full w-full"></span><span class="va-ring h-full w-full" style="animation-delay:1.4s"></span><span class="va-ring h-full w-full" style="animation-delay:2.8s"></span></div>
        <div class="relative z-10">
          <div class="mx-auto w-full max-w-[22rem]">
        <div class="relative rounded-[46px] bg-[#0b1115] p-3" style="box-shadow: 0 50px 80px -35px rgba(15,23,42,.6), inset 0 0 0 1.5px rgba(255,255,255,.08);">
          <div class="relative flex h-[610px] flex-col overflow-hidden rounded-[36px]" style="background: linear-gradient(180deg,#17262d 0%, #0d1519 70%);">
            <button type="button" x-show="soundBlocked && inView" style="display:none" @click="userMuted = false; soundBlocked = false; sound = true" class="va-tap absolute inset-x-5 top-[44%] z-30 flex flex-col items-center gap-2.5 rounded-3xl border border-[#9bd600]/50 bg-[#0b1115]/90 px-5 py-5 text-center shadow-2xl backdrop-blur" aria-label="Tap to hear the agent">
              <span class="va-tap-ring flex h-14 w-14 items-center justify-center rounded-full bg-[#76B900] text-white"><svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg></span>
              <span class="text-[17px] font-medium text-white">Tap to hear the agent</span>
              <span class="text-[12.5px] leading-snug text-white/60">Your browser needs one tap before it allows sound. The call keeps playing either way.</span>
            </button>
            <div class="pointer-events-none absolute inset-0" aria-hidden="true" style="background: radial-gradient(ellipse 80% 45% at 50% 0%, rgba(118,185,0,.22) 0%, transparent 70%);"></div>
            <div class="absolute left-1/2 top-2.5 h-6 w-24 -translate-x-1/2 rounded-full bg-black" aria-hidden="true"></div>
            <div class="relative flex items-center justify-between px-7 pt-3.5 font-mono text-[11px] text-white/60"><span>9:04</span><span>5G</span></div>
            <div class="relative mt-8 flex flex-col items-center text-center">
              <span class="relative flex h-24 w-24 items-center justify-center rounded-full bg-[#76B900]/15 text-[34px] font-semibold text-[#9bd600] ring-1 ring-[#76B900]/40" :class="speaker === 'agent' ? 'ringpulse' : ''">N</span>
              <p class="mt-4 text-[20px] font-medium text-white">Northside Clinic</p>
              <p class="mt-0.5 font-mono text-[12px] tracking-wider text-white/50" x-text="status === 'ready' ? 'Ready to call' : (status === 'done' ? 'Call ended · ' + clock : 'Connected · ' + clock)"></p>
            </div>
            <div class="relative mt-6 flex h-16 items-center justify-center gap-[3px] px-6" :class="speaker ? '' : 'wv-still'" aria-hidden="true">
              {% for h in [10,18,30,16,38,24,48,28,56,34,22,46,30,60,36,24,50,28,40,20,34,16,26,12] %}<span class="wv-bar w-[3px] rounded-full" :class="speaker === 'caller' ? 'bg-white/80' : 'bg-[#9bd600]'" style="height: {{ h }}px; animation-delay: {{ loop.index0 * 0.06 }}s; animation-duration: {{ 0.7 + (loop.index0 % 5) * 0.12 }}s"></span>{% endfor %}
            </div>
            <p class="relative mt-1 text-center font-mono text-[10px] uppercase tracking-wider text-white/40" x-text="speaker === 'agent' ? 'Agent speaking' : (speaker === 'caller' ? 'Caller speaking' : (status === 'live' ? 'Listening' : ' '))"></p>
            {# live captions #}
            <div class="relative mt-3 flex-1 space-y-2 overflow-hidden px-5" aria-live="polite" x-ref="tr">
              <template x-for="(l, i) in lines.slice(-2)" :key="lines.length - 2 + i + l.text">
                <div class="assemble flex" :class="l.who === 'agent' ? 'justify-end' : 'justify-start'">
                  <p class="max-w-[88%] rounded-2xl px-3.5 py-2 text-[13px] leading-snug" :class="l.who === 'agent' ? 'rounded-br-sm bg-[#76B900]/25 text-white' : 'rounded-bl-sm bg-white/12 text-white/90'" x-text="l.text"></p>
                </div>
              </template>
              <p x-show="lines.length === 0" class="pt-6 text-center text-[13px] text-white/40">Press the green button to start the call.</p>
            </div>
            {# controls #}
            <div class="relative flex items-center justify-center gap-5 pb-6 pt-3">
              <button type="button" @click="toggleSound()" class="flex h-12 w-12 items-center justify-center rounded-full border transition-colors" :class="sound ? 'border-[#9bd600] bg-[#76B900]/25 text-[#9bd600]' : 'border-white/20 bg-white/5 text-white/70 hover:bg-white/10'" :aria-pressed="sound" aria-label="Toggle voices">
                <svg x-show="sound" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg>
                <svg x-show="!sound" style="display:none" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-6l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg>
              </button>
              <button type="button" @click="userDriven = true; play()" class="flex h-16 w-16 items-center justify-center rounded-full bg-[#76B900] text-white transition-colors hover:bg-[#5a9100]" :class="status === 'ready' ? 'ringpulse' : ''" aria-label="Play call">
                <svg x-show="status !== 'live'" class="h-7 w-7" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M6.3 2.8A1 1 0 004.8 3.7v12.6a1 1 0 001.5.9l10.4-6.3a1 1 0 000-1.8L6.3 2.8z"/></svg>
                <svg x-show="status === 'live'" style="display:none" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v6h6M20 20v-6h-6M20 10a8 8 0 00-14.5-3M4 14a8 8 0 0014.5 3"/></svg>
              </button>
              <button type="button" @click="userDriven = true; stop()" class="flex h-12 w-12 items-center justify-center rounded-full border border-white/20 bg-white/5 text-white/70 transition-colors hover:bg-red-500/20 hover:text-red-300" aria-label="End call"><svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><rect x="5" y="5" width="10" height="10" rx="2"/></svg></button>
            </div>
          </div>
        </div>
        <p class="mt-3 text-center font-mono text-[10px] uppercase tracking-wider" :class="soundBlocked ? 'text-amber-300' : 'text-white/45'" x-text="soundBlocked ? 'Your browser blocked autoplay sound. Click anywhere to hear the call.' : (sound ? ('Voices on' + (voiceInfo.agent ? ' · Agent: ' + voiceInfo.agent + ' · Caller: ' + voiceInfo.caller : '') + '. Built-in browser speech.') : (inView ? 'Sound is off. Tap the speaker to hear the call.' : 'Sound starts when you reach this section.'))"></p>
      </div>
        </div>
      </div>

      {# ---------- RIGHT: steps + log ---------- #}
      <div class="order-3 flex flex-col gap-4 lg:h-[600px]">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5 backdrop-blur">
          <p class="mb-3 font-mono text-[10px] uppercase tracking-wider text-white/45">What the agent is doing</p>
          <ol class="space-y-1">
            <template x-for="(p, i) in phases" :key="p">
              <li class="flex items-center gap-3 rounded-xl px-3 py-2 transition-colors duration-300" :class="phase === i ? 'bg-[#76B900]/20' : ''">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border font-mono text-[10px] transition-colors duration-300" :class="phase > i ? 'border-[#76B900] bg-[#76B900] text-white' : (phase === i ? 'border-[#9bd600] text-[#9bd600]' : 'border-white/15 text-white/35')"><svg x-show="phase > i" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span x-show="phase <= i" x-text="i + 1"></span></span>
                <span class="text-[14px] transition-colors duration-300" :class="phase === i ? 'font-medium text-white' : (phase > i ? 'text-white/70' : 'text-white/40')" x-text="p"></span>
              </li>
            </template>
          </ol>
        </div>
        <div class="flex min-h-[230px] flex-1 flex-col overflow-hidden rounded-3xl border border-white/10 bg-black/40">
          <div class="flex shrink-0 items-center justify-between border-b border-white/10 px-5 py-3"><span class="font-mono text-[10px] uppercase tracking-wider text-white/45">Under the hood &middot; agent log</span><span class="flex gap-1.5" aria-hidden="true"><i class="h-2 w-2 rounded-full bg-white/15"></i><i class="h-2 w-2 rounded-full bg-white/15"></i><i class="h-2 w-2 rounded-full bg-white/15"></i></span></div>
          <div class="min-h-0 flex-1 space-y-1.5 overflow-y-auto px-5 py-4 font-mono text-[12px] leading-relaxed" x-ref="lg">
            <p x-show="logs.length === 0" class="text-white/35">Waiting for a call...</p>
            <template x-for="(e, i) in logs" :key="i">
              <p class="assemble"><span class="mr-2 inline-block w-14 text-[10px] uppercase tracking-wider" :class="e.k === 'tool' ? 'text-[#9bd600]' : (e.k === 'ok' ? 'text-emerald-300' : 'text-sky-300')" x-text="e.k"></span><span class="text-white/80" x-text="e.t"></span></p>
            </template>
          </div>
        </div>
      </div>
    </div>

    {# ---------- scenario dock ---------- #}
    <div class="mt-12 flex flex-col items-center gap-3" data-reveal>
      <p class="font-mono text-[10px] uppercase tracking-wider text-white/40">Choose a call</p>
      <div class="flex max-w-full flex-wrap items-center justify-center gap-2 rounded-[28px] border border-white/10 bg-white/[0.05] p-2 backdrop-blur" role="tablist" aria-label="Choose a call scenario">
        <template x-for="s in scenarios" :key="s.id">
          <button type="button" role="tab" :aria-selected="active === s.id" @click="userDriven = true; select(s.id); play()" class="relative overflow-hidden rounded-full px-4 py-2 font-mono text-[11px] uppercase tracking-wider transition-colors" :class="active === s.id ? 'bg-white text-[#0b1115]' : 'text-white/65 hover:bg-white/10 hover:text-white'"><span x-text="s.label"></span><template x-if="active === s.id && status === 'live'"><span class="absolute bottom-0 left-0 h-[2px] w-full bg-[#76B900]"></span></template></button>
        </template>
      </div>
      <p class="max-w-xl text-center font-mono text-[10px] uppercase tracking-wider text-white/35">Simulated example for illustration. Names, times, wording and log lines are not a recording of a real call.</p>
    </div>
  </div>
</section>

{# ============ IN ACTION ============ #}
