<script>
window.howDemo = function () {
  return {
    o: 'valid', counting: false, timer: null, held: null, order: ['valid', 'unknown', 'props'], auto: true,
    init() {
      this.auto = !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
      var self = this;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { self.tick(); } else { self.stop(); } }); }, { threshold: 0.35 });
        io.observe(this.$el);
      }
    },
    stop() { clearTimeout(this.timer); this.timer = null; this.counting = false; },
    tick() {
      var self = this;
      this.stop();
      if (!this.auto) return;
      this.counting = true;
      this.timer = setTimeout(function () { self.o = self.order[(self.order.indexOf(self.o) + 1) % self.order.length]; self.tick(); }, 2000);
    },
    hold(ms) { var self = this; this.stop(); clearTimeout(this.held); if (ms) { this.held = setTimeout(function () { self.tick(); }, ms); } },
    release() { clearTimeout(this.held); this.tick(); },
    pick(k) { this.o = k; this.hold(); }
  };
};
</script>
