                </div>
              </div>

              <div class="assemble assemble-2 grid grid-cols-2 gap-2.5 md:grid-cols-5">
                <template x-for="k in seoKpis" :key="k.l"><button type="button" :class="wz.tools.goal === 'Backlinks' && /backlink/i.test(k.l) ? 'ring-2 ring-[#76B900] shadow-lg' : ''" @click="touch(k.l, k.a, ['Reading ' + k.l.toLowerCase(), 'Comparing with the previous period'], k.l, k.a)" class="group rounded-xl border border-navy-100 bg-white p-3 text-left transition-all hover:-translate-y-0.5 hover:border-[#76B900] hover:shadow-md"><p class="font-mono text-[9px] uppercase tracking-wider text-[#9CA3AF]" x-text="k.l"></p><p class="mt-1 text-[22px] font-semibold leading-none text-[#111827]" x-text="k.v"></p><div class="mt-2 flex items-end justify-between"><p class="text-[10.5px] font-medium text-emerald-600" x-text="(k.up ? '↑ ' : '↓ ') + k.d"></p><svg class="h-5 w-14 text-[#76B900]" viewBox="0 0 56 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path :d="k.sp"/></svg></div></button></template>
              </div>

