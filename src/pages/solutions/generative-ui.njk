                  <button type="button" x-show="!result && !gen" @click="generate()" class="relative w-full overflow-hidden rounded-xl bg-[#76B900] px-4 py-3 font-mono text-[12px] uppercase tracking-wider text-white shadow-lg shadow-[#76B900]/30 transition-colors hover:bg-[#5a9100]"><span x-text="'✦ Generate my ' + fdays + '-day itinerary'"></span></button>
                  <div x-show="result || gen" style="display:none" class="space-y-3 rounded-xl border border-navy-100 bg-white p-3">
