                <div class="rounded-2xl border border-navy-100 bg-white p-3.5 transition-shadow" :class="wz.tools.goal === 'Traffic' ? 'ring-2 ring-[#76B900] shadow-lg' : ''">
                  <div class="flex items-start justify-between"><p class="font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF]">Organic traffic</p><span class="font-mono text-[10px] text-[#9CA3AF]">&lt;TrafficChart /&gt;</span></div>
