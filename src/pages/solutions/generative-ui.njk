                      <g stroke="#E5E7EB" stroke-width="1"><line x1="40" x2="590" y1="160" y2="160"/><line x1="40" x2="590" y1="122.5" y2="122.5"/><line x1="40" x2="590" y1="85" y2="85"/><line x1="40" x2="590" y1="47.5" y2="47.5"/><line x1="40" x2="590" y1="10" y2="10"/></g>
                      <g font-size="10" fill="#9CA3AF" text-anchor="end"><text x="34" y="164">0</text><text x="34" y="126.5">5K</text><text x="34" y="89">10K</text><text x="34" y="51.5">15K</text><text x="34" y="14">20K</text></g>
                      <path :d="seoArea" fill="url(#seo-fill)" opacity=".9"/><path :d="seoLine" fill="none" stroke="#5a9100" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>
                      <defs><linearGradient id="seo-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#76B900" stop-opacity=".28"/><stop offset="1" stop-color="#76B900" stop-opacity="0"/></linearGradient></defs>
                      <g font-size="10" fill="#9CA3AF" text-anchor="middle" x-html="seoLabelsSvg"></g>
                      <g x-show="seoSel !== null" style="display:none"><line :x1="seoDot.x" :x2="seoDot.x" y1="10" y2="160" stroke="#76B900" stroke-dasharray="3 3"/><circle :cx="seoDot.x" :cy="seoDot.y" r="4.5" fill="#fff" stroke="#5a9100" stroke-width="2"/></g>
                      <circle x-show="seoSel === null" :cx="seoEnd.x" :cy="seoEnd.y" r="4.5" fill="#5a9100"/>
                    </svg>
                    <div x-show="seoSel !== null" style="display:none" class="pointer-events-none absolute top-0 -translate-x-1/2 rounded-lg bg-[#111827] px-2.5 py-1 text-[11px] text-white shadow-lg" :style="'left:' + Math.min(88, Math.max(12, seoDot.x / 6)) + '%'"><span x-text="seoTip"></span></div>
                  </div>
