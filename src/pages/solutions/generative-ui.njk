                      <ul class="mt-2.5 flex flex-wrap gap-1.5 text-[11px]"><template x-for="h in info.h" :key="h"><li class="flex items-center gap-1 rounded-full bg-slate-50 px-2.5 py-1 text-navy-600"><span class="text-[#76B900]">&#10003;</span><span x-text="h"></span></li></template></ul>
                      <div x-show="fplaces.length" style="display:none" class="mt-3 border-t border-navy-100 pt-3">
