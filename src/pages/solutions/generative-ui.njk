                    <div class="flex flex-wrap gap-2"><template x-for="t in tweaks" :key="t.id"><button type="button" @click="tweak(t.id)" :disabled="gen" class="rounded-full border border-[#76B900]/50 bg-white px-3.5 py-1.5 text-[12px] text-[#2f5200] transition-colors hover:bg-[#76B900]/10 disabled:opacity-50" x-text="'✦ ' + t.l"></button></template></div>
