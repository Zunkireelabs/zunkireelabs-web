                        <div class="flex flex-wrap items-start gap-1.5"><template x-for="(rt, ri) in split" :key="rt.place"><div class="assemble flex items-start gap-1.5"><div class="flex w-24 flex-col items-center text-center sm:w-28"><span class="block w-full overflow-hidden rounded-lg ring-2 ring-[#76B900]/40"><span class="block" :style="art(rt.place, placeExp(rt.place), 16, 10)"></span></span><span class="mt-1 text-[11.5px] font-medium text-[#111827]" x-text="rt.place"></span><span class="font-mono text-[9.5px] uppercase tracking-wider text-[#5a9100]" x-text="rt.d ? rt.d + (rt.d === 1 ? ' day' : ' days') : 'days?'"></span></div><span x-show="ri < split.length - 1" class="mt-6 text-[#76B900]">&rarr;</span></div></template></div>
                      </div>
                      <p class="mt-3 border-t border-navy-100 pt-2.5 font-mono text-[10px] uppercase tracking-wider text-[#6B7280]" x-text="summary"></p>
                    </div>
                  </div></template>

                  <template x-if="result && !gen && preview"><div class="assemble">
                    <div class="relative" :style="art(preview.place, preview.lead, 16, 7)"><div class="absolute inset-0" style="background:linear-gradient(0deg,rgba(15,23,42,.82) 0%,rgba(15,23,42,.35) 45%,rgba(15,23,42,0) 70%)"></div><div class="absolute inset-x-4 bottom-3 text-white" style="text-shadow:0 1px 8px rgba(0,0,0,.45)"><p class="font-mono text-[9.5px] uppercase tracking-wider text-white/75" x-text="orderedPlaces.join(' → ')"></p><p class="text-[19px] font-medium leading-tight text-white" x-text="preview.title"></p></div></div>
                    <ol class="max-h-[16rem] space-y-2 overflow-y-auto p-3.5"><template x-for="(d, di) in preview.days" :key="preview.sig + di"><li class="assemble flex items-center gap-3 text-[12px] leading-snug" :style="'animation-delay:' + (di * 70) + 'ms'"><span class="w-16 shrink-0 overflow-hidden rounded-lg"><span class="block" :style="art(d.place, d.ex, 16, 10)"></span></span><span class="min-w-0 flex-1"><span class="block font-mono text-[10px] uppercase tracking-wider text-[#5a9100]" x-text="'Day ' + (di + 1) + ' · ' + d.place + (d.move ? ' · travel' : '')"></span><span class="font-medium text-[#111827]" x-text="d.n"></span><span class="text-[#6B7280]" x-text="' · ' + d.t"></span></span></li></template></ol>
                    <p class="flex items-center justify-between border-t border-navy-100 px-3.5 py-2.5 text-[12px]"><span class="font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF]" x-text="'Sample estimate · ' + tier"></span><span class="font-medium text-[#111827]" x-text="'$' + preview.cost.toLocaleString('en-US') + ' per person'"></span></p>
                  </div></template>
                </div>
              </div>
            </div>

            {# ===== INTERNAL TOOLS: SEO analytics workspace ===== #}
            <div x-show="stage >= 5 && active === 'tools' && wdone.tools" style="display:none" class="space-y-3">
