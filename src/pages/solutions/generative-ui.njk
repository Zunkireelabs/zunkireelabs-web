<script>
/* Pinned, scroll-scrubbed entrance (desktop only): the floating components fly in and assemble the
   product window, which tilts up out of perspective and opens to full screen. Falls back to a normal
   inline demo on small screens, short viewports and reduced motion. */
(function () {
  var section = document.getElementById('gen-universe');
  if (!section) return;
  var reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  var deep = !!new URLSearchParams(window.location.search).get('demo');
  var wide = window.matchMedia('(min-width:1024px) and (min-height:640px)');
  if (reduced || deep || !wide.matches) return;
  var tries = 0;
  function boot() {
    var gsap = window.gsap;
    var ST = window.ScrollTrigger || (gsap && gsap.core && gsap.core.globals && gsap.core.globals().ScrollTrigger);
    if (!gsap || !ST) { if (tries++ < 100) setTimeout(boot, 60); return; }
    section.setAttribute('data-aperture', 'on');
    var frame = document.getElementById('gu-frame'), outside = document.getElementById('gu-outside'),
        ring = document.getElementById('gu-ring'), previewCard = document.getElementById('gu-preview-card'),
        univ = document.getElementById('gu-universe'), cue = document.getElementById('gu-exit'),
        header = document.querySelector('header'), frags = gsap.utils.toArray('#gu-frags .gu-frag');
    var W = section.offsetWidth, H = section.offsetHeight;
    var winW = Math.min(640, W - 80), winH = Math.min(460, H - 140);
    var wx = Math.round((W - winW) / 2), wy = Math.round((H - winH) / 2) + 40;
    univ.style.setProperty('--gu-W', W + 'px'); univ.style.setProperty('--gu-H', H + 'px');
    gsap.set(ring, { width: winW, height: winH });
    gsap.set(previewCard, { width: winW, height: winH });
    gsap.set(frame, { left: wx, top: wy, width: winW, height: winH, borderRadius: 22, transformPerspective: 1500, transformOrigin: '50% 100%', rotateX: 9, scale: 0.97 });
    gsap.set(univ, { xPercent: -50, yPercent: -50, scale: 0.96 });
    var sRect = section.getBoundingClientRect();
    var targets = frags.map(function (el) {
      var r = el.getBoundingClientRect();
      return { el: el, dx: (W / 2) - (r.left - sRect.left + r.width / 2), dy: (wy + winH / 2) - (r.top - sRect.top + r.height / 2) };
    }).filter(function (g) { return g.el.offsetWidth > 0; });
    var tl = gsap.timeline();
    tl.to(outside, { opacity: 0, y: -26, scale: 1.04, filter: 'blur(10px)', duration: 0.5, ease: 'power1.in' }, 0);
    targets.forEach(function (g, i) { tl.to(g.el, { x: g.dx, y: g.dy, scale: 0.25, opacity: 0, duration: 1.0, ease: 'power2.in' }, 0.05 + i * 0.07); });
    tl.to(ring, { scale: 1.35, opacity: 0, duration: 0.5, ease: 'power2.in' }, 0.35)
      .to(previewCard, { opacity: 0, scale: 0.94, duration: 0.35, ease: 'power2.in' }, 0.35)
      .to(frame, { left: 0, top: 0, width: W, height: H, borderRadius: 0, rotateX: 0, scale: 1, duration: 1.4, ease: 'power3.inOut' }, 0.4)
      .to(univ, { opacity: 1, scale: 1, duration: 0.45, ease: 'power2.out' }, 1.15)
      .from('.gu-stagger', { y: 14, opacity: 0, duration: 0.5, ease: 'power2.out' }, 1.2)
      .to(cue, { opacity: 1, duration: 0.3, ease: 'power1.out' }, 3.8)
      .to(cue, { opacity: 0, duration: 0.2, ease: 'power1.in' }, 4.5)
      .to(univ, { opacity: 0, scale: 1.03, duration: 0.3, ease: 'power1.in' }, 4.75)
      .to(frame, { left: wx, top: wy, width: winW, height: winH, borderRadius: 22, rotateX: 9, scale: 0.97, duration: 1.3, ease: 'power3.inOut' }, 4.7)
      .fromTo(previewCard, { opacity: 0, scale: 0.94 }, { opacity: 1, scale: 1, duration: 0.5, ease: 'power2.out', immediateRender: false }, 4.95)
      .to(outside, { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)', duration: 0.5, ease: 'power2.out' }, 5.3)
      .to(ring, { scale: 1, opacity: 1, duration: 0.45, ease: 'back.out(1.5)' }, 5.55);
    targets.forEach(function (g, i) { tl.to(g.el, { x: 0, y: 0, scale: 1, opacity: 1, duration: 0.6, ease: 'back.out(1.2)' }, 5.3 + i * 0.05); });
    var total = tl.duration(), last = null;
    function hideNav(h) {
      [header, document.getElementById('zunkiree-widget-root')].forEach(function (el) { if (!el) return; el.style.transition = 'opacity .25s'; el.style.opacity = h ? '0' : '1'; el.style.pointerEvents = h ? 'none' : ''; });
    }
    ST.create({
      trigger: section, pin: true, pinSpacing: true, start: 'top top', end: '+=4400', scrub: 0.6, animation: tl,
      onEnter: function () { hideNav(true); }, onEnterBack: function () { hideNav(true); },
      onLeave: function () { hideNav(false); window.dispatchEvent(new CustomEvent('gu-open', { detail: { open: false } })); },
      onLeaveBack: function () { hideNav(false); window.dispatchEvent(new CustomEvent('gu-open', { detail: { open: false } })); },
      onUpdate: function (self) {
        var open = self.progress * total > 1.7 && self.progress * total < 4.5;
        if (open !== last) { last = open; window.dispatchEvent(new CustomEvent('gu-open', { detail: { open: open } })); }
      }
    });
    window.addEventListener('load', function () { ST.refresh(); });
    setTimeout(function () { ST.refresh(); }, 600);
  }
  boot();
})();
</script>
