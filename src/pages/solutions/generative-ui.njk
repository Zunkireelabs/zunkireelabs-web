                <div class="rounded-2xl border border-navy-100 bg-white p-3.5" :class="wz.tools.goal === 'Keywords' ? 'ring-2 ring-[#76B900] shadow-lg' : ''">
                  <p class="flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF]"><span>Top performing keywords</span><span>&lt;KeywordTable /&gt;</span></p>
                  <div class="mt-2 grid grid-cols-[1fr_auto_auto_auto] gap-x-3 gap-y-0 text-[11.5px]">
                    <span class="pb-1 font-mono text-[9px] uppercase tracking-wider text-[#9CA3AF]">Keyword</span><span class="pb-1 text-right font-mono text-[9px] uppercase tracking-wider text-[#9CA3AF]">Pos.</span><span class="pb-1 text-right font-mono text-[9px] uppercase tracking-wider text-[#9CA3AF]">Chg.</span><span class="pb-1 text-right font-mono text-[9px] uppercase tracking-wider text-[#9CA3AF]">Clicks</span>
                    <template x-for="k in seoKeywords" :key="k.n"><button type="button" @click="touch(k.n, k.a, ['Reading rankings for this keyword', 'Checking the page that ranks'], k.n, k.a)" class="contents text-left"><span class="flex items-center gap-1.5 rounded-l-md border-t border-navy-100 py-1.5 pr-1 text-[#111827] hover:bg-[#76B900]/10"><span class="text-emerald-600">&#8599;</span><span class="truncate" x-text="k.n"></span></span><span class="border-t border-navy-100 py-1.5 text-right text-[#374151]" x-text="k.p"></span><span class="border-t border-navy-100 py-1.5 text-right text-emerald-600" x-text="'↑ ' + k.c"></span><span class="border-t border-navy-100 py-1.5 text-right text-[#374151]" x-text="k.k"></span></button></template>
                  </div>
                </div>
              </div>

              <div class="assemble assemble-3 grid gap-3 lg:grid-cols-3">
                <div class="rounded-2xl border border-navy-100 bg-white p-3.5">
                  <p class="mb-2 flex items-center justify-between font-mono text-[10px] uppercase tracking-wider text-[#9CA3AF]"><span>Top countries by organic traffic</span><span>&lt;CountryBars /&gt;</span></p>
                  <ul class="space-y-1"><template x-for="c in seoCountries" :key="c.n"><li><button type="button" @click="touch(c.n, c.a, ['Reading traffic for ' + c.n, 'Comparing with other countries'], c.n, c.a)" class="grid w-full grid-cols-[1.5rem_6.2rem_1fr_2.6rem] items-center gap-2 rounded-lg px-1.5 py-1.5 text-left text-[11.5px] hover:bg-[#76B900]/10"><span class="block w-6 overflow-hidden rounded-sm"><span class="block" :style="crop('seo', c.fx, c.fy, c.fw, c.fh)"></span></span><span class="truncate text-[#111827]" x-text="c.n"></span><span class="flex items-center gap-1.5"><span class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-100"><i class="block h-full rounded-full bg-[#76B900]" :style="'width:' + (c.v / 40 * 100) + '%'"></i></span><span class="w-9 text-right text-[10.5px] text-[#6B7280]" x-text="c.v + '%'"></span></span><span class="text-right text-[#374151]" x-text="c.s"></span></button></li></template></ul>
                </div>
