                <div x-show="counting && !paused && autoplay" style="display:none" class="flex items-center justify-between gap-3 rounded-lg bg-slate-50 px-3 py-2 text-[11.5px] text-[#6B7280]"><span>Not exploring? Another example plays shortly.</span><button type="button" @click="stay()" class="shrink-0 font-mono text-[10px] uppercase tracking-wider text-[#3d6600] hover:underline">Stay here</button></div>
              </div>

              {# right: the live panel the agent rebuilds on every choice #}
              <div class="assemble assemble-2" :class="(!flast && !gen && !result && !building) ? 'lg:self-stretch' : 'lg:sticky lg:top-0'">
                <div class="flex flex-col overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-sm" :class="(!flast && !gen && !result && !building) ? 'lg:h-full' : ''">
                  <div class="flex items-center justify-between border-b border-navy-100 px-3.5 py-2"><span class="flex items-center gap-1.5 font-mono text-[9.5px] uppercase tracking-wider" :class="gen ? 'text-[#5a9100]' : 'text-[#9CA3AF]'"><i class="h-1.5 w-1.5 rounded-full" :class="gen || building ? 'animate-pulse bg-[#76B900]' : 'bg-slate-300'"></i><span x-text="result ? 'Your itinerary' : (gen ? 'Generating' : 'Live preview')"></span></span><span class="font-mono text-[9.5px] text-[#9CA3AF]" x-text="result ? '<Itinerary />' : '<ExperienceCard />'"></span></div>

                  <div x-show="!flast && !gen && !result && !building" class="flex flex-1 flex-col gap-4 p-5">
                    <div class="grid grid-cols-2 gap-2"><template x-for="e in exps" :key="'m' + e.n"><span class="block overflow-hidden rounded-xl opacity-90"><span class="block" :style="expArt(e.n, 16, 6)"></span></span></template></div>
                    <div><p class="text-[16px] font-medium text-[#111827]">Your trip builds here as you answer</p><p class="mt-0.5 text-[12.5px] text-[#6B7280]">Four quick taps, no typing. Each answer adds to the plan.</p></div>
                    <ol class="mt-3 grid grid-cols-2 gap-2"><template x-for="(t, i) in fsteps" :key="'h' + t"><li class="flex items-center gap-2.5 rounded-xl border px-2.5 py-2 transition-colors" :class="i === 0 ? 'border-[#76B900]/50 bg-[#76B900]/[0.06]' : 'border-navy-100'"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full font-mono text-[11px]" :class="i === 0 ? 'bg-[#76B900] text-white' : 'bg-slate-100 text-[#6B7280]'" x-text="i + 1"></span><span class="min-w-0 flex-1"><span class="block text-[13px] font-medium text-[#111827]" x-text="t"></span><span class="block text-[11.5px] text-[#6B7280]" x-text="fstepHints[i]"></span></span></li></template></ol>
                  </div>

                  <div x-show="(building && !result) || gen" style="display:none" class="space-y-2.5 p-4"><div class="gu-shim aspect-[16/9] rounded-xl"></div><div class="gu-shim h-3 w-2/3 rounded"></div><div class="gu-shim h-3 w-1/2 rounded"></div><p class="font-mono text-[10px] uppercase tracking-wider text-[#5a9100]" x-text="gen ? genMsg : 'Updating the preview...'"></p></div>

                  <template x-if="flast && !building && !gen && !result"><div class="assemble">
                    <div class="relative" :style="expArt(flast, 16, 7)"><div class="absolute inset-0" style="background:linear-gradient(0deg,rgba(15,23,42,.82) 0%,rgba(15,23,42,.35) 45%,rgba(15,23,42,0) 70%)"></div><div class="absolute inset-x-4 bottom-3 text-white" style="text-shadow:0 1px 8px rgba(0,0,0,.45)"><p class="font-mono text-[9.5px] uppercase tracking-wider text-white/75" x-text="info.tag"></p><p class="text-[20px] font-medium leading-tight text-white" x-text="flast"></p></div></div>
                    <div class="p-4">
                      <p class="text-[13.5px] leading-relaxed text-[#374151]" x-text="info.d"></p>
