    var frame = document.getElementById('gu-frame'), outside = document.getElementById('gu-outside'),
        ring = document.getElementById('gu-ring'), previewCard = document.getElementById('gu-preview-card'),
        univ = document.getElementById('gu-universe'), cue = document.getElementById('gu-exit'),
