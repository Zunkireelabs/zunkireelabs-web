                    <div class="grid grid-cols-3 gap-2"><template x-for="pl in places" :key="pl"><button type="button" @click="togglePlace(pl)" :aria-pressed="fplaces.includes(pl)" class="group relative overflow-hidden rounded-2xl text-left transition-all duration-300" :class="fplaces.includes(pl) ? 'shadow-lg ring-[3px] ring-[#76B900]' : 'ring-1 ring-navy-100 hover:-translate-y-0.5 hover:shadow-lg'"><div class="transition-transform duration-500 group-hover:scale-105" :style="art(pl, placeExp(pl), 4, 5)"></div><span class="absolute inset-0" style="background:linear-gradient(0deg,rgba(15,23,42,.8) 0%,rgba(15,23,42,.15) 45%,rgba(15,23,42,0) 65%)"></span><span class="absolute inset-x-2.5 bottom-2" style="text-shadow:0 1px 6px rgba(0,0,0,.4)"><span class="block text-[14px] font-semibold leading-tight text-white" x-text="pl"></span><span class="block text-[10.5px] leading-tight text-white/80" x-text="placeLine[pl]"></span></span><span class="absolute right-2 top-2 flex h-6 w-6 items-center justify-center rounded-full border-2 font-mono text-[11px] font-bold transition-all" :class="fplaces.includes(pl) ? 'border-[#76B900] bg-[#76B900] text-white' : 'border-white/90 bg-black/25 text-transparent group-hover:bg-black/40'" x-text="fplaces.includes(pl) ? orderedPlaces.indexOf(pl) + 1 : ''"></span></button></template></div>
                    <p x-show="err" style="display:none" class="text-[12px] text-red-600" x-text="err"></p>
                    <button type="button" data-cont @click="advance(2)" :disabled="!fplaces.length" class="w-full rounded-xl bg-[#76B900] px-4 py-2.5 font-mono text-[12px] uppercase tracking-wider text-white shadow-lg shadow-[#76B900]/30 transition-colors hover:bg-[#5a9100] disabled:cursor-not-allowed disabled:bg-navy-100 disabled:text-[#9CA3AF] disabled:shadow-none" x-text="fplaces.length ? (shown[3] ? 'Done' : 'Continue') + ' →' : 'Pick at least one place to continue'"></button>
                  </div>
                  <div x-show="compact(2)" style="display:none" class="rounded-xl border border-navy-100 bg-white p-2.5">
                    <div class="mb-2 flex items-center justify-between px-0.5"><span class="font-mono text-[9.5px] uppercase tracking-wider text-[#3d6600]">&#10003; Places</span><button type="button" @click="fedit = 2" class="font-mono text-[9.5px] uppercase tracking-wider text-[#9CA3AF] hover:text-[#111827]">Edit</button></div>
                    <div class="flex flex-wrap gap-1.5"><template x-for="pl in places" :key="'c' + pl"><button type="button" @click="togglePlace(pl)" :aria-pressed="fplaces.includes(pl)" class="flex items-center gap-1.5 rounded-lg border py-1 pl-1 pr-2.5 text-[12px] transition-colors" :class="fplaces.includes(pl) ? 'border-[#76B900] bg-[#76B900]/10 text-[#2f5200]' : 'border-navy-100 text-navy-500 hover:border-[#76B900]/60'"><span class="block w-9 overflow-hidden rounded-md"><span class="block" :style="art(pl, placeExp(pl), 4, 3)"></span></span><span x-text="pl"></span></button></template></div>
                  </div>
                </section>

                {# 3. days, added once a place is picked #}
                <div x-show="adding === 3" style="display:none" class="space-y-2 rounded-xl border border-dashed border-[#76B900]/40 p-3"><div class="gu-shim h-3 w-1/2 rounded"></div><div class="grid grid-cols-4 gap-2"><div class="gu-shim h-12 rounded-lg"></div><div class="gu-shim h-12 rounded-lg"></div><div class="gu-shim h-12 rounded-lg"></div><div class="gu-shim h-12 rounded-lg"></div></div><p class="font-mono text-[9.5px] uppercase tracking-wider text-[#5a9100]">Adding the next question...</p></div>
                <section data-fsec="3" x-show="sectionOn(3)" style="display:none" class="assemble space-y-3">
                  <div><p class="text-[15px] font-medium text-[#111827]" x-text="'How many days for ' + placesText + '?'"></p><p class="text-[12px] text-[#6B7280]" x-text="fdays ? daysHint : (orderedPlaces.length > 2 ? 'Three places fit best in 7 days or more.' : 'Pick a length. I split the days between your places.')"></p></div>
                  <div class="grid grid-cols-4 gap-2"><template x-for="d in [3, 5, 7, 10]" :key="d"><button type="button" @click="pickDays(d)" :aria-pressed="fdays === d" class="relative rounded-xl border-2 bg-white px-2 py-3 text-center transition-all duration-300" :class="fdays === d ? 'border-[#76B900] bg-[#76B900]/10 shadow-md' : 'border-navy-100 hover:-translate-y-0.5 hover:border-[#76B900]/60'"><span x-show="d === bestDays" class="absolute -top-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-[#76B900] px-1.5 py-px font-mono text-[8px] uppercase tracking-wider text-white">Best fit</span><span class="block text-[22px] font-semibold leading-none text-[#111827]" x-text="d"></span><span class="mt-1 block font-mono text-[9.5px] uppercase tracking-wider text-[#6B7280]">days</span></button></template></div>
                  <p x-show="tight" style="display:none" class="text-[12px] text-amber-700" x-text="'Tight: ' + fdays + ' days across ' + fplaces.length + ' places means a lot of travel.'"></p>
