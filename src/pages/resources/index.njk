            <input
              type="text"
              x-model="searchQuery"
              @input="filterResources()"
              placeholder="Search..."
              class="flex-1 bg-transparent px-4 py-3 text-[14px] text-[#111827] placeholder:text-navy-300 focus:outline-none"
            />
            <button class="flex items-center justify-center px-4 text-navy-400 transition-colors hover:text-sky-700" aria-label="Search">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </div>

          {# Resource Type Filter #}
          <div class="mb-6 rounded-xl border border-navy-100/60">
            <button
              @click="filterOpen = !filterOpen"
              class="flex w-full items-center justify-between px-4 py-3"
              :aria-expanded="filterOpen"
            >
              <span class="font-mono text-[11px] font-medium uppercase tracking-wider text-navy-400">Resource Type</span>
              <div class="flex items-center gap-2">
                <span
                  x-show="selectedTypes.length > 0"
                  x-text="selectedTypes.length"
                  class="flex h-5 w-5 items-center justify-center rounded-full bg-sky-100 text-[11px] font-medium text-sky-700"
                ></span>
                <svg
                  class="h-4 w-4 text-navy-400 transition-transform"
                  :class="{ 'rotate-180': filterOpen }"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
                </svg>
              </div>
            </button>

            <div x-show="filterOpen" x-collapse class="space-y-3 px-4 pb-4">
              <template x-for="type in resourceTypes" :key="type.value">
                <label class="group flex cursor-pointer items-center gap-3">
                  <input
                    type="checkbox"
                    :value="type.value"
                    x-model="selectedTypes"
                    @change="filterResources()"
                    class="h-4 w-4 rounded border-navy-200 text-sky-600 focus:ring-sky-500 focus:ring-offset-0"
                  />
                  <span class="text-[14px] text-navy-500 transition-colors group-hover:text-[#111827]" x-text="type.label"></span>
                </label>
              </template>
            </div>
          </div>

          {# Clear All #}
          <button
            x-show="selectedTypes.length > 0 || searchQuery.length > 0"
            @click="clearFilters()"
            class="mb-8 flex items-center gap-2 text-[13px] text-navy-400 transition-colors hover:text-[#111827]"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Clear all
          </button>

          {# Subscribe CTA — was linking out to the full multi-field /contact/
             form (name, phone, city, country, message) for what should be a
             one-field newsletter signup. Now a real inline email-only form,
             same /api/submit-lead proxy every other form on the site uses.
             On success, redirects to /resources/welcome/ (only on a genuine
             2xx response — a failed submission falls into the catch block
             below and never redirects). #}
          <div
            x-data="{
              step: 1,
              email: '',
              firstName: '',
              lastName: '',
              submitting: false,
              submitted: false,
              error: false,
              alreadySubscribed: false,
              // 'Already subscribed' only applies on the live site. Local and LAN addresses
              // skip it so signup can be tried again and again; add ?checkDuplicates=1 to
              // the URL to switch it on while testing.
              dupCheckEnabled() {
                const h = location.hostname;
                const dev = /^(localhost|127\.|10\.|192\.168\.)/.test(h) || /\.local$/.test(h);
                return !dev || new URLSearchParams(location.search).get('checkDuplicates') === '1';
              },
              // Emails already subscribed from this browser, kept as SHA-256 hashes, never as plain text.
              async emailKey(email) {
                const data = new TextEncoder().encode(email.trim().toLowerCase());
                const buf = await crypto.subtle.digest('SHA-256', data);
                return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
              },
              knownKeys() {
                try { return JSON.parse(localStorage.getItem('zunkireeSubscribers') || '[]'); } catch (e) { return []; }
              },
              rememberEmail(key) {
                try {
                  const list = this.knownKeys().filter(k => k !== key);
                  list.push(key);
                  localStorage.setItem('zunkireeSubscribers', JSON.stringify(list.slice(-50)));
                } catch (e) {}
              },
              // True when the CRM says this email is already on the list.
              async looksDuplicate(res) {
                if (res.status === 409) return true;
                let text = '';
                try { text = await res.clone().text(); } catch (e) {}
                if (!res.ok) return /already|duplicate|exists/i.test(text);
                try { const j = JSON.parse(text); return !!(j && (j.duplicate === true || j.already_subscribed === true || j.already_exists === true)); } catch (e) { return false; }
              },
              async next() {
                const el = this.$refs.emailInput;
                if (!el.checkValidity() || !this.email.trim()) { el.reportValidity(); return; }
                if (this.dupCheckEnabled()) {
                  const key = await this.emailKey(this.email);
                  if (this.knownKeys().includes(key)) { this.alreadySubscribed = true; return; }
                }
                this.step = 2;
                this.$nextTick(() => this.$refs.firstNameInput && this.$refs.firstNameInput.focus());
              },
              async subscribe() {
                if (!this.firstName.trim()) return;
                this.submitting = true;
                this.error = false;
                try {
                  const res = await fetch('/api/submit-lead?form=newsletter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      first_name: this.firstName.trim(),
                      last_name: this.lastName.trim(),
                      email: this.email.trim()
                    })
                  });
                  if (this.dupCheckEnabled() && await this.looksDuplicate(res)) {
                    this.rememberEmail(await this.emailKey(this.email));
                    this.alreadySubscribed = true;
                    this.step = 1;
                    return;
                  }
                  if (!res.ok) throw new Error('Subscribe failed: ' + res.status);
                  if (this.dupCheckEnabled()) this.rememberEmail(await this.emailKey(this.email));
                  // Name and email go to the quiz results page for the thank-you
                  // box. sessionStorage (this tab only), not localStorage, because
                  // it is personal data.
                  try {
                    sessionStorage.setItem('zunkireeSubscriber', JSON.stringify({
                      firstName: this.firstName.trim(),
                      lastName: this.lastName.trim(),
                      email: this.email.trim()
                    }));
                  } catch (e) {}
                  this.submitted = true;
                  window.dispatchEvent(new CustomEvent('open-welcome-quiz', { detail: { firstName: this.firstName.trim() } }));
                } catch (err) {
                  console.error('[newsletter subscribe] error', err);
                  this.error = true;
                } finally {
                  this.submitting = false;
                }
              }
            }"
          >
            <template x-if="!submitted">
              <form x-show="!alreadySubscribed" @submit.prevent="step === 1 ? next() : subscribe()" class="space-y-2">
                <div x-show="step === 1" class="space-y-2">
                  <label for="newsletter-email" class="sr-only">Email address</label>
                  <input
                    type="email"
                    id="newsletter-email"
                    x-ref="emailInput"
                    x-model="email"
                    required
                    placeholder="you@company.com"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30"
                  >
                  <button
                    type="submit"
                    class="block w-full whitespace-nowrap rounded-md bg-[#76B900] px-4 py-2.5 text-center font-mono text-[12px] uppercase tracking-normal text-white transition-colors duration-200 hover:bg-[#5a9100]"
                  >
                    Subscribe to Newsletter
                  </button>
                </div>
                <div x-show="step === 2" x-cloak class="space-y-2">
                  <p class="text-[13px] leading-snug text-[#6B7280]">
                    One more step. Add your name to finish subscribing <span class="font-medium text-[#111827]" x-text="email"></span>.
                  </p>
                  <label for="newsletter-first-name" class="sr-only">First name</label>
                  <input
                    type="text"
                    id="newsletter-first-name"
                    x-ref="firstNameInput"
                    x-model="firstName"
                    autocomplete="given-name"
                    :required="step === 2"
                    placeholder="First name"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30"
                  >
                  <label for="newsletter-last-name" class="sr-only">Last name</label>
                  <input
                    type="text"
                    id="newsletter-last-name"
                    x-model="lastName"
                    autocomplete="family-name"
                    placeholder="Last name (optional)"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30"
                  >
                  <button
                    type="submit"
                    :disabled="submitting"
                    class="block w-full whitespace-nowrap rounded-md bg-[#76B900] px-4 py-2.5 text-center font-mono text-[12px] uppercase tracking-normal text-white transition-colors duration-200 hover:bg-[#5a9100] disabled:opacity-60"
                  >
                    <span x-show="!submitting">Finish subscribing</span>
                    <span x-show="submitting">Subscribing…</span>
                  </button>
                  <button type="button" @click="step = 1" class="block w-full text-center text-[12px] text-[#6B7280] underline hover:text-[#5a9100]">Use a different email</button>
                </div>
                <p x-show="error" x-cloak class="text-[12px] text-red-600">Something went wrong. Please try again.</p>
              </form>
            </template>
            <div x-show="alreadySubscribed" x-cloak class="rounded-md bg-[#F0F5E8] px-4 py-3.5 text-[13px] leading-snug text-[#3f6600]">
              <p class="font-semibold">You are already subscribed.</p>
              <p class="mt-1 text-[#5a9100]"><span class="break-all font-medium" x-text="email"></span> is already on our list, so there is nothing more to do. We will keep sending you new research and launches first.</p>
              <button type="button" @click="alreadySubscribed = false; step = 1; email = ''" class="mt-2 text-[12px] underline hover:text-[#3f6600]">Use a different email</button>
            </div>
            <p x-show="submitted" x-cloak class="rounded-md bg-[#F0F5E8] px-4 py-3.5 text-center text-[13px] font-medium text-[#5a9100]">
              You're subscribed — thanks!
            </p>
          </div>
        </div>
      </div>

      {# RIGHT - Resource Cards Grid #}
      <div class="lg:col-span-9">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6" data-reveal-stagger>
          {% for resource in resources.items %}
            <a
              href="/resources/{{ resource.slug }}/"
              class="resource-card group block overflow-hidden rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/60 via-sky-50/25 to-white/50 shadow-subtle backdrop-blur-sm transition-shadow duration-300 hover:shadow-card-hover"
              data-type="{{ resource.type }}"
              data-title="{{ resource.title }}"
              x-show="isVisible('{{ resource.type }}', '{{ resource.title | replace("'", "\\'") }}')"
              x-transition
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-navy-50">
                {% if resource.coverImage %}
                  <img
                    src="{{ resource.coverImage }}"
                    alt="{{ resource.title }}"
                    class="h-full w-full object-cover"
                    loading="lazy"
                  />
                {% else %}
                  <div class="relative flex h-full w-full items-center justify-center bg-navy-950">
                    <div
                      class="pointer-events-none absolute inset-0"
                      aria-hidden="true"
                      style="background: radial-gradient(ellipse 70% 70% at 100% 100%, rgba(118,185,0,0.2) 0%, transparent 60%);"
                    ></div>
                    <span class="relative font-mono text-2xl font-bold uppercase tracking-tight text-white/15">{{ resource.type }}</span>
                  </div>
                {% endif %}
              </div>

              <div class="p-5">
                <p class="mb-3">
                  <span class="inline-flex items-center rounded-full border border-sky-300/40 bg-sky-100/60 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-sky-700">{{ resource.type }}</span>
                </p>

                <h3 class="mb-6 text-[15.5px] font-medium leading-snug text-[#111827] line-clamp-2">
                  {{ resource.title }}
                </h3>

                <span class="inline-flex items-center gap-1.5 text-[13px] font-medium text-sky-700 transition-all group-hover:gap-2.5">
                  Read now
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </span>
              </div>
            </a>
          {% endfor %}
        </div>

        {# No Results Message #}
        <div
          x-show="filteredCount === 0"
          x-transition
          class="py-16 text-center"
        >
          <p class="text-navy-400">No resources match your filters.</p>
          <button @click="clearFilters()" class="mt-4 font-medium text-sky-700 hover:text-sky-800">
            Clear filters
          </button>
        </div>

        {# Pagination Footer #}
        <div class="mt-12 flex items-center justify-between border-t border-navy-100/50 pt-8" data-reveal>
          <div class="flex items-center gap-3">
            <span class="text-[14px] text-navy-500">Page</span>
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-navy-950 font-mono text-[13px] font-medium text-white">
              1
            </span>
          </div>

          <div>
            <span class="font-mono text-[12px] uppercase tracking-wide text-navy-400" x-text="'Showing 1-' + filteredCount + ' of ' + {{ resources.items | length }} + ' resources'">
              Showing 1-{{ resources.items | length }} of {{ resources.items | length }} resources
            </span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function resourceFilter() {
    return {
      searchQuery: '',
      selectedTypes: [],
      filterOpen: true,
      filteredCount: {{ resources.items | length }},
      resourceTypes: [
        { value: 'EBOOK', label: 'eBooks' },
        { value: 'GUIDE', label: 'Guides' },
        { value: 'REPORT', label: 'Reports' },
        { value: 'CASE STUDY', label: 'Case Studies' },
        { value: 'WHITEPAPER', label: 'Whitepapers' }
      ],

      initFromQuery() {
        const params = new URLSearchParams(window.location.search);
        const type = params.get('type');
        const typeMap = { 'case-study': 'CASE STUDY', 'ebook': 'EBOOK', 'guide': 'GUIDE', 'report': 'REPORT', 'whitepaper': 'WHITEPAPER' };
        if (type && typeMap[type]) {
          this.selectedTypes = [typeMap[type]];
        }
        this.filterResources();
      },

      isVisible(type, title) {
        const typeMatch = this.selectedTypes.length === 0 || this.selectedTypes.includes(type);
        const searchMatch = this.searchQuery === '' ||
          title.toLowerCase().includes(this.searchQuery.toLowerCase());
        return typeMatch && searchMatch;
      },

      filterResources() {
        this.$nextTick(() => {
          const cards = document.querySelectorAll('.resource-card');
          let count = 0;
          cards.forEach(card => {
            if (window.getComputedStyle(card).display !== 'none') count++;
          });
          this.filteredCount = count;
        });
      },

      clearFilters() {
        this.searchQuery = '';
        this.selectedTypes = [];
        this.filterResources();
      }
    }
  }
</script>

{# =====================================================
   SECTION 4: FAQ
   Same structure/tokens as homepage-v2's FAQ section: centered
   mono eyebrow + H2, flat divide-y question list (no per-item
   card chrome), plus-circle toggle. Content is this page's own
   `faq` global data (unchanged), reformatted to the homepage-v2
   layout rather than the card-accordion treatment used before.
   ===================================================== #}
<section class="bg-white px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="resources-faq-heading">
  <div class="mx-auto max-w-content">
    <div class="mx-auto mb-10 max-w-2xl text-center md:mb-12" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Support
      </span>
      <h2 id="resources-faq-heading" class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Frequently asked questions
      </h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for item in faq %}
          <div class="py-5">
            <button
              @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
              class="group flex w-full items-center justify-between gap-4 text-left"
              :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
              aria-controls="resources-faq-answer-{{ loop.index }}"
            >
              <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
                {{ item.question }}
              </span>
              <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </button>
            <div
              id="resources-faq-answer-{{ loop.index }}"
              x-show="activeIndex === {{ loop.index }}"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-2"
              class="overflow-hidden"
            >
              <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">{{ item.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

