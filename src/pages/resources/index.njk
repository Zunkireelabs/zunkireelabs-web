{% set bannerResource = resources.items | find("slug", resources.featuredBanner) %}

{# =====================================================
   HERO — same shell as customer-stories/about/contact:
   mono eyebrow chip + headline + supporting copy, centered
   single column.
   ===================================================== #}
<section class="relative px-4 pb-10 pt-32 sm:px-6 sm:pt-36 sm:pb-14 lg:px-8 lg:pt-40 lg:pb-16" aria-labelledby="hero-heading">
