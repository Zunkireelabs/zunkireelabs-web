                  class="group flex w-full items-center justify-between gap-4 px-5 py-4 text-left"
                  :aria-expanded="activeIndex === {{ loop.index }}"
                >
                  <span class="text-[15.5px] font-medium text-[#111827] transition-colors group-hover:text-[#5a9100]">
                    {{ item.question }}
                  </span>
                  <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-navy-50 text-navy-400">
                    <svg
                      class="h-4 w-4 transition-transform duration-200"
                      :class="{ 'rotate-45': activeIndex === {{ loop.index }} }"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  </span>
                </button>
                <div
                  x-show="activeIndex === {{ loop.index }}"
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 -translate-y-2"
                  x-transition:enter-end="opacity-100 translate-y-0"
                  class="overflow-hidden"
                >
                  <p class="px-5 pb-5 leading-relaxed text-navy-400">
                    {{ item.answer }}
                  </p>
                </div>
              </div>
              {% endfor %}
