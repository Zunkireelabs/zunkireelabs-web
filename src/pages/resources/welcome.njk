{# =====================================================
   HERO — same shell as resources/index.njk / contact.njk.
   ===================================================== #}
<section class="relative px-4 pb-10 pt-32 sm:px-6 sm:pt-36 sm:pb-14 lg:px-8 lg:pt-40 lg:pb-16" aria-labelledby="hero-heading">
  <div class="mx-auto max-w-5xl">
    <div class="max-w-2xl" data-reveal-stagger>
      <span class="mb-5 inline-flex items-center rounded-full border border-navy-100/60 bg-white px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-500 shadow-subtle">
        Subscribed
      </span>
      <h1 id="hero-heading" class="mb-5 text-balance text-[38px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
        You're in — let's find your opportunities
      </h1>
      <p class="text-[18px] leading-relaxed text-[#6B7280] sm:text-[19px]">
