{% set careersFaq = [
  {
    question: "What types of AI jobs are available in Kathmandu, Nepal?",
    answer: "The page does not specify particular AI jobs available in Kathmandu, Nepal."
  },
  {
    question: "How can I learn about AI job opportunities in Kathmandu?",
    answer: "The page does not provide specific resources or information on learning about AI job opportunities in Kathmandu."
  },
  {
    question: "What industries in Nepal are adopting AI?",
    answer: "According to the page, industries such as Healthcare, Manufacturing, Legal, Professional Services, Education, and Human Resources are embracing AI."
  },
  {
    question: "What services does Zunkiree offer related to AI?",
    answer: "Zunkiree offers various AI services including AI development, customer experience through intelligent chatbots, and custom software solutions."
  },
  {
    question: "Is there a report available about AI adoption in Nepal?",
    answer: "Yes, there is a featured report titled 'State of AI in Nepal 2026' available for download on the page."
