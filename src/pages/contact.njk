                </svg>
              </span>
            </a>

            {# Resources #}
            <a href="/resources/" class="group flex items-start justify-between gap-3 border-t border-navy-100/60 pt-6">
              <div>
                <span class="text-[15px] font-medium text-[#111827] transition-colors group-hover:text-navy-600">Resources</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">Documentation, guides, and case studies</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100] transition-colors duration-200 group-hover:bg-[#76B900] group-hover:text-white" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>

            {# Our Location #}
            <div class="flex items-start justify-between gap-3 border-t border-navy-100/60 pt-6">
              <div>
                <span class="text-[15px] font-medium text-[#111827]">Our Location</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">{{ site.address.city }}, {{ site.address.country }}</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100]" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
