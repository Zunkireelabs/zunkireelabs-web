---
layout: base.njk
title: "Our Team | AI Engineers & Data Scientists | Zunkiree Labs"
description: "Meet the team behind Zunkiree Labs. AI engineers, data scientists, and software developers building intelligent platforms from Kathmandu, Nepal."
permalink: /team/
hideChrome: true
bodyClass: "v2-inter"
---

{# =====================================================
   PERSON SCHEMA MARKUP
   E-E-A-T signals for expertise and authority
   ===================================================== #}
{% for member in team %}
{% if member.featured %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "{{ site.url }}/team/#{{ member.id }}",
  "name": "{{ member.name }}",
  "jobTitle": "{{ member.role }}",
  "description": "{{ member.bio | replace('"', '\\"') }}",
  "worksFor": {
    "@type": "Organization",
    "name": "Zunkiree Labs",
    "@id": "{{ site.url }}/#organization"
  },
  "knowsAbout": [
    {% for skill in member.expertise %}"{{ skill }}"{% if not loop.last %}, {% endif %}{% endfor %}
  ],
  {% if member.social.linkedin %}"sameAs": ["{{ member.social.linkedin }}"{% if member.social.github %}, "{{ member.social.github }}"{% endif %}],{% endif %}
  "image": "{{ site.url }}{{ member.image }}"
}
</script>
{% endif %}
{% endfor %}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
</style>

{# =====================================================
   HERO — same breadcrumb + eyebrow + H1 + subhead shell used
   by service.njk/product-v2.njk's hero. pt-32/36/44 clears
   navbar-v2's fixed 72px bar.
   ===================================================== #}
<section class="relative overflow-hidden px-4 pt-32 pb-6 text-center sm:px-6 sm:pt-36 sm:pb-8 lg:px-8 lg:pt-44" aria-labelledby="team-hero-heading">
  <div class="relative z-10 mx-auto max-w-[56rem]" data-reveal-stagger>
    <nav class="mb-8 flex flex-wrap items-center justify-center gap-2 font-mono text-[11px] uppercase tracking-wider text-navy-400" aria-label="Breadcrumb">
      <a href="/" class="transition-colors duration-200 hover:text-[#5a9100]">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/about/" class="transition-colors duration-200 hover:text-[#5a9100]">About</a>
      <span aria-hidden="true">/</span>
      <span class="truncate text-navy-500">Team</span>
    </nav>

    <h1 id="team-hero-heading" class="mx-auto max-w-3xl text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[44px] lg:text-[54px]">
      Building AI from Kathmandu
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-body-lg leading-relaxed text-[#6B7280]">
      We're a team of engineers, data scientists, and AI specialists building intelligent software platforms. Based in Nepal with a global mindset, we combine deep technical expertise with practical business understanding.
    </p>
  </div>
</section>

{# =====================================================
   LEADERSHIP — founder card, V2 soft-elevation shell
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Leadership</span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">Meet the founder</h2>
    </div>

    {% for member in team %}
    {% if member.featured %}
    <div class="rounded-2xl border border-navy-100/50 bg-white p-6 shadow-subtle sm:p-8" data-reveal>
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
        {# Image #}
        <div class="lg:col-span-4">
          <div class="aspect-[3/4] overflow-hidden rounded-xl bg-navy-50">
            <img
              src="{{ member.image }}"
              alt="{{ member.name }}"
              class="h-full w-full object-cover object-[30%_center] grayscale transition-all duration-500 hover:grayscale-0"
              loading="lazy"
            />
          </div>
        </div>

        {# Content #}
        <div class="lg:col-span-8">
          <h3 class="mb-1 text-[24px] font-semibold leading-snug text-[#111827] sm:text-[28px]">{{ member.name }}</h3>
          <p class="mb-6 font-medium text-[#5a9100]">{{ member.role }}</p>

          <p class="mb-8 text-[16px] leading-relaxed text-[#6B7280] sm:text-[17px]">
            {{ member.bio }}
          </p>

          {# Expertise Tags #}
          <div class="mb-8">
            <p class="mb-3 font-mono text-[11px] font-medium uppercase tracking-wider text-navy-400">Areas of Expertise</p>
            <div class="flex flex-wrap gap-2">
              {% for skill in member.expertise %}
              <span class="rounded-full border border-navy-100 bg-navy-50/60 px-3 py-1.5 text-[13px] text-navy-700">
                {{ skill }}
              </span>
              {% endfor %}
            </div>
          </div>

          {# Social Links #}
          {% if member.social %}
          <div class="flex items-center gap-4">
            {% if member.social.linkedin %}
            <a href="{{ member.social.linkedin }}" class="inline-flex items-center gap-2 text-navy-500 transition-colors hover:text-[#5a9100]" target="_blank" rel="noopener noreferrer">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            {% endif %}
            {% if member.social.github %}
            <a href="{{ member.social.github }}" class="inline-flex items-center gap-2 text-navy-500 transition-colors hover:text-[#5a9100]" target="_blank" rel="noopener noreferrer">
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            {% endif %}
          </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}
  </div>
</section>

{# =====================================================
   TEAM SECTIONS — department cards, V2 benefit-card shell
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Our Teams</span>
      <h2 class="text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">Expertise across disciplines</h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2" data-reveal-stagger>
      {% for member in team %}
      {% if not member.featured %}
      <div class="rounded-2xl border border-navy-100/50 bg-white p-6 shadow-subtle transition-all duration-300 hover:border-[#76B900]/30 hover:shadow-md sm:p-8">
        <h3 class="mb-2 text-[19px] font-semibold leading-snug text-[#111827]">{{ member.name }}</h3>
        <p class="mb-4 text-[14px] font-medium text-[#5a9100]">{{ member.role }}</p>
        <p class="mb-6 text-[14px] leading-relaxed text-[#6B7280]">
          {{ member.bio }}
        </p>
        <div class="flex flex-wrap gap-2">
          {% for skill in member.expertise %}
          <span class="rounded-full bg-navy-50/60 px-2.5 py-1 text-[12px] text-navy-600">
            {{ skill }}
          </span>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{# =====================================================
   CULTURE & VALUES
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">Culture</span>
        <h2 class="mb-6 text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px]">How we work</h2>
        <div class="space-y-4 text-[16px] leading-relaxed text-[#6B7280]">
          <p>
            We believe great software can come from anywhere. Based in Kathmandu, we've built a culture that combines Nepali craftsmanship with global engineering standards.
          </p>
          <p>
            Our team values deep work, continuous learning, and ownership. We don't just write code&mdash;we solve problems and build products that make a difference.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-reveal-stagger>
