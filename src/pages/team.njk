            </svg>
          </div>
          <h3 class="mb-1 text-[15px] font-semibold text-[#111827]">Ownership</h3>
          <p class="text-[13px] leading-relaxed text-[#6B7280]">Every team member takes responsibility for their work</p>
        </div>

        <div class="rounded-2xl border border-navy-100/50 bg-white p-5 shadow-subtle">
