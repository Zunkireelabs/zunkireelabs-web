---
layout: "base.njk"
permalink: "/cookie-preferences/"
title: "Cookie Preferences | Zunkiree Labs"
description: "Choose which cookies Zunkiree Labs may set on your device, and update your choices at any time."
templateEngineOverride: "njk, md"
---

<div
  class="container-custom py-12 md:py-20 max-w-3xl"
  x-data="{
    analytics: true,
    marketing: true,
    saved: false,
    init() {
      try {
        const raw = localStorage.getItem('zunkiree-cookie-consent');
        if (raw) {
          const stored = JSON.parse(raw);
          if (stored && typeof stored === 'object') {
            if (stored.analytics === false) this.analytics = false;
            if (stored.marketing === false) this.marketing = false;
          }
        }
      } catch (e) {}
    },
    save() {
      try {
        localStorage.setItem('zunkiree-cookie-consent', JSON.stringify({ analytics: this.analytics, marketing: this.marketing, updatedAt: new Date().toISOString() }));
      } catch (e) {}
      this.saved = true;
      setTimeout(() => { window.location.reload(); }, 600);
    }
  }"
>

<h1 class="text-4xl sm:text-5xl md:text-[56px] font-normal tracking-tight leading-[1.1] text-gray-900 mb-4">Cookie Preferences</h1>

<p class="text-lg text-gray-600 leading-relaxed mb-10">Choose which cookies Zunkiree Labs may set on your device, and update your choices at any time. Necessary cookies always stay on since they keep the site working; the categories below are yours to choose. Changes take effect immediately on this device — see our <a href="/cookie-policy/" class="text-zunkiree-600 hover:underline">Cookie Policy</a> for what each category actually does.</p>

<div class="space-y-4">

  <div class="flex items-start justify-between gap-6 rounded-lg border border-gray-200 bg-gray-50 px-5 py-5">
    <div>
      <p class="font-medium text-gray-900 mb-1">Necessary</p>
      <p class="text-sm text-gray-600 leading-relaxed">Required for the site to function. Always on.</p>
    </div>
    <span class="mt-1 inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full bg-gray-300 px-0.5" aria-hidden="true">
      <span class="h-5 w-5 translate-x-5 rounded-full bg-white shadow"></span>
    </span>
  </div>

  <div class="flex items-start justify-between gap-6 rounded-lg border border-gray-200 px-5 py-5">
    <div>
      <p class="font-medium text-gray-900 mb-1">Analytics</p>
      <p class="text-sm text-gray-600 leading-relaxed">Google Analytics (GA4) — helps us understand how visitors use the site.</p>
    </div>
    <button
      type="button"
      role="switch"
      :aria-checked="analytics.toString()"
      @click="analytics = !analytics"
      class="mt-1 inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full px-0.5 transition-colors duration-200"
      :class="analytics ? 'bg-[#76B900]' : 'bg-gray-300'"
    >
      <span class="h-5 w-5 rounded-full bg-white shadow transition-transform duration-200" :class="analytics ? 'translate-x-5' : 'translate-x-0'"></span>
    </button>
  </div>

  <div class="flex items-start justify-between gap-6 rounded-lg border border-gray-200 px-5 py-5">
    <div>
      <p class="font-medium text-gray-900 mb-1">Marketing</p>
      <p class="text-sm text-gray-600 leading-relaxed">Meta/Facebook Pixel — used for ad conversions and retargeting.</p>
    </div>
    <button
      type="button"
      role="switch"
      :aria-checked="marketing.toString()"
      @click="marketing = !marketing"
      class="mt-1 inline-flex h-6 w-11 flex-shrink-0 items-center rounded-full px-0.5 transition-colors duration-200"
      :class="marketing ? 'bg-[#76B900]' : 'bg-gray-300'"
    >
      <span class="h-5 w-5 rounded-full bg-white shadow transition-transform duration-200" :class="marketing ? 'translate-x-5' : 'translate-x-0'"></span>
    </button>
  </div>

</div>

<button
  type="button"
  @click="save()"
  class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 font-mono text-[13px] uppercase tracking-wide text-white transition-colors duration-200 hover:bg-[#5a9100]"
>
  <span x-text="saved ? 'Saved' : 'Save preferences'"></span>
</button>

</div>
