                  <span class="text-[14px] text-[#374151]">{{ bullet | safe }}</span>
                </li>
              {% endfor %}
            </ul>

            {% if entry.link %}
              <a href="{{ entry.link.href }}" class="mb-6 inline-flex items-center gap-2 font-medium text-[#5a9100] transition-all duration-200 hover:gap-3">
                {{ entry.link.label }}
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            {% endif %}

            <div class="max-w-xl overflow-hidden rounded-xl border border-navy-100/60 shadow-subtle {% if entry.link %}mt-6{% endif %}">
              <div class="aspect-[16/10] overflow-hidden">
                <img src="{{ entry.image }}" alt="{{ entry.imageAlt }}" class="h-full w-full object-cover" loading="lazy">
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

