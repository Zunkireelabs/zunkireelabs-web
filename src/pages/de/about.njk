        {% for entry in aboutJourney %}
          <div class="relative {% if not loop.last %}pb-14 sm:pb-16{% endif %}">
            {# Dot sits ON the connecting line: the line lives at x=0 of the
               OUTER pl-8/pl-10 container, but this entry is already inset by
               that padding, so the dot must offset back out by the exact
               padding amount (-left-8 / sm:-left-10) before centering on it —
               using left-0 here landed the dot on top of the year text instead. #}
            <span class="absolute -left-8 top-1 h-3 w-3 -translate-x-1/2 rounded-full border-2 border-white bg-[#76B900] ring-4 ring-white sm:-left-10" aria-hidden="true"></span>

            <span class="mb-3 inline-flex items-center rounded-full bg-[#76B900]/10 px-2.5 py-1 font-mono text-[12px] font-semibold uppercase tracking-wider text-[#5a9100]">{{ entry.year }}</span>
