<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="journey-heading">
  <div class="mx-auto max-w-5xl">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      {# Sticky intro column — pins under the navbar while the
         timeline column scrolls past it. #}
