{# =====================================================
   CONTACT — WEBSITE V2
   Rebuilt to sit on the same visual system as homepage-v2.njk /
   industry.njk / product-v2.njk: navbar-v2 + footer-v2 chrome,
   Inter type, flat #F8FAFC body, navy/#76B900 token language,
   glass-surface cards, font-mono uppercase labels.

   Contact form is a native form (Alpine.js) posting to this site's
   own /api/submit-lead serverless function, which holds the real
   CRM bearer token server-side and forwards to edgex.zunkireelabs.com
   — see api/submit-lead.js. The token used to be hardcoded directly
   in this file's client-side JS, publicly readable via view-source;
   moved server-side 2026-09-28 after that was flagged as a real
   security issue. Quick-link destinations and site.* data bindings
   are unchanged.
   ===================================================== #}

{% include "partials/navbar-v2.njk" %}

<script>
  document.documentElement.classList.add('js-reveal-hidden');
</script>
<style>
  .js-reveal-hidden [data-reveal]:not(.revealed),
  .js-reveal-hidden [data-reveal-stagger]:not(.revealed) > * {
    opacity: 0;
  }
  /* Country-code dropdown list already scrolls (max-h-64 overflow-y-auto) —
     macOS/most browsers just hide the scrollbar until actively scrolling,
     so it read as cut-off/broken. Force it visible as a thin track instead. */
  .country-scroll {
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
  }
  .country-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .country-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .country-scroll::-webkit-scrollbar-thumb {
    background-color: #d1d5db;
    border-radius: 9999px;
  }
</style>

{# =====================================================
   HERO — centered single-column, same shell as industry.njk's
   secondary-page hero (plain white ground, no bg image — this is
   a utility page, not a re-run of the homepage's signature visual).
   ===================================================== #}
<section class="relative flex flex-col items-center justify-center px-4 pb-8 pt-32 sm:px-6 sm:pt-36 lg:px-8 lg:pt-40" aria-labelledby="hero-heading">
  <div class="relative z-10 mx-auto flex max-w-[56rem] flex-col items-center text-center" data-reveal-stagger>

    <span class="mb-4 inline-flex items-center rounded-full border border-navy-100/60 bg-white px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-wider text-navy-500 shadow-subtle">
      Contact
    </span>

    <h1 id="hero-heading" class="text-center text-balance text-[34px] font-medium leading-[1.15] tracking-tight text-[#111827] sm:text-[42px] sm:leading-[1.1] lg:text-[48px]">
      We horen graag van je
    </h1>

    <p class="mt-4 max-w-[560px] px-4 text-center text-balance text-[18px] font-medium leading-relaxed text-[#6B7280] sm:text-[20px]">
      Vul het formulier in en een teamlid van Zunkiree Labs neemt contact met je op.
    </p>
  </div>
</section>

{# =====================================================
   CONTACT FORM SECTION — glass-surface form card (left) +
   quick-links rail (right), reusing the same card recipe as
   homepage-v2's Platform Pillars / industry.njk's Flagship Proof
   (rounded-2xl, white/60 border, sky gradient wash, shadow-subtle).
   ===================================================== #}
<section class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8 lg:pb-24" aria-labelledby="contact-form-heading">
  <div class="mx-auto max-w-5xl">
    <h2 id="contact-form-heading" class="sr-only">Contactformulier en snelle links</h2>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-12" data-reveal-stagger>

      {# Left: Quick Links (2/5 width) #}
      <div class="lg:col-span-2 lg:order-1">
        <div class="rounded-2xl border border-navy-100/60 bg-white p-6 shadow-subtle sm:p-7">
          <span class="mb-6 block font-mono text-[11px] uppercase tracking-wider text-navy-500">
            Hulp nodig met iets specifieks?
          </span>

          <div class="space-y-6">
            {# Stuur een e-mail #}
            <a href="mailto:{{ site.email }}" class="group flex items-start justify-between gap-3">
              <div>
                <span class="text-[15px] font-medium text-[#111827] transition-colors group-hover:text-navy-600">Stuur een e-mail</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">Direct contact voor snelle vragen</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100] transition-colors duration-200 group-hover:bg-[#76B900] group-hover:text-white" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>

            {# Plan een gesprek #}
            <a href="/schedule-a-call/" class="group flex items-start justify-between gap-3 border-t border-navy-100/60 pt-6">
              <div>
                <span class="text-[15px] font-medium text-[#111827] transition-colors group-hover:text-navy-600">Plan een gesprek</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">Boek een kennismakingsgesprek met ons team</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100] transition-colors duration-200 group-hover:bg-[#76B900] group-hover:text-white" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>

            {# Resources #}
            <a href="/resources/" class="group flex items-start justify-between gap-3 border-t border-navy-100/60 pt-6">
              <div>
                <span class="text-[15px] font-medium text-[#111827] transition-colors group-hover:text-navy-600">Bronnen</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">Documentatie, gidsen en casestudy's</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100] transition-colors duration-200 group-hover:bg-[#76B900] group-hover:text-white" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>

            {# Onze locatie #}
            <div class="flex items-start justify-between gap-3 border-t border-navy-100/60 pt-6">
              <div>
                <span class="text-[15px] font-medium text-[#111827]">Onze locatie</span>
                <p class="mt-0.5 text-[13px] leading-relaxed text-[#6B7280]">{{ site.address.city }}, {{ site.address.country }}</p>
              </div>
              <span class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100]" aria-hidden="true">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </span>
            </div>
          </div>

          {# Social Links #}
          <div class="mt-8 border-t border-navy-100/60 pt-6">
            <p class="mb-4 font-mono text-[11px] uppercase tracking-wider text-navy-500">Volg ons</p>
            <div class="flex items-center gap-5 text-navy-400">
              <a href="{{ site.social.linkedin }}" class="transition-colors hover:text-navy-900" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="{{ site.social.github }}" class="transition-colors hover:text-navy-900" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
              </a>
            </div>
          </div>

        </div>
      </div>

      {# Right: Contact Form (3/5 width) — now a fully native form (Alpine.js)
         posting directly to the CRM's public submit API, so it no longer needs
         the outer glass-gradient shell that used to frame the uncontrollable
         CRM iframe. Field ids/payload keys (first_name, last_name, email,
         phone, country, how_would_you_like_to_connect_with_us,
         what_can_we_help_you_with, opt_in_for_marketing_communication) match
         the CRM-hosted contact-us form's own field schema 1:1. #}
      <div class="lg:col-span-3 lg:order-2">
        <div class="rounded-2xl border border-white/60 bg-gradient-to-br from-sky-100/70 via-sky-50/30 to-white/40 p-6 shadow-subtle backdrop-blur-md sm:p-8"
            x-data="{
              firstName: '',
              lastName: '',
              workEmail: '',
              countryCodes: {{ countryCodes | dump }},
              phoneCode: '+977',
              phoneCountryName: 'Nepal',
              phoneFlag: '🇳🇵',
              phone: '',
              city: '',
              country: '',
              connect: '',
              message: '',
              optIn: false,
              submitting: false,
              submitted: false,
              error: false,
              async submitContactForm() {
                if (!this.firstName.trim() || !this.lastName.trim() || !this.workEmail.trim() || !this.connect) return;
                this.submitting = true;
                this.error = false;
                try {
                  const res = await fetch('/api/submit-lead', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                      first_name: this.firstName.trim(),
                      last_name: this.lastName.trim(),
                      email: this.workEmail.trim(),
                      phone: this.phone.trim() ? (this.phoneCode + ' ' + this.phone.trim()) : null,
                      city: this.city.trim() || null,
                      country: this.country.trim() || null,
                      how_would_you_like_to_connect_with_us: this.connect,
                      what_can_we_help_you_with: this.message.trim() || null,
                      opt_in_for_marketing_communication: this.optIn
                    })
                  });
                  if (!res.ok) throw new Error('Submit failed: ' + res.status);
                  this.submitted = true;
                } catch (err) {
                  console.error('[contact form] submit error', err);
                  this.error = true;
                } finally {
                  this.submitting = false;
                }
              }
            }"
          >
            {# Success state #}
            <div x-show="submitted" x-cloak class="py-10 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-[#F0F5E8] text-[#5a9100]">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h3 class="text-[18px] font-medium text-[#111827]">Bedankt voor je bericht</h3>
              <p class="mt-1.5 text-[14px] leading-relaxed text-[#6B7280]">Een teamlid van Zunkiree Labs neemt binnenkort contact met je op.</p>
            </div>

            {# Form #}
            <form x-show="!submitted" @submit.prevent="submitContactForm()" novalidate>
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="first_name" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Voornaam <span class="text-[#76B900]">*</span></label>
                  <input type="text" id="first_name" x-model="firstName" required
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
                <div>
                  <label for="last_name" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Achternaam <span class="text-[#76B900]">*</span></label>
                  <input type="text" id="last_name" x-model="lastName" required
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
              </div>

              <div class="mt-5">
                <label for="work_email" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Zakelijk e-mailadres <span class="text-[#76B900]">*</span></label>
                <input type="email" id="work_email" x-model="workEmail" required
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
              </div>

              <div class="mt-5">
                <div>
                  <label for="phone" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Telefoon</label>
                  <div class="flex gap-2">
                    {# Searchable country-code picker — matches the same UX
                       EdgeX's own native form uses for this field
                       (edgex.zunkireelabs.com/form/zunkireelabs-crm/contact-us),
                       not an invented pattern. #}
                    <div class="relative" x-data="{ codeOpen: false, codeSearch: '' }" @click.outside="codeOpen = false">
                      <button type="button" @click="codeOpen = !codeOpen"
                        class="flex w-[92px] flex-shrink-0 items-center justify-between gap-1 rounded-md border border-navy-100/60 bg-white px-2.5 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                        <span class="flex items-center gap-1">
                          <span x-text="phoneFlag"></span>
                          <span x-text="phoneCode"></span>
                        </span>
                        <svg class="h-3 w-3 flex-shrink-0 text-navy-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 9l6 6 6-6"></path>
                        </svg>
                      </button>
                      <div x-show="codeOpen" x-cloak x-transition
                        class="absolute z-20 mt-1 w-72 overflow-hidden rounded-md border border-navy-100 bg-white shadow-lg">
                        <div class="border-b border-navy-100 p-2">
                          <input type="text" x-model="codeSearch" placeholder="Land zoeken…"
                            class="w-full rounded border border-navy-100/60 px-2 py-1.5 text-[13px] outline-none focus:border-[#76B900]">
                        </div>
                        <div class="country-scroll max-h-64 overflow-y-auto overscroll-contain py-1" data-lenis-prevent>
                          <button type="button" x-show="!codeSearch" @click="codeOpen = false"
                            class="flex w-full items-center gap-2 bg-[#F0F5E8] px-3 py-2.5 text-left text-[13px] font-medium text-[#111827]">
                            <span x-text="phoneFlag"></span>
                            <span x-text="phoneCountryName + ' (' + phoneCode + ')'"></span>
                          </button>
                          <template x-for="c in countryCodes.filter(c => c.name !== phoneCountryName && (c.name.toLowerCase().includes(codeSearch.toLowerCase()) || c.code.includes(codeSearch)))" :key="c.name">
                            <button type="button" @click="phoneCode = c.code; phoneCountryName = c.name; phoneFlag = c.flag; codeOpen = false; codeSearch = ''"
                              class="flex w-full items-center gap-2 px-3 py-2.5 text-left text-[13px] text-[#111827] transition-colors hover:bg-navy-50">
                              <span x-text="c.flag"></span>
                              <span x-text="c.name + ' (' + c.code + ')'"></span>
                            </button>
                          </template>
                        </div>
                      </div>
                    </div>
                    <input type="tel" id="phone" x-model="phone" placeholder="98XXXXXXXX"
                      class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                  </div>
                </div>
              </div>

              <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                  <label for="city" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Plaats</label>
                  <input type="text" id="city" x-model="city"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
                <div>
                  <label for="country" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Land</label>
                  <input type="text" id="country" x-model="country"
                    class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30">
                </div>
              </div>

              <fieldset class="mt-5">
                <legend class="mb-2 font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Hoe wil je contact met ons opnemen? <span class="text-[#76B900]">*</span></legend>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                  {% for option in [{ v: "Talk to AI Expert", l: "Praat met een AI-expert" }, { v: "Book a Demo", l: "Demo boeken" }, { v: "Partnership", l: "Samenwerking" }, { v: "General Inquiry", l: "Algemene vraag" }] %}
                  <label class="flex cursor-pointer items-center gap-2 rounded-md border border-navy-100/60 px-3 py-2.5 text-[13px] text-[#111827] transition-colors has-[:checked]:border-[#76B900] has-[:checked]:bg-[#F0F5E8]">
                    <input type="radio" name="how_would_you_like_to_connect_with_us" value="{{ option.v }}" x-model="connect" required class="h-4 w-4 border-navy-200 text-[#76B900] focus:ring-[#76B900]/30">
                    {{ option.l }}
                  </label>
                  {% endfor %}
                </div>
              </fieldset>

              <div class="mt-5">
                <label for="message" class="mb-1.5 block font-mono text-[12px] font-semibold uppercase tracking-wider text-navy-800">Waarmee kunnen we je helpen?</label>
                <textarea id="message" x-model="message" rows="4"
                  class="w-full rounded-md border border-navy-100/60 bg-white px-3 py-2.5 text-[14px] text-[#111827] outline-none transition-colors focus:border-[#76B900] focus:ring-1 focus:ring-[#76B900]/30"></textarea>
              </div>

              <label class="mt-5 flex items-start gap-2.5 text-[13px] leading-relaxed text-[#6B7280]">
                <input type="checkbox" id="opt_in_for_marketing_communication" x-model="optIn" class="mt-0.5 h-4 w-4 rounded border-navy-200 text-[#76B900] focus:ring-[#76B900]/30">
                Ik wil marketingberichten van Zunkiree Labs ontvangen.
              </label>

              <p x-show="error" x-cloak class="mt-4 text-[13px] font-medium text-red-600">
                Er is iets misgegaan bij het verzenden van je bericht. Probeer het opnieuw of stuur ons direct een e-mail.
              </p>

              <button type="submit" :disabled="submitting"
                class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-md bg-[#76B900] px-6 py-3 text-[14px] font-medium text-white transition-colors hover:bg-[#5a9100] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto">
                <span x-show="!submitting">Verzenden</span>
                <span x-show="submitting" class="flex items-center gap-2">
                  <svg class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  Verzenden…
                </span>
              </button>
            </form>
        </div>
      </div>

    </div>
  </div>
</section>

{# =====================================================
