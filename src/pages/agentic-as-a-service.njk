            <div class="ml-4 text-white/70">action = plan(task)</div>
            <div class="ml-4 text-white/70">result = execute(action)</div>
            <div class="ml-4 text-white/70">feedback = reflect(result)</div>
            <div class="ml-4 text-white/70">&nbsp;</div>
            <div class="ml-4 text-sky-400">if feedback.needs_fix:</div>
            <div class="ml-8 text-white/70">self.debug()</div>
            <div class="ml-8 text-white/70">self.update()</div>
            <div class="ml-4 text-white/70">&nbsp;</div>
