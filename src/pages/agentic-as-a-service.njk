{# =====================================================
   SECTION 5: FAQ — For FAQPage Schema
   Same accordion pattern as homepage-v2/product-v2, with the
   original page's centered header + "talk to us" link + expand-all
   control preserved.
   ===================================================== #}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-heading" x-data="{ activeIndex: 0, expandAll: false }">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        FAQ
      </span>
      <h2 id="faq-heading" class="mb-4 text-[28px] font-semibold leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Common questions about GaaS
      </h2>
      <p class="text-[15px] leading-relaxed text-[#6B7280]">
        Agentic as a Service is a new paradigm. Here's what enterprise teams need to know.
      </p>
      <a href="/contact/" class="mt-5 inline-flex items-center gap-1.5 text-[13px] font-medium text-navy-900 transition-colors hover:text-[#5a9100]">
        Have more questions? Talk to us
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal>
      <div class="mb-4 flex items-center justify-end">
        <button
          @click="expandAll = !expandAll; activeIndex = expandAll ? 'all' : 0"
          class="text-[13px] text-[#6B7280] transition-colors hover:text-[#111827]"
        >
          <span x-text="expandAll ? 'Collapse All' : 'Expand All'"></span>
        </button>
      </div>

      <div class="divide-y divide-sky-100/70" data-reveal-stagger>
        {% for item in faqs %}
        <div class="py-5">
          <button
            @click="activeIndex = (activeIndex === {{ loop.index }} && !expandAll) ? null : {{ loop.index }}"
            class="flex w-full items-center justify-between gap-4 text-left group"
          >
            <span class="pr-4 text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
              {{ item.question }}
            </span>
            <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-sky-200 text-sky-600 transition-transform duration-200"
              :class="{ 'rotate-45': activeIndex === {{ loop.index }} || expandAll }"
            >
              <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
            </span>
          </button>
          <div
            x-show="activeIndex === {{ loop.index }} || expandAll"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-2"
            class="overflow-hidden"
          >
            <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">
              {{ item.answer }}
            </p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

