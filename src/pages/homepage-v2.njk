<style>
  .showcase-track-container {
    --card-width: 72%;
    --card-gap: 1rem;
    --card-offset: 14%;
  }
  @media (min-width: 1024px) {
    .showcase-track-container {
      --card-width: 48%;
      --card-gap: 1.5rem;
      --card-offset: 26%;
    }
  }
  @media (min-width: 1088px) {
    .showcase-title-area {
      margin-left: calc((100% - 1024px) / 2 - 2rem);
    }
  }

  /* Auto-advancing tab indicator: fills left-to-right over the autoplay duration */
  @keyframes industry-tab-timer {
    from { width: 0%; }
    to { width: 100%; }
  }
  .industry-tab-fill {
    animation-name: industry-tab-timer;
    animation-duration: var(--tab-timer-duration, 6000ms);
    animation-timing-function: linear;
    animation-fill-mode: forwards;
  }
  .industry-tab-fill.is-paused {
    animation-play-state: paused;
  }
</style>

<section
  class="relative flex flex-col justify-center overflow-hidden py-12 sm:py-16 lg:py-20"
  x-data="{
    pos: 2,
    activeTab: 1,
    cycle: 0,
    autoplayMs: 6000,
    autoplayTimer: null,
    isPaused: false,
    noTransition: false,
    tabsOf: [2, 4, 1, 2, 3, 4, 1, 2],
    startAutoplay() {
      clearTimeout(this.autoplayTimer);
      this.cycle++;
      if (this.isPaused) return;
      this.autoplayTimer = setTimeout(() => {
        this.next();
      }, this.autoplayMs);
    },
    next() {
      if (this.pos >= 6) this.snapToPos(2);
      else this.pos++;
    },
    prev() {
      if (this.pos <= 1) this.snapToPos(5);
      else this.pos--;
    },
    selectTab(tab) {
      this.activeTab = tab;
      this.pos = tab + 1;
    },
    snapToPos(newPos) {
      this.noTransition = true;
      this.pos = newPos;
      this.$nextTick(() => {
        if (this.$refs.industryTrack) void this.$refs.industryTrack.offsetWidth;
        this.noTransition = false;
      });
    }
  }"
  x-init="startAutoplay(); $watch('pos', () => { activeTab = tabsOf[pos]; startAutoplay(); })"
  :style="'--tab-timer-duration: ' + autoplayMs + 'ms;'"
  @mouseenter="isPaused = true; clearTimeout(autoplayTimer)"
  @mouseleave="isPaused = false; startAutoplay()"
  aria-labelledby="industry-showcase-heading"
>
  <!-- Header Wrapper (Centered, padded) -->
  <div class="mx-auto w-full max-w-content px-4 sm:px-6 lg:px-8">
    <div class="mb-12 showcase-title-area" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Industries
      </span>

      <h2 id="industry-showcase-heading" class="mb-6 text-[28px] font-light leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Find the industry that looks like yours
      </h2>

      <!-- Subhead copy + Tabs Row — aligned in the same row -->
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <p class="max-w-2xl text-body-lg text-[#6B7280]">
          Four verticals, one shared platform, already running in production.
        </p>

        <!-- Tabs — occupies the former Actions/CTAs slot -->
        <div
          role="tablist"
          aria-label="Industries"
          class="flex w-full flex-row items-center justify-between gap-4 overflow-x-auto pb-1 sm:w-auto sm:gap-6 lg:flex-shrink-0 lg:pl-12"
        >
          {% for industry in industries %}
            {% set tabIndex = loop.index %}
            <button
              type="button"
              role="tab"
              id="industry-tab-{{ loop.index0 }}"
              :aria-selected="activeTab === {{ tabIndex }} ? 'true' : 'false'"
              aria-controls="industry-panel-{{ tabIndex }}"
              :tabindex="activeTab === {{ tabIndex }} ? 0 : -1"
              @click="selectTab({{ tabIndex }}); $el.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });"
              class="group flex-none text-left focus:outline-none sm:flex-1 lg:flex-none lg:w-auto"
            >
              <!-- Indicator Line: track + auto-advancing timer fill -->
              <div
                class="relative mx-auto h-[3px] w-10 overflow-hidden rounded-full transition-colors duration-300 sm:w-12"
                :class="activeTab === {{ tabIndex }} ? 'bg-navy-200/30' : 'bg-navy-200/30 group-hover:bg-navy-300/50'"
              >
                <div
                  class="industry-tab-fill absolute inset-y-0 left-0 h-full rounded-full bg-[#76B900]"
                  x-show="activeTab === {{ tabIndex }}"
                  :class="isPaused ? 'is-paused' : ''"
                  x-effect="
                    cycle;
                    if (activeTab === {{ tabIndex }}) {
                      $el.style.animation = 'none';
                      void $el.offsetWidth;
                      $el.style.animation = '';
                    }
                  "
                ></div>
              </div>
              <!-- Tab Label -->
              <span
                class="mt-3 block whitespace-nowrap font-mono text-[11px] uppercase tracking-wider text-center transition-colors duration-200"
                :class="activeTab === {{ tabIndex }} ? 'text-navy-900 font-semibold' : 'text-navy-400 group-hover:text-navy-600'"
              >
                {{ industry.label }}
              </span>
            </button>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  <!-- Centered Carousel Track with Duplicated Boundary Cards for Infinite Looping (Full Bleed, No Gaps) -->
  {% set carouselItems = [
    industries[1],
    industries[3],
    industries[0],
    industries[1],
    industries[2],
    industries[3],
    industries[0],
    industries[1]
  ] %}
  {% set cardTabs = [2, 4, 1, 2, 3, 4, 1, 2] %}

  <div
    class="showcase-track-container relative w-full overflow-hidden cursor-grab select-none"
    :class="isDragging ? 'cursor-grabbing' : ''"
    data-reveal
    x-data="{ isDragging: false, startX: 0, didDrag: false }"
    @mousedown="isDragging = true; startX = $event.clientX"
    @mousemove.window="if (isDragging) { $event.preventDefault() }"
    @mouseup.window="
      if (isDragging) {
        const delta = $event.clientX - startX;
        if (Math.abs(delta) >= 60) {
          didDrag = true;
          if (delta < 0) next();
          else prev();
        }
      }
      isDragging = false;
    "
  >
    <div
      x-ref="industryTrack"
      class="flex"
      :class="noTransition ? 'transition-none' : 'transition-transform duration-500 ease-out'"
      :style="'transform: translateX(calc(var(--card-offset) - (' + pos + ' * (var(--card-width) + var(--card-gap))))); gap: var(--card-gap);'"
    >
      {% for item in carouselItems %}
        {% set originalIndex = loop.index0 %}
        {# Map each track card to its industry tab (1-4) for click/aria behavior #}
        {% set targetTab = cardTabs[originalIndex] %}

        <div
          role="tabpanel"
          id="industry-panel-{{ originalIndex }}"
          aria-labelledby="industry-tab-{{ targetTab }}"
          :aria-hidden="pos !== {{ originalIndex }} ? 'true' : 'false'"
          class="relative h-[440px] flex-shrink-0 snap-start overflow-hidden rounded-2xl shadow-subtle sm:h-[480px] opacity-100"
          :class="(pos === {{ originalIndex }} ? 'scale-100 z-10' : 'scale-95 z-0 cursor-pointer') + (noTransition ? '' : ' transition-all duration-500')"
          style="width: var(--card-width);"
          @click="
            if (didDrag) { didDrag = false; }
            else if (pos === {{ originalIndex }}) { next(); }
            else { selectTab({{ targetTab }}); }
          "
          :tabindex="pos === {{ originalIndex }} ? 0 : -1"
        >
          <!-- Card Background photo -->
          <img
            src="{{ item.image }}"
            alt=""
            class="absolute inset-0 h-full w-full object-cover pointer-events-none select-none"
            decoding="async"
            fetchpriority="high"
            draggable="false"
            width="1200"
            height="800"
          />

          <!-- Sky Tint overlay for image styling -->
          <div class="pointer-events-none absolute inset-0 bg-sky-900/20 mix-blend-color" aria-hidden="true"></div>

          <!-- Legibility scrims — linear gradient darken top/bottom, transparent center -->
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-black/60" aria-hidden="true"></div>

          <!-- Headline overlaid top-left on the image -->
          <div class="absolute left-6 top-6 right-40 sm:left-8 sm:top-8 sm:right-auto sm:max-w-md z-20 text-left">
            <h3 class="text-[20px] font-medium leading-[1.3] text-white sm:text-[24px] drop-shadow-md">
              {{ item.headline }}
            </h3>
          </div>

          <!-- Category badge overlaid top-right on the image -->
          <div class="absolute right-5 top-5 z-20 sm:right-6 sm:top-6">
            <div class="inline-flex items-center gap-2 rounded-full bg-black/35 px-3.5 py-1.5 backdrop-blur-md border border-white/10">
              <svg class="h-4 w-4 text-[#76B900]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="{{ item.iconPath }}"></path>
              </svg>
              <span class="text-[11px] font-mono uppercase tracking-wider text-white">
                {{ item.label }}
              </span>
            </div>
          </div>

          <!-- Floating stat or proof box on the bottom-right corner with glass effect -->
          <div class="absolute inset-x-4 bottom-5 z-20 mx-auto max-w-[280px] sm:inset-x-auto sm:right-6 sm:bottom-6">
            {% if item.proofType == "stat" %}
              <div class="rounded-lg bg-black/45 p-4 border border-white/10 backdrop-blur-md shadow-lg">
                <span class="block font-mono text-3xl font-semibold leading-none text-white sm:text-4xl">{{ item.statValue }}</span>
                <span class="mt-2 block text-[12.5px] font-medium leading-relaxed text-white/80">{{ item.statLabel }}</span>
              </div>
            {% else %}
              <div class="rounded-lg bg-black/45 p-4 border border-white/10 backdrop-blur-md shadow-lg">
                <span class="mb-1.5 block text-[10px] font-mono uppercase tracking-wider text-white">Flagship Proof</span>
                <span class="block text-[12.5px] leading-relaxed text-white/90">{{ item.proofLine }}</span>
              </div>
            {% endif %}
          </div>

        </div>
      {% endfor %}
    </div>
  </div>
</section>

