{% set homepageFaq = [
  {
    question: "What industries does ZunkireeLabs build for?",
    answer: "Four core verticals today: Education, Agencies, Healthcare, and Real Estate — each running on the same shared platform underneath. Education and Agencies are live in production now; Healthcare and Real Estate are built to the same standard."
  },
  {
    question: "Is this a demo, or is it actually running somewhere?",
    answer: "It's running. Admizz runs its education CRM deployment on this platform today, and ZunkireeLabs runs its own agency operations — deal pipeline, proposals, delivery, time tracking — on the exact same infrastructure. Nothing you see here is a concept."
  },
  {
    question: "What's shared across industries vs. built custom per client?",
    answer: "The platform layer — multi-tenant architecture, Zunkiree Search, and orchestration — is shared. What sits on top of it is a pre-built application per vertical plus accelerators to launch fast, so a new customer isn't starting from zero."
  },
  {
    question: "Do we need to replace our existing systems to use this?",
    answer: "No — the platform is built to sit on your own infrastructure and integrate with what you already run, not replace it wholesale."
  }
] %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-content">
    <div class="mb-10 max-w-2xl md:mb-12 mx-auto text-center" data-reveal>
      <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
        Support
      </span>
      <h2 id="faq-heading" class="text-[28px] font-light leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
        Frequently asked questions
      </h2>
    </div>

    <div class="mx-auto max-w-3xl" data-reveal x-data="{ activeIndex: null }">
      <div class="divide-y divide-navy-100" data-reveal-stagger>
        {% for item in homepageFaq %}
          <div class="py-3">
            <button
              @click="activeIndex = (activeIndex === {{ loop.index }}) ? null : {{ loop.index }}"
              class="flex w-full items-center justify-between gap-4 py-2 text-left group"
              :aria-expanded="activeIndex === {{ loop.index }} ? 'true' : 'false'"
              aria-controls="faq-answer-{{ loop.index }}"
            >
              <span class="text-[16px] font-medium leading-snug text-[#111827] transition-colors group-hover:text-navy-600 sm:text-[17px]">
                {{ item.question }}
              </span>
              <span class="flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-navy-200 text-navy-500 transition-transform duration-200" :class="activeIndex === {{ loop.index }} ? 'rotate-45' : ''">
                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </span>
            </button>
            <div
              id="faq-answer-{{ loop.index }}"
              x-show="activeIndex === {{ loop.index }}"
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-2"
              class="overflow-hidden"
            >
              <p class="pt-3 pr-10 text-[14px] leading-relaxed text-[#6B7280] sm:text-[15px]">{{ item.answer }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

