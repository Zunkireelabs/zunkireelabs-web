<section id="platform" class="scroll-mt-24 py-12 sm:py-16 lg:py-20" aria-labelledby="platform-visual-heading" x-data="{
  activeTab: 0,
  scrollTabIntoView(index) {
    this.$nextTick(() => {
      const container = this.$refs.platformMobileTabs;
      if (!container) return;
      const btn = container.querySelector('[data-tab-index=' + index + ']');
      if (!btn) return;
      const cRect = container.getBoundingClientRect();
      const bRect = btn.getBoundingClientRect();
      if (bRect.left >= cRect.left && bRect.right <= cRect.right) return;
      container.scrollTo({ left: container.scrollLeft + (bRect.left - cRect.left) - 12, behavior: 'smooth' });
    });
  }
}">
  <div class="mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">

    <!-- Sticky left column (header + tab sidebar) + capability cards (right) — Kore.ai
         "purpose-built applications" pattern (screenshot reference, 2026-07-26).
         Left column stays pinned in view (lg:sticky) while the right column's
         cards scroll with the normal page scroll — no inner scrollbar.
         Tabs are the three Platform Pillars above ("Pre-built AI applications",
         "Deploy AI to production", "Scale to any use case") — all three are
         now active (2026-07-28); each renders its own panel below. -->
    <div class="lg:grid lg:grid-cols-[30%_1fr] lg:gap-8 lg:items-start">

      <!-- Sticky left column: header + sidebar tabs. Sticky only from lg up
           (a global `position: sticky` here pinned this column mid-scroll on
           mobile too, which read as broken/stuck content on a phone) — plain
           flow below lg, `lg:sticky` above it. -->
      <div class="flex flex-col gap-8 mb-8 lg:sticky lg:mb-0 lg:self-start" style="top: 96px;">
        <div data-reveal>
          <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
            A Zunkiree Labs Platform
          </span>
          <h2 id="platform-visual-heading" class="text-[28px] font-light leading-[1.2] tracking-tight text-[#111827] sm:text-[32px] lg:text-[36px]">
            One platform. Every capability.
          </h2>
          <a
            href="/contact/"
            class="mt-6 inline-flex w-full flex-shrink-0 items-center justify-center gap-2 rounded-md border border-navy-300 px-5 py-3 font-mono text-[13px] uppercase tracking-wide text-navy-900 transition-colors duration-200 hover:border-navy-400 hover:bg-navy-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#76B900] focus-visible:ring-offset-2 sm:w-auto sm:py-2.5"
          >
            Explore the platform
            <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
          </a>
        </div>

        <div class="hidden gap-2 overflow-x-auto pb-1 lg:flex lg:flex-col lg:gap-3 lg:overflow-visible lg:pb-0">
          {% for pillar in pillars %}
            <button
              type="button"
              @click="
                activeTab = {{ loop.index0 }};
                $nextTick(() => { if (window.refreshScrollTriggers) window.refreshScrollTriggers(); });
                if (window.__lenis) { window.__lenis.scrollTo('#platform', { offset: -96 }); } else { document.getElementById('platform').scrollIntoView({ behavior: 'smooth', block: 'start' }); }
              "
              class="flex flex-shrink-0 items-center justify-between gap-2 whitespace-nowrap rounded-lg border px-4 py-3 text-left font-mono text-[12px] uppercase tracking-wide transition-colors duration-200 lg:whitespace-normal"
              :class="activeTab === {{ loop.index0 }} ? 'border-[#76B900] bg-[#76B900] text-white' : 'border-navy-100 bg-white text-navy-900 hover:border-navy-300'"
              :aria-pressed="activeTab === {{ loop.index0 }}"
            >
              <span>{{ pillar.title }}</span>
            </button>
          {% endfor %}
        </div>
      </div>

      <!-- Mobile sticky tab row — keeps the three platform tabs visible while scrolling
           through the panels below. The row itself stays part of the page; only its
           bottom hairline reads as pinned once stuck. Sticks within this section only,
           then releases naturally once the section ends. -->
      <div x-ref="platformMobileTabs" class="platform-sticky-tabs sticky z-40 mb-6 flex flex-row gap-2 overflow-x-auto scroll-smooth scrollbar-hide border-b border-navy-100 bg-white lg:hidden">
        {% for pillar in pillars %}
          <button
            type="button"
            data-tab-index="{{ loop.index0 }}"
            @click="
              activeTab = {{ loop.index0 }};
              $nextTick(() => { if (window.refreshScrollTriggers) window.refreshScrollTriggers(); });
              scrollTabIntoView({{ loop.index0 }});
            "
