{# =====================================================
   AI INSIGHTS — Website V2
   Direct copy of Kore.ai's "AI Insights" blog teaser: heading +
   "View all" button, one large featured post left, a short list
   of smaller posts right. Pulled from the real `collections.blog`
   posts already published under src/blog/ — no placeholder content.
   ===================================================== #}
{% set sortedPosts = collections.blog | reverse %}
{# Flat two-tone cover art for posts without a real featuredImage — MASTER_DESIGN_SPEC.md
   §25 explicitly allows "flat gradient art (matching §10's accent gradient palette) instead
   of a photo when no real photo exists" for article thumbnails. No blur/ambient bloom (both
   retired sitewide 2026-07-26) — just a flat navy/sky diagonal split plus the one sanctioned
   #76B900 accent, at low opacity as a ring+dot motif. #}
{% set coverVariants = [
  { base: "#1b3139", wash: "#0d2d4a" },
  { base: "#0d2d4a", wash: "#1b3139" },
  { base: "#1b3139", wash: "#1d5c94" }
] %}
{% macro coverArt(variant, cls) %}
<svg class="{{ cls }}" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="400" height="300" fill="{{ variant.base }}" />
  <polygon points="400,0 400,300 160,300" fill="{{ variant.wash }}" />
  <circle cx="320" cy="70" r="26" fill="none" stroke="#76B900" stroke-width="3" opacity="0.55" />
  <circle cx="320" cy="70" r="6" fill="#76B900" opacity="0.85" />
</svg>
{% endmacro %}
{# Bento card: short title overlaid centered on the image (ElevenLabs "Latest updates"
   pattern), full date + title below like before. Reused for all 5 AI Insights cards
   (now laid out as a 3-up row + 2-up row, per the widget-grid layout reference). #}
{% macro bentoCard(post, variant, cls, titleCls) %}
<a href="{{ post.url }}" class="group flex flex-col {{ cls }}">
  <div class="relative min-h-0 flex-1 overflow-hidden rounded-2xl bg-navy-100">
    {% if post.data.featuredImage and (post.data.featuredImage | fileExists) %}
      <img src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt or '' }}" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
    {% else %}
      {{ coverArt(variant, "absolute inset-0 h-full w-full transition-transform duration-300 group-hover:scale-105") }}
    {% endif %}
    <div class="absolute inset-0 flex items-center justify-center bg-black/10 p-6">
      <h3 class="{{ titleCls }} text-center font-normal leading-[1.3] text-white drop-shadow-md">
        {{ post.data.shortLabel or (post.data.title | shortLabel) }}
      </h3>
    </div>
  </div>
  <div class="shrink-0 pt-3">
    <span class="mb-1.5 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
      {{ post.data.date | date("%B %d, %Y") }}
    </span>
    <h3 class="{{ titleCls }} line-clamp-2 min-h-[2.6em] font-normal leading-[1.3] text-[#111827] transition-colors group-hover:text-navy-600">
      {{ post.data.title }}
    </h3>
  </div>
</a>
{% endmacro %}
<section class="px-4 py-12 sm:px-6 sm:py-16 lg:px-8 lg:py-20" aria-labelledby="insights-heading">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4 md:mb-12" data-reveal>
      <div>
        <span class="mb-4 block font-mono text-[11px] uppercase tracking-wider text-[#9CA3AF]">
          Resources
        </span>
        <h2 id="insights-heading" class="text-[28px] font-light leading-[1.2] text-[#111827] sm:text-[30px] lg:text-[32px]">
          AI Insights
        </h2>
      </div>
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 rounded-md border border-navy-200 px-5 py-3 text-[13px] font-medium uppercase tracking-wider text-navy-900 transition-colors hover:border-navy-400 hover:bg-navy-50 sm:py-2.5"
      >
        View all
        <span class="h-1 w-1 flex-shrink-0 rounded-full bg-navy-400" aria-hidden="true"></span>
      </a>
    </div>

    {% if sortedPosts.length %}
      {# Bento: 3-up row + 2-up row, mirrors the widget-grid layout reference #}
      <div class="flex flex-col gap-4 sm:gap-5" data-reveal-stagger>

        <!-- Top row: 3 equal cards, on a 6-col grid so each card = 2 cols -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-6 sm:gap-5">
          {{ bentoCard(sortedPosts[0], coverVariants[0], "sm:col-span-2 min-h-[20rem] sm:min-h-[22rem]", "text-[18px] sm:text-[19px]") }}
          {{ bentoCard(sortedPosts[1], coverVariants[1], "sm:col-span-2 min-h-[20rem] sm:min-h-[22rem]", "text-[18px] sm:text-[19px]") }}
          {{ bentoCard(sortedPosts[2], coverVariants[2], "sm:col-span-2 min-h-[20rem] sm:min-h-[22rem]", "text-[18px] sm:text-[19px]") }}
        </div>

        <!-- Bottom row: same card width as the top row, centered under it (1 empty col on each side) -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-6 sm:gap-5">
          {{ bentoCard(sortedPosts[3], coverVariants[1], "sm:col-start-2 sm:col-span-2 min-h-[20rem] sm:min-h-[22rem]", "text-[18px] sm:text-[19px]") }}
          {{ bentoCard(sortedPosts[4], coverVariants[2], "sm:col-start-4 sm:col-span-2 min-h-[20rem] sm:min-h-[22rem]", "text-[18px] sm:text-[19px]") }}
        </div>

      </div>
    {% endif %}
  </div>
</section>

